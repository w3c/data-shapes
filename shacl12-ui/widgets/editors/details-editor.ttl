PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:DetailsEditor
    a shui:SingleEditor ;
    rdfs:label "Details Editor"@en ;
    rdfs:comment "A nested form that edits the properties of the value node inline, using the shape that applies to that value."@en ;
.

shui:detailsEditorScore40
    a shui:WidgetScore ;
    shui:widget shui:DetailsEditor ;
    shui:score 40 ;
    shui:dataGraphShape shui:isIRIOrBlankNode ;
    shui:shapesGraphShape shui:prefersDetailsEditor ;
.

shui:detailsEditorScore0
    a shui:WidgetScore ;
    shui:widget shui:DetailsEditor ;
    shui:score 0 ;
    shui:dataGraphShape shui:isIRIOrBlankNode ;
.

shui:prefersDetailsEditor
    a sh:NodeShape ;
    sh:property [
        sh:path shui:editor ;
        sh:hasValue shui:DetailsEditor ;
    ] ;
.
