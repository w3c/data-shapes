PREFIX shui: <http://www.w3.org/ns/shacl-ui#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:iriEditorScore10
    a shui:WidgetScore ;
    shui:dataGraphShape shui:isIRI ;
    shui:shapesGraphShape shui:isIRI, shui:hasNoClassConstraint ;
    shui:score 10 ;
    shui:widget shui:IRIEditor ;
.

shui:iriEditorScore5
    a shui:WidgetScore ;
    shui:shapesGraphShape shui:isIRI, shui:hasNoClassConstraint ;
    shui:score 5 ;
    shui:widget shui:IRIEditor ;
.

shui:iriEditorScore0
    a shui:WidgetScore ;
    shui:dataGraphShape shui:isIRI ;
    shui:score 0 ;
    shui:widget shui:IRIEditor ;
.
