PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:EnumSelectEditor
    a shui:SingleEditor ;
    rdfs:label "Enum Select Editor"@en ;
    rdfs:comment "A drop-down offering the values of the sh:in constraint of the property, in the order of that list."@en ;
.

shui:enumSelectEditorScore40
    a shui:WidgetScore ;
    shui:widget shui:EnumSelectEditor ;
    shui:score 40 ;
    shui:shapesGraphShape shui:prefersEnumSelectEditor, shui:hasInConstraint ;
.

shui:enumSelectEditorScore30
    a shui:WidgetScore ;
    shui:widget shui:EnumSelectEditor ;
    shui:score 30 ;
    shui:shapesGraphShape shui:hasInConstraint ;
.

shui:prefersEnumSelectEditor
    a sh:NodeShape ;
    sh:property [
        sh:path shui:editor ;
        sh:hasValue shui:EnumSelectEditor ;
    ] ;
.
