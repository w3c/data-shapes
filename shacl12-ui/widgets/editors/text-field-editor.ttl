PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:TextFieldEditor
    a shui:SingleEditor ;
    rdfs:label "Text Field Editor"@en ;
    rdfs:comment "A single-line input field for the lexical form of a literal, without changing its language or datatype."@en ;
.

shui:textFieldEditorAcceptMatcher
    a shui:WidgetAcceptMatcher ;
    shui:widget shui:TextFieldEditor ;
    shui:shapesGraphShape shui:noSingleLineFalse ;
.

shui:textFieldEditorScore40
    a shui:WidgetScore ;
    shui:widget shui:TextFieldEditor ;
    shui:score 40 ;
    shui:shapesGraphShape shui:prefersTextFieldEditor ;
.

shui:textFieldEditorScore30
    a shui:WidgetScore ;
    shui:widget shui:TextFieldEditor ;
    shui:score 30 ;
    shui:dataGraphShape shui:isString ;
.

shui:textFieldEditorScore10
    a shui:WidgetScore ;
    shui:widget shui:TextFieldEditor ;
    shui:score 10 ;
    shui:shapesGraphShape shui:hasDatatypeStringConstraint ;
.

shui:textFieldEditorScore0
    a shui:WidgetScore ;
    shui:widget shui:TextFieldEditor ;
    shui:score 0 ;
    shui:shapesGraphShape shui:hasCustomDatatype ;
.

shui:textFieldEditorScore0Literal
    a shui:WidgetScore ;
    shui:widget shui:TextFieldEditor ;
    shui:score 0 ;
    shui:shapesGraphShape shui:hasNodeKindLiteralConstraint ;
.

shui:prefersTextFieldEditor
    a sh:NodeShape ;
    sh:property [
        sh:path shui:editor ;
        sh:hasValue shui:TextFieldEditor ;
    ] ;
.
