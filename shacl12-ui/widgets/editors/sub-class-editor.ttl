PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:SubClassEditor
    a shui:SingleEditor ;
    rdfs:label "Sub Class Editor"@en ;
    rdfs:comment "An editor for selecting a class, offering a root class and its subclasses. Typically used with sh:rootClass."@en ;
.

shui:subClassEditorScore40
    a shui:WidgetScore ;
    shui:widget shui:SubClassEditor ;
    shui:score 40 ;
    shui:dataGraphShape shui:isIRI ;
    shui:shapesGraphShape shui:prefersSubClassEditor, shui:hasRootClassConstraint ;
.

shui:prefersSubClassEditor
    a sh:NodeShape ;
    sh:property [
        sh:path shui:editor ;
        sh:hasValue shui:SubClassEditor ;
    ] ;
.
