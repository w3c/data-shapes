PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:InstancesSelectEditor
    a shui:SingleEditor ;
    rdfs:label "Instances Select Editor"@en ;
    rdfs:comment "A drop-down offering all instances of the class required for the property. Suited to classes with few instances."@en ;
.

shui:instancesSelectEditorScore40
    a shui:WidgetScore ;
    shui:widget shui:InstancesSelectEditor ;
    shui:score 40 ;
    shui:dataGraphShape shui:isIRI ;
    shui:shapesGraphShape shui:prefersInstancesSelectEditor, shui:hasClassConstraint ;
.

shui:instancesSelectEditorScore0
    a shui:WidgetScore ;
    shui:widget shui:InstancesSelectEditor ;
    shui:score 0 ;
    shui:shapesGraphShape shui:hasClassConstraint ;
.

shui:prefersInstancesSelectEditor
    a sh:NodeShape ;
    sh:property [
        sh:path shui:editor ;
        sh:hasValue shui:InstancesSelectEditor ;
    ] ;
.
