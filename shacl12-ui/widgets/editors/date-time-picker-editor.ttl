PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:DateTimePickerEditor
    a shui:SingleEditor ;
    rdfs:label "Date Time Picker Editor"@en ;
    rdfs:comment "A calendar-like picker for xsd:dateTime values, including a time selector."@en ;
.

shui:dateTimePickerEditorAcceptMatcher
    a shui:WidgetAcceptMatcher ;
    shui:widget shui:DateTimePickerEditor ;
    shui:dataGraphShape shui:isDateTime ;
.

shui:dateTimePickerEditorScore20
    a shui:WidgetScore ;
    shui:widget shui:DateTimePickerEditor ;
    shui:score 20 ;
    shui:dataGraphShape shui:isDateTime ;
.

shui:dateTimePickerEditorScore10
    a shui:WidgetScore ;
    shui:widget shui:DateTimePickerEditor ;
    shui:score 10 ;
    shui:shapesGraphShape shui:hasDatatypeDateTimeConstraint ;
.
