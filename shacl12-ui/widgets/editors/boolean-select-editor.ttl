PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:booleanSelectEditorScore40
    a shui:WidgetScore ;
    shui:widget shui:BooleanSelectEditor ;
    shui:score 40 ;
    shui:dataGraphShape shui:isBoolean ;
    shui:shapesGraphShape shui:prefersBooleanSelectEditor ;
.

shui:booleanSelectEditorScore20
    a shui:WidgetScore ;
    shui:widget shui:BooleanSelectEditor ;
    shui:score 20 ;
    shui:dataGraphShape shui:isBoolean ;
.

shui:booleanSelectEditorScore10
    a shui:WidgetScore ;
    shui:widget shui:BooleanSelectEditor ;
    shui:score 10 ;
    shui:shapesGraphShape shui:hasDatatypeBooleanConstraint ;
.

shui:prefersBooleanSelectEditor
    a sh:NodeShape ;
    sh:property [
        sh:path shui:editor ;
        sh:hasValue shui:BooleanSelectEditor ;
    ] ;
.
