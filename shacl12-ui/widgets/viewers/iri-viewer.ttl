PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:IRIViewer
    a shui:SingleViewer ;
    rdfs:label "IRI Viewer"@en ;
    rdfs:comment "A hyperlink to the IRI of the value, with further ways to interact with it such as a nested summary."@en ;
.

shui:iriViewerAcceptMatcher
    a shui:WidgetAcceptMatcher ;
    shui:widget shui:IRIViewer ;
    shui:dataGraphShape shui:isIRI ;
.

shui:iriViewerScore1
    a shui:WidgetScore ;
    shui:widget shui:IRIViewer ;
    shui:score 1 ;
    shui:dataGraphShape shui:isIRI ;
.
