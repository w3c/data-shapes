PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:HTMLViewer
    a shui:SingleViewer ;
    rdfs:label "HTML Viewer"@en ;
    rdfs:comment "The literal parsed into HTML elements, including its language when the root element carries a lang attribute."@en ;
.

shui:htmlViewerScore40
    a shui:WidgetScore ;
    shui:widget shui:HTMLViewer ;
    shui:score 40 ;
    shui:dataGraphShape shui:isHTMLOrString ;
    shui:shapesGraphShape shui:prefersHTMLViewer ;
.

shui:htmlViewerScore20
    a shui:WidgetScore ;
    shui:widget shui:HTMLViewer ;
    shui:score 20 ;
    shui:dataGraphShape shui:isHTML ;
.

shui:prefersHTMLViewer
    a sh:NodeShape ;
    sh:property [
        sh:path shui:viewer ;
        sh:hasValue shui:HTMLViewer ;
    ] ;
.
