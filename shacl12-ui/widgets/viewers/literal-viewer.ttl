PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:LiteralViewer
    a shui:SingleViewer ;
    rdfs:label "Literal Viewer"@en ;
    rdfs:comment "The lexical form of the literal value."@en ;
.

shui:literalViewerScore40
    a shui:WidgetScore ;
    shui:widget shui:LiteralViewer ;
    shui:score 40 ;
    shui:shapesGraphShape shui:prefersLiteralViewer ;
.

shui:literalViewerScore1
    a shui:WidgetScore ;
    shui:widget shui:LiteralViewer ;
    shui:score 1 ;
    shui:dataGraphShape shui:isLiteral ;
.

shui:prefersLiteralViewer
    a sh:NodeShape ;
    sh:property [
        sh:path shui:viewer ;
        sh:hasValue shui:LiteralViewer ;
    ] ;
.
