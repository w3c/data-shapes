PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:BlankNodeViewer
    a shui:SingleViewer ;
    rdfs:label "Blank Node Viewer"@en ;
    rdfs:comment "A human-readable rendering of a blank node, which may include links to the resources reachable from it."@en ;
.

shui:blankNodeViewerScore40
    a shui:WidgetScore ;
    shui:widget shui:BlankNodeViewer ;
    shui:score 40 ;
    shui:dataGraphShape shui:isBlankNode ;
    shui:shapesGraphShape shui:prefersBlankNodeViewer ;
.

shui:blankNodeViewerScore1
    a shui:WidgetScore ;
    shui:widget shui:BlankNodeViewer ;
    shui:score 1 ;
    shui:dataGraphShape shui:isBlankNode ;
.

shui:prefersBlankNodeViewer
    a sh:NodeShape ;
    sh:property [
        sh:path shui:viewer ;
        sh:hasValue shui:BlankNodeViewer ;
    ] ;
.
