PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:ValueTableViewer
    a shui:MultiViewer ;
    rdfs:label "Value Table Viewer"@en ;
    rdfs:comment "A table holding all values of the property at the focus node, one row per value, with columns taken from the node shape of the property."@en ;
.

shui:valueTableViewerScore40
    a shui:WidgetScore ;
    shui:widget shui:ValueTableViewer ;
    shui:score 40 ;
    shui:shapesGraphShape shui:prefersValueTableViewer ;
.

shui:prefersValueTableViewer
    a sh:NodeShape ;
    sh:property [
        sh:path shui:viewer ;
        sh:hasValue shui:ValueTableViewer ;
    ] ;
.
