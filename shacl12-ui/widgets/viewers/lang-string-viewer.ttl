PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:LangStringViewer
    a shui:SingleViewer ;
    rdfs:label "Lang String Viewer"@en ;
    rdfs:comment "The text of the literal with its language indicator, applying the base direction of an rdf:dirLangString value."@en ;
.

shui:langStringViewerScore40
    a shui:WidgetScore ;
    shui:widget shui:LangStringViewer ;
    shui:score 40 ;
    shui:shapesGraphShape shui:prefersLangStringViewer ;
.

shui:langStringViewerScore20
    a shui:WidgetScore ;
    shui:widget shui:LangStringViewer ;
    shui:score 20 ;
    shui:dataGraphShape shui:isLangString ;
.

shui:prefersLangStringViewer
    a sh:NodeShape ;
    sh:property [
        sh:path shui:viewer ;
        sh:hasValue shui:LangStringViewer ;
    ] ;
.
