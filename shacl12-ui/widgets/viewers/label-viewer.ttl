PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:LabelViewer
    a shui:SingleViewer ;
    rdfs:label "Label Viewer"@en ;
    rdfs:comment "A hyperlink to the IRI of the value, shown under the display label resolved for the current user."@en ;
.

shui:labelViewerScore40
    a shui:WidgetScore ;
    shui:widget shui:LabelViewer ;
    shui:score 40 ;
    shui:dataGraphShape shui:isIRI ;
    shui:shapesGraphShape shui:prefersLabelViewer ;
.

shui:labelViewerScore10
    a shui:WidgetScore ;
    shui:widget shui:LabelViewer ;
    shui:score 10 ;
    shui:dataGraphShape shui:isIRI ;
.

shui:prefersLabelViewer
    a sh:NodeShape ;
    sh:property [
        sh:path shui:viewer ;
        sh:hasValue shui:LabelViewer ;
    ] ;
.
