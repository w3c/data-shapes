PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:DetailsViewer
    a shui:SingleViewer ;
    rdfs:label "Details Viewer"@en ;
    rdfs:comment "A nested, form-like display of the value node, using the shape that applies to that value."@en ;
.

shui:detailsViewerScore40
    a shui:WidgetScore ;
    shui:widget shui:DetailsViewer ;
    shui:score 40 ;
    shui:dataGraphShape shui:isIRIOrBlankNode ;
    shui:shapesGraphShape shui:prefersDetailsViewer ;
.

shui:detailsViewerScore0
    a shui:WidgetScore ;
    shui:widget shui:DetailsViewer ;
    shui:score 0 ;
    shui:dataGraphShape shui:isIRIOrBlankNode ;
.

shui:prefersDetailsViewer
    a sh:NodeShape ;
    sh:property [
        sh:path shui:viewer ;
        sh:hasValue shui:DetailsViewer ;
    ] ;
.
