PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:isBoolean
    a sh:NodeShape ;
    sh:datatype xsd:boolean ;
.

shui:isDate
    a sh:NodeShape ;
    sh:datatype xsd:date ;
.

shui:isIRI
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
.
