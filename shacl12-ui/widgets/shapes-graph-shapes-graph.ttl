PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shui:literalNoDatatypeSpecified
    a sh:NodeShape ;
    sh:property 
        [
            sh:hasValue sh:Literal ;
            sh:path sh:nodeKind ;
        ] ,
        [
            sh:maxCount 0 ;
            sh:path sh:datatype ;
        ] ;
.
