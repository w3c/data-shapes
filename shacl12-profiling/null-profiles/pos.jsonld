[
    {
        "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#",
        "http://purl.org/dc/elements/1.1/date": "$Date: 2009/04/20 15:00:30 $",
        "http://purl.org/dc/elements/1.1/description": "A vocabulary for representing latitude, longitude and altitude information in the WGS84 geodetic reference datum.\n\nVersion $Id: wgs84_pos.rdf,v 1.22 2009/04/20 15:00:30 timbl Exp $. See http://www.w3.org/2003/01/geo/ for more details.",
        "http://purl.org/dc/elements/1.1/title": "WGS84 Geo Positioning: an RDF vocabulary",
        "rdfs:comment": "Recent changes to this namespace:\n$Log: wgs84_pos.rdf,v $\nRevision 1.22  2009/04/20 15:00:30  timbl\nRemove the time bits which have been deal with elsewhere eg in iCal.\n\n...\n\nRevision 1.1\ndate: 2003/01/10 10:53:23;  author: danbri;  state: Exp;\nbasic geo vocab",
        "rdfs:label": "geo"
    },
    {
        "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#Point",
        "@type": "rdfs:Class",
        "rdfs:comment": [
            "A point, typically described using a coordinate system relative to Earth, such as WGS84.",
            "Uniquely identified by lat/long/alt. i.e.\n\nspaciallyIntersects(P1, P2) :- lat(P1, LAT), long(P1, LONG), alt(P1, ALT), lat(P2, LAT), long(P2, LONG), alt(P2, ALT).\n\nsameThing(P1, P2) :- type(P1, Point), type(P2, Point), spaciallyIntersects(P1, P2)."
        ],
        "rdfs:label": "point",
        "rdfs:subClassOf": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"
        }
    },
    {
        "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing",
        "@type": "rdfs:Class",
        "rdfs:comment": "Anything with spatial extent, i.e. size, shape, or position. e.g. people, places, bowling balls, as well as abstract areas like cubes.",
        "rdfs:label": "SpatialThing"
    },
    {
        "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#alt",
        "@type": "rdf:Property",
        "rdfs:comment": "The WGS84 altitude of a SpatialThing (decimal meters above the local reference ellipsoid).",
        "rdfs:domain": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"
        },
        "rdfs:label": "altitude"
    },
    {
        "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#lat",
        "@type": "rdf:Property",
        "rdfs:comment": "The WGS84 latitude of a SpatialThing (decimal degrees).",
        "rdfs:domain": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"
        },
        "rdfs:label": "latitude"
    },
    {
        "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#lat_long",
        "@type": "rdf:Property",
        "rdfs:comment": "A comma-separated representation of a latitude, longitude coordinate.",
        "rdfs:label": "lat/long"
    },
    {
        "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#location",
        "@type": "rdf:Property",
        "rdfs:comment": "The relation between something and the point, or other geometrical thing in space, where it is.  For example, the relationship between a radio tower and a Point with a given lat and long.\n\nOr a relationship between a park and its outline as a closed arc of points, or a road and its location as a arc (a sequence of points).\n\nClearly in practice there will be limit to the accuracy of any such statement, but one would expect an accuracy appropriate for the size of the object and uses such as mapping .",
        "rdfs:label": "location",
        "rdfs:range": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"
        },
        "rdfs:subPropertyOf": {
            "@id": "http://xmlns.com/foaf/0.1/based_near"
        }
    },
    {
        "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#long",
        "@type": "rdf:Property",
        "rdfs:comment": "The WGS84 longitude of a SpatialThing (decimal degrees).",
        "rdfs:domain": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"
        },
        "rdfs:label": "longitude"
    }
]
