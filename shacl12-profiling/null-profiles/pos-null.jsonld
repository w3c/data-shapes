{
    "@context": {
        "dcterms": "http://purl.org/dc/terms/",
        "ex": "http://example.com/ns#",
        "owl": "http://www.w3.org/2002/07/owl#",
        "prof": "http://www.w3.org/ns/dx/prof/",
        "prov": "http://www.w3.org/ns/prov#",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "role": "http://www.w3.org/ns/dx/prof/role/",
        "sh": "http://www.w3.org/ns/shacl#",
        "shpr": "http://www.w3.org/ns/shpr#",
        "shprc": "http://www.w3.org/ns/shacl/profile/core/",
        "xsd": "http://www.w3.org/2001/XMLSchema#"
    },
    "@graph": [
        {
            "@id": "ex:POSNullProfileGuide",
            "@type": "prof:ResourceDescriptor",
            "dcterms:conformsTo": {
                "@id": "http://www.w3.org/TR/html5/"
            },
            "dcterms:format": "text/html",
            "prof:hasArtifact": {
                "@type": "xsd:anyURI",
                "@value": "..."
            },
            "prof:hasRole": {
                "@id": "role:specification"
            }
        },
        {
            "@id": "ex:POSNullProfile",
            "@type": "prof:Profile",
            "rdfs:comment": "A Null Profile of the Basic Geo (WGS84 lat/long) Vocabulary (POS)",
            "rdfs:label": "Null Profile of POS",
            "prof:hasResource": [
                {
                    "@id": "ex:POSNullProfileSpec"
                },
                {
                    "@id": "ex:POSNullProfileSG"
                },
                {
                    "@id": "ex:POSNullProfileValidator"
                },
                {
                    "@id": "ex:POSNullProfileGuide"
                }
            ],
            "prof:isProfileOf": {
                "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#"
            }
        },
        {
            "@id": "ex:POSNullProfileSchema",
            "@type": "prof:ResourceDescriptor",
            "dcterms:conformsTo": {
                "@id": "https://www.w3.org/TR/owl-conformance/"
            },
            "dcterms:format": "text/turtle",
            "prof:hasArtifact": {
                "@type": "xsd:anyURI",
                "@value": ".../pos.ttl"
            },
            "prof:hasRole": {
                "@id": "role:specification"
            }
        },
        {
            "@id": "ex:POSNullProfileValidator",
            "@type": "prof:ResourceDescriptor",
            "dcterms:conformsTo": {
                "@id": "https://www.w3.org/TR/shacl/"
            },
            "dcterms:format": "text/turtle",
            "prof:hasArtifact": {
                "@type": "xsd:anyURI",
                "@value": "..."
            },
            "prof:hasRole": {
                "@id": "role:validation"
            }
        },
        {
            "@id": "ex:POSNullProfileSpec",
            "@type": "prof:ResourceDescriptor",
            "dcterms:conformsTo": {
                "@id": "http://www.w3.org/TR/html5/"
            },
            "dcterms:format": "text/html",
            "prof:hasArtifact": {
                "@type": "xsd:anyURI",
                "@value": "https://www.w3.org/2003/01/geo/"
            },
            "prof:hasRole": {
                "@id": "role:specification"
            }
        }
    ]
}