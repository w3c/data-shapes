PREFIX pos: <http://www.w3.org/2003/01/geo/wgs84_pos#>

ex:POSNullProfile
    a prof:Profile ;
    rdfs:label "Null Profile of POS" ;
    rdfs:comment "A Null Profile of the Basic Geo (WGS84 lat/long) Vocabulary (POS)" ;
    prof:hasResource
        ex:POSNullProfileGuide ,
        ex:POSNullProfileSG ,
        ex:POSNullProfileSpec ,
        ex:POSNullProfileValidator ;
    prof:isProfileOf pos: ;
.

ex:POSNullProfileSchema
    a prof:ResourceDescriptor ;
    dcterms:conformsTo <https://www.w3.org/TR/owl-conformance/> ;
    dcterms:format "text/turtle" ;
    prof:hasArtifact ".../pos.ttl"^^xsd:anyURI ;
    prof:hasRole role:specification ;
.

ex:POSNullProfileGuide
    a prof:ResourceDescriptor ;
    dcterms:conformsTo <http://www.w3.org/TR/html5/> ;
    dcterms:format "text/html" ;
    prof:hasArtifact "..."^^xsd:anyURI ;
    prof:hasRole role:specification ;
.

ex:POSNullProfileSpec
    a prof:ResourceDescriptor ;
    dcterms:conformsTo <http://www.w3.org/TR/html5/> ;
    dcterms:format "text/html" ;
    prof:hasArtifact "https://www.w3.org/2003/01/geo/"^^xsd:anyURI ;
    prof:hasRole role:specification ;
.

ex:POSNullProfileValidator
    a prof:ResourceDescriptor ;
    dcterms:conformsTo <https://www.w3.org/TR/shacl/> ;
    dcterms:format "text/turtle" ;
    prof:hasArtifact "..."^^xsd:anyURI ;
    prof:hasRole role:validation ;
.
