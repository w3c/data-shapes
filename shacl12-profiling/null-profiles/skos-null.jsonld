{
    "@context": {
        "dcterms": "http://purl.org/dc/terms/",
        "ex": "http://example.com/ns#",
        "owl": "http://www.w3.org/2002/07/owl#",
        "prof": "http://www.w3.org/ns/dx/prof/",
        "prov": "http://www.w3.org/ns/prov#",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "role": "http://www.w3.org/ns/dx/prof/role/",
        "sh": "http://www.w3.org/ns/shacl#",
        "shpr": "http://www.w3.org/ns/shpr#",
        "shprc": "http://www.w3.org/ns/shacl/profile/core/",
        "xsd": "http://www.w3.org/2001/XMLSchema#"
    },
    "@graph": [
        {
            "@id": "ex:SKOSNullProfileValidator",
            "@type": "prof:ResourceDescriptor",
            "dcterms:conformsTo": {
                "@id": "https://www.w3.org/TR/shacl/"
            },
            "dcterms:format": "text/turtle",
            "prof:hasArtifact": {
                "@type": "xsd:anyURI",
                "@value": "..."
            },
            "prof:hasRole": {
                "@id": "role:validation"
            }
        },
        {
            "@id": "ex:SKOSNullProfileSchema",
            "@type": "prof:ResourceDescriptor",
            "dcterms:conformsTo": {
                "@id": "https://www.w3.org/TR/owl-conformance/"
            },
            "dcterms:format": "application/rdf+xml",
            "prof:hasArtifact": {
                "@type": "xsd:anyURI",
                "@value": "https://www.w3.org/2009/08/skos-reference/skos.rdf"
            },
            "prof:hasRole": {
                "@id": "role:schema"
            }
        },
        {
            "@id": "ex:SKOSNullProfileSpec",
            "@type": "prof:ResourceDescriptor",
            "dcterms:conformsTo": {
                "@id": "http://www.w3.org/TR/html5/"
            },
            "dcterms:format": "text/html",
            "prof:hasArtifact": {
                "@type": "xsd:anyURI",
                "@value": "https://www.w3.org/TR/skos-reference/"
            },
            "prof:hasRole": {
                "@id": "role:specification"
            }
        },
        {
            "@id": "ex:SKOSNullProfileGuide",
            "@type": "prof:ResourceDescriptor",
            "dcterms:conformsTo": {
                "@id": "http://www.w3.org/TR/html5/"
            },
            "dcterms:format": "text/html",
            "prof:hasArtifact": {
                "@type": "xsd:anyURI",
                "@value": "..."
            },
            "prof:hasRole": {
                "@id": "role:specification"
            }
        },
        {
            "@id": "ex:SKOSNullProfile",
            "@type": "prof:Profile",
            "rdfs:comment": "A Null Profile of the Simple Knowledge Organization System (SKOS).",
            "rdfs:label": "Null Profile of SKOS",
            "prof:hasResource": [
                {
                    "@id": "ex:SKOSNullProfileValidator"
                },
                {
                    "@id": "ex:SKOSNullProfileSchema"
                },
                {
                    "@id": "ex:SKOSNullProfileSpec"
                },
                {
                    "@id": "ex:SKOSNullProfileGuide"
                }
            ],
            "prof:isProfileOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#"
            }
        }
    ]
}