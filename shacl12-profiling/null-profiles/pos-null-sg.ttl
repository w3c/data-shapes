PREFIX pos: <http://www.w3.org/2003/01/geo/wgs84_pos#>

ex:AltitudeDomainShape
    a sh:NodeShape ;
    rdfs:isDefinedBy ex:POSNullProfile ;
    sh:class pos:SpatialThing ;
    sh:message "Every subject of pos:alt is a pos:SpatialThing (rdfs:domain)." ;
    sh:targetSubjectsOf pos:alt ;
.

ex:AltitudeRangeShape
    a sh:NodeShape ;
    rdfs:isDefinedBy ex:POSNullProfile ;
    sh:datatype xsd:decimal ;
    sh:message "Every pos:alt value must be an xsd:decimal." ;
    sh:targetObjectsOf pos:alt ;
.

ex:LatitudeDomainShape
    a sh:NodeShape ;
    rdfs:isDefinedBy ex:POSNullProfile ;
    sh:class pos:SpatialThing ;
    sh:message "Every subject of pos:lat is a pos:SpatialThing (rdfs:domain)." ;
    sh:targetSubjectsOf pos:lat ;
.

ex:LatitudeRangeShape
    a sh:NodeShape ;
    rdfs:isDefinedBy ex:POSNullProfile ;
    sh:datatype xsd:decimal ;
    sh:minInclusive -90.0 ;
    sh:maxInclusive 90.0 ;
    sh:message "Every pos:lat value must be an xsd:decimal between -90 and 90 inclusive." ;
    sh:targetObjectsOf pos:lat ;
.

ex:LatitudeLongitudeValueShape
    a sh:NodeShape ;
    rdfs:isDefinedBy ex:POSNullProfile ;
    sh:datatype xsd:string ;
    sh:pattern "^[+-]?(0*([0-8]?[0-9](\\.[0-9]*)?|90(\\.0*)?)|\\.[0-9]+)\\s*,\\s*[+-]?(0*((1[0-7][0-9]|[0-9]?[0-9])(\\.[0-9]*)?|180(\\.0*)?)|\\.[0-9]+)$" ;
    sh:message "Every pos:lat_long value must contain a latitude between -90 and 90, a comma, and a longitude between -180 and 180." ;
    sh:targetObjectsOf pos:lat_long ;
.

ex:LocationRangeShape
    a sh:NodeShape ;
    rdfs:isDefinedBy ex:POSNullProfile ;
    sh:class pos:SpatialThing ;
    sh:message "Every object of pos:location is a pos:SpatialThing (rdfs:range)." ;
    sh:targetObjectsOf pos:location ;
.

ex:LongitudeDomainShape
    a sh:NodeShape ;
    rdfs:isDefinedBy ex:POSNullProfile ;
    sh:class pos:SpatialThing ;
    sh:message "Every subject of pos:long is a pos:SpatialThing (rdfs:domain)." ;
    sh:targetSubjectsOf pos:long ;
.

ex:LongitudeRangeShape
    a sh:NodeShape ;
    rdfs:isDefinedBy ex:POSNullProfile ;
    sh:datatype xsd:decimal ;
    sh:minInclusive -180.0 ;
    sh:maxInclusive 180.0 ;
    sh:message "Every pos:long value must be an xsd:decimal between -180 and 180 inclusive." ;
    sh:targetObjectsOf pos:long ;
.

ex:PointShape
    a sh:NodeShape ;
    rdfs:isDefinedBy ex:POSNullProfile ;
    sh:class pos:SpatialThing ;
    sh:message "Every pos:Point is a pos:SpatialThing (rdfs:subClassOf)." ;
    sh:targetClass pos:Point ;
.

ex:POSNullProfileSG
    a sh:ShapesGraph ;
    rdfs:label "SHACL Shapes Graph for POS" ;
    rdfs:comment """These shapes express the POS vocabulary's axioms and coordinate
value constraints as given in comments. This Shapes Graph is intended to cover all
testible POS constraints""" ;
    rdfs:member
        ex:AltitudeDomainShape ,
        ex:AltitudeRangeShape ,
        ex:LatitudeDomainShape ,
        ex:LatitudeRangeShape ,
        ex:LatitudeLongitudeValueShape ,
        ex:LocationRangeShape ,
        ex:LongitudeDomainShape ,
        ex:LongitudeRangeShape ,
        ex:PointShape ;
.
