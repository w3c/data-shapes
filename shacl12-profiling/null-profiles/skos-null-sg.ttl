SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:narrower ?value .
    BIND (skos:narrower AS ?path)
    FILTER NOT EXISTS { ?value skos:broader $this }
}""" ;
        ] ;
    sh:targetSubjectsOf skos:narrower ;
.

ex:NarrowerNarrowerTransitiveSubpropertyShape
    a sh:NodeShape ;
    rdfs:label "NarrowerNarrowerTransitiveSubproperty" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S22> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "A subproperty assertion requires its corresponding superproperty assertion." ;
    sh:sparql
        [
            sh:message "A skos:narrower assertion requires the same value for skos:narrowerTransitive." ;
            sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:narrower ?value .
    BIND (skos:narrowerTransitive AS ?path)
    FILTER NOT EXISTS { $this skos:narrowerTransitive ?value }
}""" ;
        ] ;
    sh:targetSubjectsOf skos:narrower ;
.

ex:NarrowerTransitiveInverseShape
    a sh:NodeShape ;
    rdfs:label "NarrowerTransitiveInverse" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S26> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "An inverse-property assertion must have its corresponding reverse assertion." ;
    sh:sparql
        [
            sh:message "Each skos:narrowerTransitive assertion requires its inverse skos:broaderTransitive assertion." ;
            sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:narrowerTransitive ?value .
    BIND (skos:narrowerTransitive AS ?path)
    FILTER NOT EXISTS { ?value skos:broaderTransitive $this }
}""" ;
        ] ;
    sh:targetSubjectsOf skos:narrowerTransitive ;
.

ex:NarrowerTransitiveSemanticRelationSubpropertyShape
    a sh:NodeShape ;
    rdfs:label "NarrowerTransitiveSemanticRelationSubproperty" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S21> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "A subproperty assertion requires its corresponding superproperty assertion." ;
    sh:sparql
        [
            sh:message "A skos:narrowerTransitive assertion requires the same value for skos:semanticRelation." ;
            sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:narrowerTransitive ?value .
    BIND (skos:semanticRelation AS ?path)
    FILTER NOT EXISTS { $this skos:semanticRelation ?value }
}""" ;
        ] ;
    sh:targetSubjectsOf skos:narrowerTransitive ;
.

ex:NarrowerTransitiveTransitivityShape
    a sh:NodeShape ;
    rdfs:label "NarrowerTransitiveTransitivity" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S24> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "skos:narrowerTransitive must include the triples implied by transitivity." ;
    sh:sparql
        [
            sh:message "A two-step skos:narrowerTransitive path requires its direct transitive assertion." ;
            sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:narrowerTransitive/skos:narrowerTransitive ?value .
    BIND (skos:narrowerTransitive AS ?path)
    FILTER NOT EXISTS { $this skos:narrowerTransitive ?value }
}""" ;
        ] ;
    sh:targetSubjectsOf skos:narrowerTransitive ;
.

ex:NotationRangeShape
    a sh:NodeShape ;
    rdfs:label "NotationRange" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S15> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "A skos:notation value must be a literal." ;
    sh:nodeKind sh:Literal ;
    sh:targetObjectsOf skos:notation ;
.

ex:ObjectPropertyRangeShape
    a sh:NodeShape ;
    rdfs:label "ObjectPropertyRange" ;
    dcterms:source
        <https://www.w3.org/TR/skos-reference/#S18> ,
        <https://www.w3.org/TR/skos-reference/#S3> ,
        <https://www.w3.org/TR/skos-reference/#S30> ,
        <https://www.w3.org/TR/skos-reference/#S38> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "SKOS object-property values must be IRIs or blank nodes, not literals." ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:targetObjectsOf
        skos:broadMatch ,
        skos:broader ,
        skos:broaderTransitive ,
        skos:closeMatch ,
        skos:exactMatch ,
        skos:hasTopConcept ,
        skos:inScheme ,
        skos:mappingRelation ,
        skos:member ,
        skos:memberList ,
        skos:narrowMatch ,
        skos:narrower ,
        skos:narrowerTransitive ,
        skos:related ,
        skos:relatedMatch ,
        skos:semanticRelation ,
        skos:topConceptOf ;
.

ex:OrderedCollectionConceptDisjointShape
    a sh:NodeShape ;
    rdfs:label "OrderedCollectionConceptDisjoint" ;
    dcterms:source
        <https://www.w3.org/TR/skos-reference/#S29> ,
        <https://www.w3.org/TR/skos-reference/#S37> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "skos:OrderedCollection and skos:Concept have disjoint instances." ;
    sh:not
        [
            sh:class skos:Concept ;
        ] ;
    sh:targetClass skos:OrderedCollection ;
.

ex:OrderedCollectionConceptSchemeDisjointShape
    a sh:NodeShape ;
    rdfs:label "OrderedCollectionConceptSchemeDisjoint" ;
    dcterms:source
        <https://www.w3.org/TR/skos-reference/#S29> ,
        <https://www.w3.org/TR/skos-reference/#S37> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "skos:OrderedCollection and skos:ConceptScheme have disjoint instances." ;
    sh:not
        [
            sh:class skos:ConceptScheme ;
        ] ;
    sh:targetClass skos:OrderedCollection ;
.

ex:OrderedCollectionSubclassShape
    a sh:NodeShape ;
    rdfs:label "OrderedCollectionSubclass" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S29> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:class skos:Collection ;
    sh:message "A skos:OrderedCollection must also be a skos:Collection." ;
    sh:targetClass skos:OrderedCollection ;
.

ex:PlainLabelRangeShape
    a sh:NodeShape ;
    rdfs:label "PlainLabelRange" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S12> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "SKOS labels must be xsd:string or rdf:langString literals (RDF 1.1 plain labels)." ;
    sh:or (
        ex:StringValueShape
        ex:LangStringValueShape
    ) ;
    sh:targetObjectsOf
        skos:altLabel ,
        skos:hiddenLabel ,
        skos:prefLabel ;
.

ex:PrefLabelLabelSubpropertyShape
    a sh:NodeShape ;
    rdfs:label "PrefLabelLabelSubproperty" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S11> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "A subproperty assertion requires its corresponding superproperty assertion." ;
    sh:sparql
        [
            sh:message "A skos:prefLabel assertion requires the same value for rdfs:label." ;
            sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:prefLabel ?value .
    BIND (rdfs:label AS ?path)
    FILTER NOT EXISTS { $this rdfs:label ?value }
}""" ;
        ] ;
    sh:targetSubjectsOf skos:prefLabel ;
.

ex:PreferredLabelLanguagePrefLabelPropertyShape
    sh:path skos:prefLabel ;
    sh:uniqueLang true ;
.

ex:PreferredLabelLanguageShape
    a sh:NodeShape ;
    rdfs:label "PreferredLabelLanguage" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S14> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "A resource may have at most one preferred label per language, including at most one untagged label." ;
    sh:property ex:PreferredLabelLanguagePrefLabelPropertyShape ;
    sh:sparql
        [
            sh:message "Two distinct skos:prefLabel values must not have the same language tag (including no tag)." ;
            sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:prefLabel ?value, ?other .
    BIND (skos:prefLabel AS ?path)
    FILTER (isLiteral(?value) && isLiteral(?other))
    FILTER (!sameTerm(?value, ?other))
    FILTER (LCASE(LANG(?value)) = LCASE(LANG(?other)))
}""" ;
        ] ;
    sh:targetSubjectsOf skos:prefLabel ;
.

ex:RelatedHierarchyDisjointShape
    a sh:NodeShape ;
    rdfs:label "RelatedHierarchyDisjoint" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S27> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "Associatively related concepts cannot also have a broader-transitive relationship." ;
    sh:sparql
        [
            sh:message "A related/relatedMatch pair also has an implied hierarchical relationship (S27)." ;
            sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this (skos:related|^skos:related|skos:relatedMatch|^skos:relatedMatch) ?value .
    $this (skos:broader|skos:broaderTransitive|skos:broadMatch|
           ^skos:narrower|^skos:narrowerTransitive|^skos:narrowMatch)+ ?value .
    BIND (skos:related AS ?path)
}""" ;
        ] ;
    sh:targetObjectsOf
        skos:related ,
        skos:relatedMatch ;
    sh:targetSubjectsOf
        skos:related ,
        skos:relatedMatch ;
.

ex:RelatedMatchMappingRelationSubpropertyShape
    a sh:NodeShape ;
    rdfs:label "RelatedMatchMappingRelationSubproperty" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S40> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "A subproperty assertion requires its corresponding superproperty assertion." ;
    sh:sparql
        [
            sh:message "A skos:relatedMatch assertion requires the same value for skos:mappingRelation." ;
            sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:relatedMatch ?value .
    BIND (skos:mappingRelation AS ?path)
    FILTER NOT EXISTS { $this skos:mappingRelation ?value }
}""" ;
        ] ;
    sh:targetSubjectsOf skos:relatedMatch ;
.

ex:RelatedMatchRelatedSubpropertyShape
    a sh:NodeShape ;
    rdfs:label "RelatedMatchRelatedSubproperty" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S41> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "A subproperty assertion requires its corresponding superproperty assertion." ;
    sh:sparql
        [
            sh:message "A skos:relatedMatch assertion requires the same value for skos:related." ;
            sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:relatedMatch ?value .
    BIND (skos:related AS ?path)
    FILTER NOT EXISTS { $this skos:related ?value }
}""" ;
        ] ;
    sh:targetSubjectsOf skos:relatedMatch ;
.

ex:RelatedMatchSymmetryShape
    a sh:NodeShape ;
    rdfs:label "RelatedMatchSymmetry" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S44> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "skos:relatedMatch requires a reverse assertion of the same property." ;
    sh:sparql
        [
            sh:message "skos:relatedMatch is symmetric." ;
            sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:relatedMatch ?value .
    BIND (skos:relatedMatch AS ?path)
    FILTER NOT EXISTS { ?value skos:relatedMatch $this }
}""" ;
        ] ;
    sh:targetSubjectsOf skos:relatedMatch ;
.

ex:RelatedSemanticRelationSubpropertyShape
    a sh:NodeShape ;
    rdfs:label "RelatedSemanticRelationSubproperty" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S21> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "A subproperty assertion requires its corresponding superproperty assertion." ;
    sh:sparql
        [
            sh:message "A skos:related assertion requires the same value for skos:semanticRelation." ;
            sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:related ?value .
    BIND (skos:semanticRelation AS ?path)
    FILTER NOT EXISTS { $this skos:semanticRelation ?value }
}""" ;
        ] ;
    sh:targetSubjectsOf skos:related ;
.

ex:RelatedSymmetryShape
    a sh:NodeShape ;
    rdfs:label "RelatedSymmetry" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S23> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "skos:related requires a reverse assertion of the same property." ;
    sh:sparql
        [
            sh:message "skos:related is symmetric." ;
            sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:related ?value .
    BIND (skos:related AS ?path)
    FILTER NOT EXISTS { ?value skos:related $this }
}""" ;
        ] ;
    sh:targetSubjectsOf skos:related ;
.

ex:ScopeNoteNoteSubpropertyShape
    a sh:NodeShape ;
    rdfs:label "ScopeNoteNoteSubproperty" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S17> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "A subproperty assertion requires its corresponding superproperty assertion." ;
    sh:sparql
        [
            sh:message "A skos:scopeNote assertion requires the same value for skos:note." ;
            sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:scopeNote ?value .
    BIND (skos:note AS ?path)
    FILTER NOT EXISTS { $this skos:note ?value }
}""" ;
        ] ;
    sh:targetSubjectsOf skos:scopeNote ;
.

