            sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:mappingRelation ?value .
    BIND (skos:semanticRelation AS ?path)
    FILTER NOT EXISTS { $this skos:semanticRelation ?value }
}""" ;
        ] ;
    sh:targetSubjectsOf skos:mappingRelation ;
.

ex:MemberDomainShape
    a sh:NodeShape ;
    rdfs:label "MemberDomain" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S31> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:class skos:Collection ;
    sh:message "The domain of skos:member must satisfy its SKOS class constraint." ;
    sh:targetSubjectsOf skos:member ;
.

ex:MemberListDomainShape
    a sh:NodeShape ;
    rdfs:label "MemberListDomain" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S33> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:class skos:OrderedCollection ;
    sh:message "The domain of skos:memberList must satisfy its SKOS class constraint." ;
    sh:targetSubjectsOf skos:memberList ;
.

ex:MemberListFunctionalMemberListPropertyShape
    sh:maxCount 1 ;
    sh:path skos:memberList ;
.

ex:MemberListFunctionalShape
    a sh:NodeShape ;
    rdfs:label "MemberListFunctional" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S35> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "skos:memberList is functional: at most one distinct RDF list head is allowed." ;
    sh:property ex:MemberListFunctionalMemberListPropertyShape ;
    sh:targetSubjectsOf skos:memberList ;
.

ex:MemberListMembershipShape
    a sh:NodeShape ;
    rdfs:label "MemberListMembership" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S36> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "Every skos:memberList item must also be a skos:member of the collection." ;
    sh:sparql
        [
            sh:message "A memberList item is missing its corresponding skos:member assertion (S36)." ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:memberList/rdf:rest*/rdf:first ?value .
    BIND (skos:member AS ?path)
    FILTER NOT EXISTS { $this skos:member ?value }
}""" ;
        ] ;
    sh:targetSubjectsOf skos:memberList ;
.

ex:MemberListRangeShape
    a sh:NodeShape ;
    rdfs:label "MemberListRange" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S34> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:class rdf:List ;
    sh:message "The range of skos:memberList must satisfy its SKOS class constraint." ;
    sh:targetObjectsOf skos:memberList ;
.

ex:MemberRangeShape
    a sh:NodeShape ;
    rdfs:label "MemberRange" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S32> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "The range of skos:member must satisfy its SKOS class constraint." ;
    sh:or (
        ex:ConceptValueShape
        ex:CollectionValueShape
    ) ;
    sh:targetObjectsOf skos:member ;
.

ex:NarrowMatchInverseShape
    a sh:NodeShape ;
    rdfs:label "NarrowMatchInverse" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S43> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
    sh:message "An inverse-property assertion must have its corresponding reverse assertion." ;
    sh:sparql
        [
            sh:message "Each skos:narrowMatch assertion requires its inverse skos:broadMatch assertion." ;
            sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?path ?value WHERE {
    $this skos:narrowMatch ?value .
    BIND (skos:narrowMatch AS ?path)
    FILTER NOT EXISTS { ?value skos:broadMatch $this }
}""" ;
        ] ;
    sh:targetSubjectsOf skos:narrowMatch ;
.

ex:NarrowMatchMappingRelationSubpropertyShape
    a sh:NodeShape ;
    rdfs:label "NarrowMatchMappingRelationSubproperty" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S40> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
