.

ex:LangStringValueShape
    sh:datatype rdf:langString ;
.

ex:MappingRelationSemanticRelationSubpropertyShape
    a sh:NodeShape ;
    rdfs:label "MappingRelationSemanticRelationSubproperty" ;
    dcterms:source <https://www.w3.org/TR/skos-reference/#S39> ;
    rdfs:isDefinedBy ex:SKOSNullProfile ;
