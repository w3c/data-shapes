PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ex:      <http://example.com/ns#>
PREFIX prof:    <http://www.w3.org/ns/dx/prof/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX role:    <http://www.w3.org/ns/dx/prof/role/>
PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX shpr:    <http://www.w3.org/ns/shpr#>
PREFIX shprc:   <http://www.w3.org/ns/shacl/profile/core/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

# Profile Declaration
ex:SKOSNullProfile
    a prof:Profile ;
    rdfs:label "Null Profile of SKOS" ;
    rdfs:comment "A Null Profile of the Simple Knowledge Organization System (SKOS)." ;
    prof:hasResource
        ex:SKOSNullProfileValidator ,
        ex:SKOSNullProfileSchema ,
        ex:SKOSNullProfileSpec ,
        ex:SKOSNullProfileGuide ;
    prof:isProfileOf skos: ;
.

# Specification - the original SKOS reference document
ex:SKOSNullProfileSpec
    a prof:ResourceDescriptor ;
    dcterms:conformsTo <http://www.w3.org/TR/html5/> ;
    dcterms:format "text/html" ;
    prof:hasArtifact "https://www.w3.org/TR/skos-reference/"^^xsd:anyURI ;
    prof:hasRole role:specification ;
.

# Schema
ex:SKOSNullProfileSchema
    a prof:ResourceDescriptor ;
    dcterms:conformsTo <https://www.w3.org/TR/owl-conformance/> ;
    dcterms:format "application/rdf+xml" ;
    prof:hasArtifact "https://www.w3.org/2009/08/skos-reference/skos.rdf"^^xsd:anyURI ;
    prof:hasRole role:schema ;
.

# Validator
ex:SKOSNullProfileValidator
    a prof:ResourceDescriptor ;
    dcterms:conformsTo <https://www.w3.org/TR/shacl/> ;
    dcterms:format "text/turtle" ;
    prof:hasArtifact "..."^^xsd:anyURI ;
    prof:hasRole role:validation ;
.

# Guidance - demonstration, not provided
ex:SKOSNullProfileGuide
  a prof:ResourceDescriptor ;
  prof:hasRole role:specification ;
  dcterms:format "text/html" ;
  dcterms:conformsTo <http://www.w3.org/TR/html5/> ;
  prof:hasArtifact "..."^^xsd:anyURI ;
.