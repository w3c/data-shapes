[
    {
        "@id": "ex:AltitudeDomainShape",
        "@type": "sh:NodeShape",
        "rdfs:isDefinedBy": {
            "@id": "ex:POSNullProfile"
        },
        "sh:class": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"
        },
        "sh:message": "Every subject of pos:alt is a pos:SpatialThing (rdfs:domain).",
        "sh:targetSubjectsOf": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#alt"
        }
    },
    {
        "@id": "ex:AltitudeRangeShape",
        "@type": "sh:NodeShape",
        "rdfs:isDefinedBy": {
            "@id": "ex:POSNullProfile"
        },
        "sh:datatype": {
            "@id": "xsd:decimal"
        },
        "sh:message": "Every pos:alt value must be an xsd:decimal.",
        "sh:targetObjectsOf": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#alt"
        }
    },
    {
        "@id": "ex:LatitudeDomainShape",
        "@type": "sh:NodeShape",
        "rdfs:isDefinedBy": {
            "@id": "ex:POSNullProfile"
        },
        "sh:class": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"
        },
        "sh:message": "Every subject of pos:lat is a pos:SpatialThing (rdfs:domain).",
        "sh:targetSubjectsOf": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#lat"
        }
    },
    {
        "@id": "ex:LatitudeLongitudeValueShape",
        "@type": "sh:NodeShape",
        "rdfs:isDefinedBy": {
            "@id": "ex:POSNullProfile"
        },
        "sh:datatype": {
            "@id": "xsd:string"
        },
        "sh:message": "Every pos:lat_long value must contain a latitude between -90 and 90, a comma, and a longitude between -180 and 180.",
        "sh:pattern": "^[+-]?(0*([0-8]?[0-9](\\.[0-9]*)?|90(\\.0*)?)|\\.[0-9]+)\\s*,\\s*[+-]?(0*((1[0-7][0-9]|[0-9]?[0-9])(\\.[0-9]*)?|180(\\.0*)?)|\\.[0-9]+)$",
        "sh:targetObjectsOf": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#lat_long"
        }
    },
    {
        "@id": "ex:LatitudeRangeShape",
        "@type": "sh:NodeShape",
        "rdfs:isDefinedBy": {
            "@id": "ex:POSNullProfile"
        },
        "sh:datatype": {
            "@id": "xsd:decimal"
        },
        "sh:maxInclusive": {
            "@type": "xsd:decimal",
            "@value": "90.0"
        },
        "sh:message": "Every pos:lat value must be an xsd:decimal between -90 and 90 inclusive.",
        "sh:minInclusive": {
            "@type": "xsd:decimal",
            "@value": "-90.0"
        },
        "sh:targetObjectsOf": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#lat"
        }
    },
    {
        "@id": "ex:LocationRangeShape",
        "@type": "sh:NodeShape",
        "rdfs:isDefinedBy": {
            "@id": "ex:POSNullProfile"
        },
        "sh:class": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"
        },
        "sh:message": "Every object of pos:location is a pos:SpatialThing (rdfs:range).",
        "sh:targetObjectsOf": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#location"
        }
    },
    {
        "@id": "ex:LongitudeDomainShape",
        "@type": "sh:NodeShape",
        "rdfs:isDefinedBy": {
            "@id": "ex:POSNullProfile"
        },
        "sh:class": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"
        },
        "sh:message": "Every subject of pos:long is a pos:SpatialThing (rdfs:domain).",
        "sh:targetSubjectsOf": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#long"
        }
    },
    {
        "@id": "ex:LongitudeRangeShape",
        "@type": "sh:NodeShape",
        "rdfs:isDefinedBy": {
            "@id": "ex:POSNullProfile"
        },
        "sh:datatype": {
            "@id": "xsd:decimal"
        },
        "sh:maxInclusive": {
            "@type": "xsd:decimal",
            "@value": "180.0"
        },
        "sh:message": "Every pos:long value must be an xsd:decimal between -180 and 180 inclusive.",
        "sh:minInclusive": {
            "@type": "xsd:decimal",
            "@value": "-180.0"
        },
        "sh:targetObjectsOf": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#long"
        }
    },
    {
        "@id": "ex:POSNullProfileSG",
        "@type": "sh:ShapesGraph",
        "rdfs:comment": "These shapes express the POS vocabulary's axioms and coordinate\nvalue constraints as given in comments. This Shapes Graph is intended to cover all\ntestible POS constraints",
        "rdfs:label": "SHACL Shapes Graph for POS",
        "rdfs:member": [
            {
                "@id": "ex:AltitudeDomainShape"
            },
            {
                "@id": "ex:AltitudeRangeShape"
            },
            {
                "@id": "ex:LatitudeDomainShape"
            },
            {
                "@id": "ex:LatitudeLongitudeValueShape"
            },
            {
                "@id": "ex:LatitudeRangeShape"
            },
            {
                "@id": "ex:LocationRangeShape"
            },
            {
                "@id": "ex:LongitudeDomainShape"
            },
            {
                "@id": "ex:LongitudeRangeShape"
            },
            {
                "@id": "ex:PointShape"
            }
        ]
    },
    {
        "@id": "ex:PointShape",
        "@type": "sh:NodeShape",
        "rdfs:isDefinedBy": {
            "@id": "ex:POSNullProfile"
        },
        "sh:class": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"
        },
        "sh:message": "Every pos:Point is a pos:SpatialThing (rdfs:subClassOf).",
        "sh:targetClass": {
            "@id": "http://www.w3.org/2003/01/geo/wgs84_pos#Point"
        }
    }
]
