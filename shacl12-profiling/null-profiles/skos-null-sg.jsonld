            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b8",
            "sh:message": "A skos:broaderTransitive assertion requires the same value for skos:semanticRelation.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:broaderTransitive ?value .\n    BIND (skos:semanticRelation AS ?path)\n    FILTER NOT EXISTS { $this skos:semanticRelation ?value }\n}"
        },
