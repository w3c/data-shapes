            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#prefLabel"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b42",
            "sh:message": "A skos:prefLabel assertion requires the same value for rdfs:label.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:prefLabel ?value .\n    BIND (rdfs:label AS ?path)\n    FILTER NOT EXISTS { $this rdfs:label ?value }\n}"
        },
        {
            "@id": "ex:HasTopConceptInverseShape",
            "@type": "sh:NodeShape",
