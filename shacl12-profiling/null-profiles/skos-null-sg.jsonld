        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b27",
            "sh:message": "A memberList item is missing its corresponding skos:member assertion (S36).",
            "sh:select": "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:memberList/rdf:rest*/rdf:first ?value .\n    BIND (skos:member AS ?path)\n    FILTER NOT EXISTS { $this skos:member ?value }\n}"
        },
