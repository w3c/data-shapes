            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "TopConceptOfInSchemeSubproperty",
            "sh:message": "A subproperty assertion requires its corresponding superproperty assertion.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b51"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#topConceptOf"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b51",
            "sh:message": "A skos:topConceptOf assertion requires the same value for skos:inScheme.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:topConceptOf ?value .\n    BIND (skos:inScheme AS ?path)\n    FILTER NOT EXISTS { $this skos:inScheme ?value }\n}"
        },
