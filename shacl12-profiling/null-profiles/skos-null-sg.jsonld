                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b33"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#narrower"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b33",
            "sh:message": "Each skos:narrower assertion requires its inverse skos:broader assertion.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:narrower ?value .\n    BIND (skos:narrower AS ?path)\n    FILTER NOT EXISTS { ?value skos:broader $this }\n}"
        },
        {
