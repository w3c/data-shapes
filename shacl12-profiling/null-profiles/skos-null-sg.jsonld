        {
            "@id": "ex:PreferredLabelLanguageShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S14"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "PreferredLabelLanguage",
            "sh:message": "A resource may have at most one preferred label per language, including at most one untagged label.",
            "sh:property": {
                "@id": "ex:PreferredLabelLanguagePrefLabelPropertyShape"
            },
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b43"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#prefLabel"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b43",
            "sh:message": "Two distinct skos:prefLabel values must not have the same language tag (including no tag).",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:prefLabel ?value, ?other .\n    BIND (skos:prefLabel AS ?path)\n    FILTER (isLiteral(?value) && isLiteral(?other))\n    FILTER (!sameTerm(?value, ?other))\n    FILTER (LCASE(LANG(?value)) = LCASE(LANG(?other)))\n}"
        },
        {
            "@id": "ex:OrderedCollectionConceptDisjointShape",
            "@type": "sh:NodeShape",
            "dcterms:source": [
                {
                    "@id": "https://www.w3.org/TR/skos-reference/#S29"
                },
                {
                    "@id": "https://www.w3.org/TR/skos-reference/#S37"
                }
            ],
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "OrderedCollectionConceptDisjoint",
            "sh:message": "skos:OrderedCollection and skos:Concept have disjoint instances.",
            "sh:not": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b38"
            },
            "sh:targetClass": {
                "@id": "http://www.w3.org/2004/02/skos/core#OrderedCollection"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b38",
            "sh:class": {
                "@id": "http://www.w3.org/2004/02/skos/core#Concept"
            }
        },
        {
            "@id": "ex:TopConceptOfInverseShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S8"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "TopConceptOfInverse",
            "sh:message": "An inverse-property assertion must have its corresponding reverse assertion.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b52"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#topConceptOf"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b52",
            "sh:message": "Each skos:topConceptOf assertion requires its inverse skos:hasTopConcept assertion.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:topConceptOf ?value .\n    BIND (skos:topConceptOf AS ?path)\n    FILTER NOT EXISTS { ?value skos:hasTopConcept $this }\n}"
        },
        {
            "@id": "ex:BroaderInverseShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S25"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "BroaderInverse",
            "sh:message": "An inverse-property assertion must have its corresponding reverse assertion.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b6"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#broader"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b6",
            "sh:message": "Each skos:broader assertion requires its inverse skos:narrower assertion.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:broader ?value .\n    BIND (skos:broader AS ?path)\n    FILTER NOT EXISTS { ?value skos:narrower $this }\n}"
        },
        {
            "@id": "ex:PreferredLabelLanguagePrefLabelPropertyShape",
            "sh:path": {
                "@id": "http://www.w3.org/2004/02/skos/core#prefLabel"
            },
            "sh:uniqueLang": {
                "@type": "xsd:boolean",
                "@value": true
            }
        },
        {
            "@id": "ex:TopConceptOfInSchemeSubpropertyShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
