        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b3",
            "sh:message": "Each skos:broadMatch assertion requires its inverse skos:narrowMatch assertion.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:broadMatch ?value .\n    BIND (skos:broadMatch AS ?path)\n    FILTER NOT EXISTS { ?value skos:narrowMatch $this }\n}"
        },
        {
            "@id": "ex:HasTopConceptRangeShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S6"
            },
            "rdfs:isDefinedBy": {
