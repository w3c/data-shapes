            "sh:class": {
                "@id": "http://www.w3.org/2004/02/skos/core#Concept"
            },
            "sh:message": "The domain of skos:topConceptOf must satisfy its SKOS class constraint.",
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#topConceptOf"
            }
        },
        {
            "@id": "ex:RelatedMatchRelatedSubpropertyShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S41"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "RelatedMatchRelatedSubproperty",
            "sh:message": "A subproperty assertion requires its corresponding superproperty assertion.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b46"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#relatedMatch"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b46",
            "sh:message": "A skos:relatedMatch assertion requires the same value for skos:related.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:relatedMatch ?value .\n    BIND (skos:related AS ?path)\n    FILTER NOT EXISTS { $this skos:related ?value }\n}"
        },
        {
            "@id": "ex:MemberRangeShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S32"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "MemberRange",
            "sh:message": "The range of skos:member must satisfy its SKOS class constraint.",
            "sh:or": {
                "@list": [
                    {
                        "@id": "ex:ConceptValueShape"
                    },
                    {
                        "@id": "ex:CollectionValueShape"
                    }
                ]
            },
            "sh:targetObjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#member"
            }
        },
        {
            "@id": "ex:BroadMatchMappingRelationSubpropertyShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S40"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "BroadMatchMappingRelationSubproperty",
            "sh:message": "A subproperty assertion requires its corresponding superproperty assertion.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b4"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#broadMatch"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b4",
            "sh:message": "A skos:broadMatch assertion requires the same value for skos:mappingRelation.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:broadMatch ?value .\n    BIND (skos:mappingRelation AS ?path)\n    FILTER NOT EXISTS { $this skos:mappingRelation ?value }\n}"
        },
        {
            "@id": "ex:DisjointLabelsPrefLabelaltLabelPropertyShape",
            "sh:disjoint": {
