            "rdfs:label": "MemberListFunctional",
            "sh:message": "skos:memberList is functional: at most one distinct RDF list head is allowed.",
            "sh:property": {
                "@id": "ex:MemberListFunctionalMemberListPropertyShape"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#memberList"
            }
        },
        {
            "@id": "ex:NarrowerTransitiveInverseShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S26"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "NarrowerTransitiveInverse",
            "sh:message": "An inverse-property assertion must have its corresponding reverse assertion.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b35"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#narrowerTransitive"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b35",
            "sh:message": "Each skos:narrowerTransitive assertion requires its inverse skos:broaderTransitive assertion.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:narrowerTransitive ?value .\n    BIND (skos:narrowerTransitive AS ?path)\n    FILTER NOT EXISTS { ?value skos:broaderTransitive $this }\n}"
        },
        {
            "@id": "ex:NotationRangeShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S15"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "NotationRange",
            "sh:message": "A skos:notation value must be a literal.",
            "sh:nodeKind": {
                "@id": "sh:Literal"
            },
            "sh:targetObjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#notation"
            }
        },
        {
            "@id": "ex:ExactMatchTransitivityShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S45"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "ExactMatchTransitivity",
            "sh:message": "skos:exactMatch must include the triples implied by transitivity.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b21"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#exactMatch"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b21",
            "sh:message": "A two-step skos:exactMatch path requires its direct transitive assertion.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:exactMatch/skos:exactMatch ?value .\n    BIND (skos:exactMatch AS ?path)\n    FILTER NOT EXISTS { $this skos:exactMatch ?value }\n}"
        },
        {
            "@id": "ex:RelatedMatchMappingRelationSubpropertyShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S40"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "RelatedMatchMappingRelationSubproperty",
            "sh:message": "A subproperty assertion requires its corresponding superproperty assertion.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b45"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#relatedMatch"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b45",
            "sh:message": "A skos:relatedMatch assertion requires the same value for skos:mappingRelation.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:relatedMatch ?value .\n    BIND (skos:mappingRelation AS ?path)\n    FILTER NOT EXISTS { $this skos:mappingRelation ?value }\n}"
        },
        {
            "@id": "ex:NarrowerInverseShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
