            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#narrowerTransitive"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b37",
            "sh:message": "A two-step skos:narrowerTransitive path requires its direct transitive assertion.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:narrowerTransitive/skos:narrowerTransitive ?value .\n    BIND (skos:narrowerTransitive AS ?path)\n    FILTER NOT EXISTS { $this skos:narrowerTransitive ?value }\n}"
        },
