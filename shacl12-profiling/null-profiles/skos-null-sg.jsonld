    "@graph": [
        {
            "@id": "ex:ObjectPropertyRangeShape",
            "@type": "sh:NodeShape",
            "dcterms:source": [
                {
                    "@id": "https://www.w3.org/TR/skos-reference/#S18"
                },
                {
                    "@id": "https://www.w3.org/TR/skos-reference/#S3"
                },
                {
                    "@id": "https://www.w3.org/TR/skos-reference/#S30"
                },
                {
                    "@id": "https://www.w3.org/TR/skos-reference/#S38"
                }
            ],
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "ObjectPropertyRange",
            "sh:message": "SKOS object-property values must be IRIs or blank nodes, not literals.",
            "sh:nodeKind": {
                "@id": "sh:BlankNodeOrIRI"
            },
            "sh:targetObjectsOf": [
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#broadMatch"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#broader"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#broaderTransitive"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#closeMatch"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#exactMatch"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#hasTopConcept"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#inScheme"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#mappingRelation"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#member"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#memberList"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#narrowMatch"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#narrower"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#narrowerTransitive"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#related"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#relatedMatch"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#semanticRelation"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#topConceptOf"
                }
            ]
        },
        {
            "@id": "ex:TopConceptOfDomainShape",
            "@type": "sh:NodeShape",
            "dcterms:source": [
                {
                    "@id": "https://www.w3.org/TR/skos-reference/#S6"
                },
                {
                    "@id": "https://www.w3.org/TR/skos-reference/#S8"
                }
            ],
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
