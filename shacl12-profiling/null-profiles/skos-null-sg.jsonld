        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b7",
            "sh:message": "Each skos:broaderTransitive assertion requires its inverse skos:narrowerTransitive assertion.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:broaderTransitive ?value .\n    BIND (skos:broaderTransitive AS ?path)\n    FILTER NOT EXISTS { ?value skos:narrowerTransitive $this }\n}"
        },
        {
            "@id": "ex:MemberListMembershipShape",
            "@type": "sh:NodeShape",
