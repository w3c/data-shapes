            "sh:path": {
                "@id": "http://www.w3.org/2004/02/skos/core#prefLabel"
            }
        },
        {
            "@id": "ex:OrderedCollectionConceptSchemeDisjointShape",
            "@type": "sh:NodeShape",
            "dcterms:source": [
                {
                    "@id": "https://www.w3.org/TR/skos-reference/#S29"
                },
                {
                    "@id": "https://www.w3.org/TR/skos-reference/#S37"
                }
            ],
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "OrderedCollectionConceptSchemeDisjoint",
            "sh:message": "skos:OrderedCollection and skos:ConceptScheme have disjoint instances.",
            "sh:not": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b39"
            },
            "sh:targetClass": {
                "@id": "http://www.w3.org/2004/02/skos/core#OrderedCollection"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b39",
            "sh:class": {
                "@id": "http://www.w3.org/2004/02/skos/core#ConceptScheme"
            }
        },
        {
            "@id": "ex:RelatedSemanticRelationSubpropertyShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S21"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "RelatedSemanticRelationSubproperty",
            "sh:message": "A subproperty assertion requires its corresponding superproperty assertion.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b48"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#related"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b48",
            "sh:message": "A skos:related assertion requires the same value for skos:semanticRelation.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:related ?value .\n    BIND (skos:semanticRelation AS ?path)\n    FILTER NOT EXISTS { $this skos:semanticRelation ?value }\n}"
        },
        {
            "@id": "ex:SemanticRelationDomainShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S19"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "SemanticRelationDomain",
            "sh:class": {
                "@id": "http://www.w3.org/2004/02/skos/core#Concept"
            },
            "sh:message": "The domain of skos:semanticRelation must satisfy its SKOS class constraint.",
            "sh:targetSubjectsOf": [
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#broadMatch"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#broader"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#broaderTransitive"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#closeMatch"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#exactMatch"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#mappingRelation"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#narrowMatch"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#narrower"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#narrowerTransitive"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#related"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#relatedMatch"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#semanticRelation"
                }
            ]
        },
        {
            "@id": "ex:OrderedCollectionSubclassShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S29"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "OrderedCollectionSubclass",
            "sh:class": {
                "@id": "http://www.w3.org/2004/02/skos/core#Collection"
            },
            "sh:message": "A skos:OrderedCollection must also be a skos:Collection.",
            "sh:targetClass": {
                "@id": "http://www.w3.org/2004/02/skos/core#OrderedCollection"
            }
        },
        {
            "@id": "ex:ExactMatchCloseMatchSubpropertyShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S42"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "ExactMatchCloseMatchSubproperty",
            "sh:message": "A subproperty assertion requires its corresponding superproperty assertion.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b18"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#exactMatch"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b18",
            "sh:message": "A skos:exactMatch assertion requires the same value for skos:closeMatch.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:exactMatch ?value .\n    BIND (skos:closeMatch AS ?path)\n    FILTER NOT EXISTS { $this skos:closeMatch ?value }\n}"
        },
        {
            "@id": "ex:MemberListDomainShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S33"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "MemberListDomain",
            "sh:class": {
                "@id": "http://www.w3.org/2004/02/skos/core#OrderedCollection"
            },
            "sh:message": "The domain of skos:memberList must satisfy its SKOS class constraint.",
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#memberList"
            }
        },
        {
            "@id": "ex:ChangeNoteNoteSubpropertyShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S17"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "ChangeNoteNoteSubproperty",
            "sh:message": "A subproperty assertion requires its corresponding superproperty assertion.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b10"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#changeNote"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b10",
            "sh:message": "A skos:changeNote assertion requires the same value for skos:note.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:changeNote ?value .\n    BIND (skos:note AS ?path)\n    FILTER NOT EXISTS { $this skos:note ?value }\n}"
        },
        {
            "@id": "ex:ExactMatchDisjointShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S46"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "ExactMatchDisjoint",
            "sh:message": "skos:exactMatch cannot overlap skos:broadMatch or skos:relatedMatch.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b19"
            },
            "sh:targetObjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#exactMatch"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#exactMatch"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b19",
            "sh:message": "An exactMatch pair also has a broadMatch/narrowMatch or relatedMatch relation (S46).",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this (skos:exactMatch|^skos:exactMatch)+ ?value .\n    $this (skos:broadMatch|^skos:narrowMatch|skos:relatedMatch|^skos:relatedMatch) ?value .\n    BIND (skos:exactMatch AS ?path)\n}"
        },
        {
            "@id": "ex:HistoryNoteNoteSubpropertyShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S17"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "HistoryNoteNoteSubproperty",
            "sh:message": "A subproperty assertion requires its corresponding superproperty assertion.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b25"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#historyNote"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b25",
            "sh:message": "A skos:historyNote assertion requires the same value for skos:note.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:historyNote ?value .\n    BIND (skos:note AS ?path)\n    FILTER NOT EXISTS { $this skos:note ?value }\n}"
        },
        {
            "@id": "ex:DisjointLabelsShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S13"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "DisjointLabels",
            "sh:message": "A label value cannot be used in two different SKOS lexical labeling properties on one resource.",
            "sh:property": [
                {
                    "@id": "ex:DisjointLabelsAltLabelhiddenLabelPropertyShape"
                },
                {
                    "@id": "ex:DisjointLabelsPrefLabelaltLabelPropertyShape"
                },
                {
                    "@id": "ex:DisjointLabelsPrefLabelhiddenLabelPropertyShape"
                }
            ],
            "sh:targetSubjectsOf": [
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#altLabel"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#hiddenLabel"
                },
                {
                    "@id": "http://www.w3.org/2004/02/skos/core#prefLabel"
                }
            ]
        },
        {
            "@id": "ex:CloseMatchSymmetryShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S44"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "CloseMatchSymmetry",
            "sh:message": "skos:closeMatch requires a reverse assertion of the same property.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b12"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#closeMatch"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b12",
            "sh:message": "skos:closeMatch is symmetric.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:closeMatch ?value .\n    BIND (skos:closeMatch AS ?path)\n    FILTER NOT EXISTS { ?value skos:closeMatch $this }\n}"
        },
        {
            "@id": "ex:MemberListRangeShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S34"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "MemberListRange",
            "sh:class": {
                "@id": "rdf:List"
            },
            "sh:message": "The range of skos:memberList must satisfy its SKOS class constraint.",
            "sh:targetObjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#memberList"
            }
        },
        {
            "@id": "ex:BroaderTransitiveTransitivityShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S24"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "BroaderTransitiveTransitivity",
            "sh:message": "skos:broaderTransitive must include the triples implied by transitivity.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b9"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#broaderTransitive"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b9",
            "sh:message": "A two-step skos:broaderTransitive path requires its direct transitive assertion.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:broaderTransitive/skos:broaderTransitive ?value .\n    BIND (skos:broaderTransitive AS ?path)\n    FILTER NOT EXISTS { $this skos:broaderTransitive ?value }\n}"
        },
        {
            "@id": "ex:CollectionConceptDisjointShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S37"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
            "rdfs:label": "CollectionConceptDisjoint",
            "sh:message": "skos:Collection and skos:Concept have disjoint instances.",
            "sh:not": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b13"
            },
            "sh:targetClass": {
                "@id": "http://www.w3.org/2004/02/skos/core#Collection"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b13",
            "sh:class": {
                "@id": "http://www.w3.org/2004/02/skos/core#Concept"
            }
        },
        {
            "@id": "ex:NarrowMatchMappingRelationSubpropertyShape",
            "@type": "sh:NodeShape",
            "dcterms:source": {
                "@id": "https://www.w3.org/TR/skos-reference/#S40"
            },
            "rdfs:isDefinedBy": {
                "@id": "ex:SKOSNullProfile"
            },
