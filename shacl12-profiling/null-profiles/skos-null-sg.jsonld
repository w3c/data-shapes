            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b2",
            "sh:message": "A skos:broadMatch assertion requires the same value for skos:broader.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:broadMatch ?value .\n    BIND (skos:broader AS ?path)\n    FILTER NOT EXISTS { $this skos:broader ?value }\n}"
        },
