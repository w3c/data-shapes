            },
            "rdfs:label": "HasTopConceptInverse",
            "sh:message": "An inverse-property assertion must have its corresponding reverse assertion.",
            "sh:sparql": {
                "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b23"
            },
            "sh:targetSubjectsOf": {
                "@id": "http://www.w3.org/2004/02/skos/core#hasTopConcept"
            }
        },
        {
            "@id": "_:n65257206cf7a46d5acdf7cc7fe290338b23",
            "sh:message": "Each skos:hasTopConcept assertion requires its inverse skos:topConceptOf assertion.",
            "sh:select": "PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nSELECT DISTINCT $this ?path ?value WHERE {\n    $this skos:hasTopConcept ?value .\n    BIND (skos:hasTopConcept AS ?path)\n    FILTER NOT EXISTS { ?value skos:topConceptOf $this }\n}"
        },
