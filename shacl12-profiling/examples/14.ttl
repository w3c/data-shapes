<Report1>
    a sh:ValidationReport ;
    sh:conforms true ;
    sh:usedDataGraph <DG1> ;
    sh:usedShapesGraph <SG1> ;
    sh:usedConfiguration [
        a sh:ProcessorConfiguration ;
        ex:processorName "SHACL-Acme" ;
        ex:processorVersion "3.2.1" ;
        ex:maxIterations 1000 ;
        ex:parallelValidation true ;
    ] .
