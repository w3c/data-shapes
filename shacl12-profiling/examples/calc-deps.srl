# dependency through element definition and reuse
RULE {
  ?sg1 dcterms:requires ?sg2 .
}
WHERE {
  ?sg1
    a sh:ShapesGraph ;
    rdfs:member ?shape ;
  .

  ?shape rdfs:isDefinedBy ?sg2 .
  ?sg2 a sh:ShapesGraph .

  FILTER (?sg1 != ?sg2)  # exclude self-dependencies
}

# dependency through importing
# base case: un-versioned importing only runs id versioned importing does not
RULE {
  ?sg1 dcterms:requires ?sg2 .
}
WHERE {
  ?sg1 owl:imports ?sg2 .

  NOT {
    ?sg1 dcterms:requires ?sg2 .
  }
}

# versioned importing
RULE {
  ?sg1 dcterms:requires ?sg2_v .
}
WHERE {
  ?sg1 owl:imports ?sg2 .
  ?sg2 owl:versionIRI ?sg2_v .
}

# transitive dependency
RULE {
    ?sg1 dcterms:requires ?sg3 .
}
WHERE {
    ?sg1 dcterms:requires ?sg2 .
    ?sg2 dcterms:requires ?sg3 .
    FILTER (?sg1 != ?sg3)
}
