<http://www.w3.org/ns/shacl/profile/cd1>
    a prof:Profile ;
    rdfs:label "Non-Recursive Profile of SHACL" ;
    rdfs:comment """This is a Profile of SHACL 1.2 that excludes SHACL elements found to
cause recursion in validation.

Vocabulary elements of SHACL that are not listed as members of this profile may
not be used for implementations claiming conformance to this profile.""" ;
    prof:isProfileOf <http://www.w3.org/ns/shacl/profile/core> ;
    prof:hasResource <http://www.w3.org/ns/shacl/profile/core/nr-elements-desc> ,
.

<http://www.w3.org/ns/shacl/profile/core/nr-elements-desc>
  a prof:ResourceDescriptor ;
  prof:hasRole role:vocabulary ;
  prof:hasArtifact <http://www.w3.org/ns/shacl/profile/core/nr-elements> ;
.

<http://www.w3.org/ns/shacl/profile/core/nr-elements>
    a rdf:Bag;
    rdfs:label "Non-Recursive SHACL elements" ;
    rdfs:comment "Elements of SHACL 1.2 Core that do not cause recursion when used for validation" ;
    rdfs:member
        sh:AbstractResult ,
        sh:AndConstraintComponent ,

        # ... many skipped members

        sh:xone ,
        sh:zeroOrMorePath ,
        sh:zeroOrOnePath ;

        # not listed:
        #
        # sh:not
        # sh:qualifiedMaxCount
        # sh:qualifiedValueShapesDisjoint
        # sh:xone
.