PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX prez: <https://prez.dev/>

prez:AllProps
    a sh:NodeShape ;
    dcterms:description "A SHACL Shape returning all properties and blank nodes to a depth of two" ;
    dcterms:title "All Properties Shape" ;
    sh:targetClass geo:Feature ;
    sh:property [
        sh:path [
            sh:union (
                [ ex:bNodeDepth "2" ]
                ex:allPredicateValues
            ) ;
        ] ;
    ] ;
.

prez:FeatureCollMinimalProps
    a sh:NodeShape ;
    dcterms:description "A SHACL Shape returning just the name, bounding box coordinates and type and name of members" ;
    dcterms:title "Features Minimal Profile" ;
    sh:targetClass geo:FeatureCollection ;
    sh:property [
        sh:path [
            sh:union (
                schema:name
                (
                    geo:hasBoundingBox
                    geo:asWKT
                )
                (
                    rdfs:member
                    rdf:type
                )
                (
                    rdfs:member
                    schema:name
                )
            ) ;
        ] ;
    ] ;
.
