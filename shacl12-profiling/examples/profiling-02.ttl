<SG1>
    a prof:Profile ;
    prof:isProfileOf <S1> ;
    prof:hasResource
        [
            prof:hasArtifact <SG1> ;
            prof:hasRole
                role:schema ,
                role:validation ;
            dcterms:conformsTo <https://www.w3.org/TR/shacl12-core/> ;
            dcterms:format "text/turtle" ;
        ] ;
.

<S1> a dcterms:Standard .