  # causes an infinite validation loop
  ex:FolderA a ex:Folder ; ex:containsFolder ex:FolderB .
  ex:FolderB a ex:Folder ; ex:containsFolder ex:FolderA .

  # causes an infinite validation loop
  ex:FolderA a ex:Folder ; ex:containsFolder ex:FolderB .
  ex:FolderB a ex:Folder ; ex:containsFolder ex:FolderC .
  ex:FolderC a ex:Folder ; ex:containsFolder ex:FolderA .