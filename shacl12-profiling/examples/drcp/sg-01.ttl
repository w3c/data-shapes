ex:NonRecursiveConstraintsValidator
  a sh:NodeShape ;

  # Cover both explicitly typed and structurally-used shapes:
  sh:targetClass sh:Shape ;
  sh:targetClass sh:NodeShape ;
  sh:targetClass sh:PropertyShape ;
  sh:targetSubjectsOf sh:node ;
  sh:targetSubjectsOf sh:property ;
  sh:targetSubjectsOf sh:qualifiedValueShape ;
  sh:targetSubjectsOf sh:not ;
  sh:targetSubjectsOf sh:and ;
  sh:targetSubjectsOf sh:or ;
  sh:targetSubjectsOf sh:xone ;

  # Capture shapes that appear only as list members or property shapes:
  sh:targetObjectsOf sh:property ;
  sh:targetObjectsOf rdf:first ;

 # Target members inside shape lists
 sh:targetNode [
    sh:select """
      SELECT ?member
      WHERE {
        ?shape (sh:and|sh:or|sh:xone)/rdf:rest*/rdf:first ?member .
      }
    """
  ] ;

  sh:sparql ex:NoRecursiveShapeReferencesConstraint
.

ex:NoRecursiveShapeReferencesConstraint
  a sh:SPARQLConstraint ;
  sh:severity sh:Violation ;
  sh:message "Recursive constraints are disallowed by this profile: a shape is (directly or indirectly) reachable from itself via shape references (e.g., sh:node, sh:property, sh:not, sh:and/or/xone members, sh:qualifiedValueShape)." ;
  sh:select """
    PREFIX sh: <http://www.w3.org/ns/shacl#>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

    SELECT $this
    WHERE {
       FILTER EXISTS {
         $this (
              sh:node
           | sh:property
           | sh:qualifiedValueShape
           | sh:not
           | sh:memberShape
           | sh:reifierShape
           | sh:someValue
           | (sh:and|sh:or|sh:xone)/(rdf:rest*/rdf:first)
         )+ $this .
       }
    }
  """
.