[
  {
    "@id": "http://example.com/ns#NoRecursiveShapeReferencesConstraint",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Recursive constraints are disallowed by this profile: a shape is (directly or indirectly) reachable from itself via shape references (e.g., sh:node, sh:property, sh:not, sh:and/or/xone members, sh:qualifiedValueShape)."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    PREFIX sh: <http://www.w3.org/ns/shacl#>\n    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\n\n    SELECT $this\n    WHERE {\n       FILTER EXISTS {\n         $this (\n              sh:node\n           | sh:property\n           | sh:qualifiedValueShape\n           | sh:not\n           | sh:memberShape\n           | sh:reifierShape\n           | sh:someValue\n           | (sh:and|sh:or|sh:xone)/(rdf:rest*/rdf:first)\n         )+ $this .\n       }\n    }\n  "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "http://example.com/ns#NonRecursiveConstraintsValidator",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "http://example.com/ns#NoRecursiveShapeReferencesConstraint"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://www.w3.org/ns/shacl#Shape"
      },
      {
        "@id": "http://www.w3.org/ns/shacl#NodeShape"
      },
      {
        "@id": "http://www.w3.org/ns/shacl#PropertyShape"
      }
    ],
    "http://www.w3.org/ns/shacl#targetNode": [
      {
        "@id": "_:n08e3fa99c94c4632bcf076ae9779fb6db1"
      }
    ],
    "http://www.w3.org/ns/shacl#targetObjectsOf": [
      {
        "@id": "http://www.w3.org/ns/shacl#property"
      },
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#first"
      }
    ],
    "http://www.w3.org/ns/shacl#targetSubjectsOf": [
      {
        "@id": "http://www.w3.org/ns/shacl#node"
      },
      {
        "@id": "http://www.w3.org/ns/shacl#property"
      },
      {
        "@id": "http://www.w3.org/ns/shacl#qualifiedValueShape"
      },
      {
        "@id": "http://www.w3.org/ns/shacl#not"
      },
      {
        "@id": "http://www.w3.org/ns/shacl#and"
      },
      {
        "@id": "http://www.w3.org/ns/shacl#or"
      },
      {
        "@id": "http://www.w3.org/ns/shacl#xone"
      }
    ]
  },
  {
    "@id": "_:n08e3fa99c94c4632bcf076ae9779fb6db1",
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      SELECT ?member\n      WHERE {\n        ?shape (sh:and|sh:or|sh:xone)/rdf:rest*/rdf:first ?member .\n      }\n    "
      }
    ]
  }
]