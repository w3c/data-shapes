[
    {
        "@id": "_:c14n0",
        "sh:select": "\n      SELECT ?member\n      WHERE {\n        ?shape (sh:and|sh:or|sh:xone)/rdf:rest*/rdf:first ?member .\n      }\n    "
    },
    {
        "@id": "ex:NoRecursiveShapeReferencesConstraint",
        "@type": "sh:SPARQLConstraint",
        "sh:message": "Recursive constraints are disallowed by this profile: a shape is (directly or indirectly) reachable from itself via shape references (e.g., sh:node, sh:property, sh:not, sh:and/or/xone members, sh:qualifiedValueShape).",
        "sh:select": "\n    PREFIX sh: <http://www.w3.org/ns/shacl#>\n    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\n\n    SELECT $this\n    WHERE {\n       FILTER EXISTS {\n         $this (\n              sh:node\n           | sh:property\n           | sh:qualifiedValueShape\n           | sh:not\n           | sh:memberShape\n           | sh:reifierShape\n           | sh:someValue\n           | (sh:and|sh:or|sh:xone)/(rdf:rest*/rdf:first)\n         )+ $this .\n       }\n    }\n  ",
        "sh:severity": {
            "@id": "sh:Violation"
        }
    },
    {
        "@id": "ex:NonRecursiveConstraintsValidator",
        "@type": "sh:NodeShape",
        "sh:sparql": {
            "@id": "ex:NoRecursiveShapeReferencesConstraint"
        },
        "sh:targetClass": [
            {
                "@id": "sh:NodeShape"
            },
            {
                "@id": "sh:PropertyShape"
            },
            {
                "@id": "sh:Shape"
            }
        ],
        "sh:targetNode": {
            "@id": "_:c14n0"
        },
        "sh:targetObjectsOf": [
            {
                "@id": "rdf:first"
            },
            {
                "@id": "sh:property"
            }
        ],
        "sh:targetSubjectsOf": [
            {
                "@id": "sh:and"
            },
            {
                "@id": "sh:node"
            },
            {
                "@id": "sh:not"
            },
            {
                "@id": "sh:or"
            },
            {
                "@id": "sh:property"
            },
            {
                "@id": "sh:qualifiedValueShape"
            },
            {
                "@id": "sh:xone"
            }
        ]
    }
]
