    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "This is a Profile of SHACL 1.2 that excludes SHACL elements found to\ncause recursion in validation.\n\nVocabulary elements of SHACL that are not listed as members of this profile may\nnot be used for implementations claiming conformance to this profile."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Non-Recursive Profile of SHACL"
      }
