ex:dg a sh:DataGraph .

ex:sg a sh:DataGraph .

ex:ag a sh:ShaclAgent .

ex:vr a sh:ValidationReport .

ex:ac
    a sh:ShaclActivity ;
    prov:wasAssociatedWith ex:ag ;
    prov:used
        ex:dg ,  # or sh:usedDataGraph
        ex:sg ;  # or sh:usedShapesGraph
    prov:generated ex:vr ;
.

# If the Validation Report indicates validity, with sh:conforms being true then,
# as per the Rules in this specification's vocabulary:

ex:dg
    sh:conformsToShapesGraph ex:sg ;
.
