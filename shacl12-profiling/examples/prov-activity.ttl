# activity-centric

ex:dg
    a sh:DataGraph ;
.

ex:sg
    a sh:DataGraph ;
.

ex:ag
    a sh:ValidationAgent ;
.

ex:vr
    a sh:ValidationReport ;
.

ex:ac
    a sh:ValidationActivity ;
    prov:wasAssociatedWith ex:ag ;
    prov:used
        ex:dg ,  # or sh:usedDataGraph
        ex:sg ;  # or sh:usedShapesGraph
    prov:generated ex:vr ;
.
