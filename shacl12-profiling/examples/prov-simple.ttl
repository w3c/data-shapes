# output-linked

ex:dg
    a sh:DataGraph ;
.

ex:sg
    a sh:DataGraph ;
.

ex:ag
    a sh:ValidationAgent ;
.

ex:vr
    a sh:ValidationReport ;
    prov:wasAttributedTo ex:ag ;
    prov:wasDerivedFrom
        ex:dg ,
        ex:sg ;
.

# If the Validation Report indicates validity, with sh:conforms being true then,
# as per the Rules in this vocab:

ex:dg
    sh:conformsToShapesGraph ex:sg ;
.
