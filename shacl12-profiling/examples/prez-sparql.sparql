# prez:AllProps
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
    ?subject ?predicate ?object .
}
WHERE {
    ?focus rdf:type/rdfs:subClassOf* geo:Feature .
    {
        ?focus ?predicate ?object .
        BIND(?focus AS ?subject)
    }
    UNION
    {
        ?focus ?firstPredicate ?subject .
        FILTER(isBlank(?subject))
        ?subject ?predicate ?object .
    }
    UNION
    {
        ?focus ?firstPredicate ?firstBlank .
        FILTER(isBlank(?firstBlank))
        ?firstBlank ?secondPredicate ?subject .
        FILTER(isBlank(?subject))
        ?subject ?predicate ?object .
    }
}


# prez:FeatureCollMinimalProps
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>

CONSTRUCT {
    ?focus
        schema:name ?name ;
        geo:hasBoundingBox ?boundingBox ;
        rdfs:member ?member ;
    .

    ?boundingBox geo:asWKT ?wkt .
    ?member
        rdf:type ?memberType ;
        schema:name ?memberName ;
    .
}
WHERE {
    ?focus rdf:type/rdfs:subClassOf* geo:FeatureCollection .
    {
        ?focus schema:name ?name .
    }
    UNION
    {
        ?focus geo:hasBoundingBox ?boundingBox .
        ?boundingBox geo:asWKT ?wkt .
    }
    UNION
    {
        ?focus rdfs:member ?member .
        ?member rdf:type ?memberType .
    }
    UNION
    {
        ?focus rdfs:member ?member .
        ?member schema:name ?memberName .
    }
}
