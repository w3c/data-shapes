PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>

sh:ValidationAction
    rdfs:subClassOf prov:Activity ;
.

sh:ValidationAgent
    rdfs:subClassOf prov:Agent ;
.

sh:usedDataGraph
    rdfs:subPropertyOf prov:used ;
.

sh:usedShapesGraph
    rdfs:subPropertyOf prov:used ;
.
