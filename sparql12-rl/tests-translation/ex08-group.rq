# Translation of ex08-group.srl
# Execute over: default graph = the graph the rule body matches.
#
# The group element becomes an uncorrelated sub-SELECT, joined on the group
# key ?x.  FILTER(BOUND(?m)) drops a group whose MAX raised an evaluation
# error, as rule evaluation does; COUNT cannot raise an error, so ?n needs
# no guard.  A component with no :exposedTo match forms no group and so
# yields no triples — in both the rule and the query.

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX :    <http://example/>

CONSTRUCT { ?x :vulnerabilityCount ?n ;
               :maxSeverity ?m }
WHERE {
    ?x rdf:type :Component .
    { SELECT ?x (COUNT(*) AS ?n) (MAX(?s) AS ?m)
      WHERE { ?x :exposedTo ?v . ?v :severity ?s }
      GROUP BY ?x
    }
    FILTER( BOUND(?m) )
}
