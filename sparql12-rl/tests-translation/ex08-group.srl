# Translation example: GROUP BY with aggregation assignments.

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX :    <http://example/>

RULE { ?x :vulnerabilityCount ?n ;
          :maxSeverity ?m }
WHERE {
    ?x rdf:type :Component .
    GROUP BY ?x { ?x :exposedTo ?v . ?v :severity ?s }
        [ ?n := COUNT(*) , ?m := MAX(?s) ]
}
