# Translation of ex14-path-inverse.srl
# Execute over: default graph = the graph the rule body matches.
#
# An inverse path carries over unchanged.  Expanded, it is one triple
# pattern with the subject and object exchanged:
#     ?team :owns ?x .

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX :    <http://example/>

CONSTRUCT { ?team :responsibleFor ?x }
WHERE {
    ?x rdf:type :Component .
    ?x ^:owns ?team .
}
