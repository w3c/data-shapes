# Translation example: property path - inverse of a sequence.
# "?v ^(:owns/:exposedTo) ?team" matches when ?team owns a component
# that is exposed to ?v.

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX :    <http://example/>

RULE { ?team :mustReview ?v }
WHERE {
    ?v rdf:type :Vulnerability .
    ?v ^(:owns/:exposedTo) ?team .
}
