# Translation example: blank node in the rule head.
# Each evaluation of the head creates a fresh blank node per solution.

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX :    <http://example/>

RULE { [] rdf:type :Notification ; :concerns ?x }
WHERE {
    ?x :status :criticallyExposed .
}
