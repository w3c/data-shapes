# Translation of ex06-where-data.srl
# Execute over: default graph = the base graph G0.
#
# A WHERE DATA rule needs no GRAPH clause: the query as a whole is evaluated
# against the base graph.  The query text is otherwise the same as for the
# ordinary rule (ex05-not-data.rq); only the dataset differs.

PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX :    <http://example/>

CONSTRUCT { ?x :distanceKilometers ?kilometers }
WHERE {
    { ?x :distanceMiles ?miles .
      FILTER NOT EXISTS { ?x :distanceKilometers ?km }
    }
    BIND( xsd:integer(?miles * 1.60934) AS ?kilometers )
    FILTER( BOUND(?kilometers) )
}
