# Translation example: property path - sequence and inverse together.
# SRL paths (sequence "/" and inverse "^") are a subset of SPARQL paths.

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX :    <http://example/>

RULE { ?team :mustPatch ?v }
WHERE {
    ?v rdf:type :Vulnerability .
    ?v :foundIn/^:owns ?team .
}
