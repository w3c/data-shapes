# Translation example: WHERE DATA.
# The whole rule body matches the base graph; NOT and NOT DATA coincide
# in a WHERE DATA rule.

PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX :    <http://example/>

RULE { ?x :distanceKilometers ?kilometers }
WHERE DATA {
    ?x :distanceMiles ?miles .
    NOT { ?x :distanceKilometers ?km }
    SET ( ?kilometers := xsd:integer(?miles * 1.60934) )
}
