# Translation example: NOT followed by elements that bind a variable
# occurring in the negation body.
#
# At the NOT, ?a is local to the negation body: the rule applies to a
# component with no :approvedBy value at all.  The ?a bound afterwards by
# ?t :reviewer ?a is an unrelated, fresh binding.

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX :    <http://example/>

RULE { ?x :needsReview true }
WHERE {
    ?x rdf:type :Component .
    NOT { ?x :approvedBy ?a }
    ?x :inTeam ?t .
    ?t :reviewer ?a .
}
