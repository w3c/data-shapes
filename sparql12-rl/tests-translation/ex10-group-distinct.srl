# Translation example: GROUP with keys and no aggregation assignments ("[]").
# One solution per distinct key tuple of the group pattern — here an
# existence test per team, however many owned components are exposed.

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX :    <http://example/>

RULE { ?t :teamExposed true }
WHERE {
    ?t rdf:type :Team .
    GROUP BY ?t { ?t :owns ?x . ?x :exposedTo ?v } []
}
