# Translation of ex09-group-nokeys.srl
# Execute over: default graph = the graph the rule body matches.
#
# Without GROUP BY, a SPARQL aggregate query returns one row even when the
# pattern has no solutions (?n = 0), whereas the group element then produces
# no solutions.  The fresh row count ?g0 with FILTER(?g0 > 0) restores the
# rule behavior.  (Here a COUNT(*) is already projected, so a translator may
# reuse ?n in the guard instead of adding ?g0.)

PREFIX : <http://example/>

CONSTRUCT { :deployment :exposureCount ?n }
WHERE {
    { SELECT (COUNT(*) AS ?n) (COUNT(*) AS ?g0) WHERE { ?x :exposedTo ?v } }
    FILTER( ?g0 > 0 )
}
