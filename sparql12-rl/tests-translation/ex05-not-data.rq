# Translation of ex05-not-data.srl
# Execute over: default graph = the evaluation graph GE;
#               named graph <urn:srl:base-graph> = the base graph G0.
#
# NOT DATA matches the base graph only: the negation body is wrapped in
# GRAPH <urn:srl:base-graph>.
# SET becomes BIND + FILTER(BOUND(..)): an error evaluating the expression
# drops the solution, as SET does.
# The inner group ends the scope of the negation before the BIND.

PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX :    <http://example/>

CONSTRUCT { ?x :distanceKilometers ?kilometers }
WHERE {
    { ?x :distanceMiles ?miles .
      FILTER NOT EXISTS { GRAPH <urn:srl:base-graph> { ?x :distanceKilometers ?km } }
    }
    BIND( xsd:integer(?miles * 1.60934) AS ?kilometers )
    FILTER( BOUND(?kilometers) )
}
