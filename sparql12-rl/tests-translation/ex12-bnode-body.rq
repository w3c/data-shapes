# Translation of ex12-bnode-body.srl
# Execute over: default graph = the graph the rule body matches.
#
# Each body blank node is replaced by a fresh variable (?_b0), consistently
# across its occurrences.  Besides matching the evaluation definition, the
# replacement keeps the query legal when the translation introduces group
# boundaries: SPARQL forbids one blank node label in two basic graph
# patterns.

PREFIX : <http://example/>

CONSTRUCT { ?x :hasKnownIssue true }
WHERE {
    ?x :exposedTo ?_b0 .
    ?_b0 :severity ?s .
    FILTER(?s >= 7.0)
}
