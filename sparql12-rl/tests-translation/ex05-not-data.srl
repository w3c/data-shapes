# Translation example: NOT DATA and SET.
# From the specification, "Matching Base Data": set a default value when the
# base graph has none, while other rules may also infer :distanceKilometers.

PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX :    <http://example/>

RULE { ?x :distanceKilometers ?kilometers }
WHERE {
    ?x :distanceMiles ?miles .
    NOT DATA { ?x :distanceKilometers ?km }
    SET ( ?kilometers := xsd:integer(?miles * 1.60934) )
}
