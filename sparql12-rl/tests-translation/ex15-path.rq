# Translation of ex15-path.srl
# Execute over: default graph = the graph the rule body matches.
#
# A path of a sequence and an inverse carries over unchanged.  A translator
# that expands paths to triple patterns with fresh variables would emit:
#     ?v :foundIn ?_p0 .
#     ?team :owns ?_p0 .

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX :    <http://example/>

CONSTRUCT { ?team :mustPatch ?v }
WHERE {
    ?v rdf:type :Vulnerability .
    ?v :foundIn/^:owns ?team .
}
