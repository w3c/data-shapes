# Translation of ex11-bnode-head.srl
# Execute over: default graph = the graph the rule body matches.
#
# The template blank node carries over unchanged: CONSTRUCT creates a fresh
# blank node for each solution, which is replaceBlankNodes applied per
# solution in evalRule.  (A rule with a head blank node is a run-once rule;
# that is handled by rule set evaluation, not by the translation.)

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX :    <http://example/>

CONSTRUCT { [] rdf:type :Notification ; :concerns ?x }
WHERE {
    ?x :status :criticallyExposed .
}
