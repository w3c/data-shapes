# Translation of ex07-set.srl
# Execute over: default graph = the graph the rule body matches.
#
# SET(?r := e) becomes BIND(e AS ?r) FILTER(BOUND(?r)).  The FILTER removes
# solutions in which the expression raised an error (for example a
# non-numeric :severity value); SPARQL BIND alone would pass them on with
# ?r unbound.  Nothing follows the SET, so no extra nesting is needed.

PREFIX : <http://example/>

CONSTRUCT { ?v :riskScore ?r }
WHERE {
    ?v :severity ?s .
    ?v :exploitLikelihood ?p .
    BIND( ?s * ?p AS ?r )
    FILTER( BOUND(?r) )
}
