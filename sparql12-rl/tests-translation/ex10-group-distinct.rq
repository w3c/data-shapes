# Translation of ex10-group-distinct.srl
# Execute over: default graph = the graph the rule body matches.
#
# The "[]" form becomes SELECT DISTINCT over the group keys: one row per
# distinct key tuple, joined on the keys.  The group pattern's other
# variables (?x, ?v) are local to the sub-select.

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX :    <http://example/>

CONSTRUCT { ?t :teamExposed true }
WHERE {
    ?t rdf:type :Team .
    { SELECT DISTINCT ?t WHERE { ?t :owns ?x . ?x :exposedTo ?v } }
}
