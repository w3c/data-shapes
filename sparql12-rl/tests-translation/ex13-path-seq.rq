# Translation of ex13-path-seq.srl
# Execute over: default graph = the graph the rule body matches.
#
# A sequence path carries over unchanged.  A translator that expands paths
# to triple patterns with fresh variables would emit:
#     ?x :exposedTo ?_p0 .
#     ?_p0 :severity ?s .

PREFIX : <http://example/>

CONSTRUCT { ?x :exposedToSeverity ?s }
WHERE {
    ?x :exposedTo/:severity ?s .
}
