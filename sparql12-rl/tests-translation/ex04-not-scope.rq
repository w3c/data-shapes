# Translation of ex04-not-scope.srl
# Execute over: default graph = the graph the rule body matches.
#
# The nested group is required.  Written as one group, the FILTER NOT EXISTS
# would be evaluated at the end of that group, where ?a is bound by
# ?t :reviewer ?a and would be substituted into the EXISTS pattern — turning
# "?x has no :approvedBy value" into "?x is not approved by that reviewer".
# The inner group ends the negation's scope at its position in the rule body.

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX :    <http://example/>

CONSTRUCT { ?x :needsReview true }
WHERE {
    { ?x rdf:type :Component .
      FILTER NOT EXISTS { ?x :approvedBy ?a }
    }
    ?x :inTeam ?t .
    ?t :reviewer ?a .
}
