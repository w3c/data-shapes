# Translation of ex16-path-inverse-seq.srl
# Execute over: default graph = the graph the rule body matches.
#
# An inverse applied to a sequence carries over unchanged.  A translator
# that expands paths to triple patterns with fresh variables would emit
# the sequence with the subject and object exchanged:
#     ?team :owns ?_p0 .
#     ?_p0 :exposedTo ?v .

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX :    <http://example/>

CONSTRUCT { ?team :mustReview ?v }
WHERE {
    ?v rdf:type :Vulnerability .
    ?v ^(:owns/:exposedTo) ?team .
}
