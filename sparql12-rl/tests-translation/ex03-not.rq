# Translation of ex03-not.srl
# Execute over: default graph = the graph the rule body matches.
#
# NOT becomes FILTER NOT EXISTS.  Nothing follows the negation, so the group
# that freezes its scope is the WHERE clause itself: no extra nesting.

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX :    <http://example/>

CONSTRUCT { ?x :status :safeToDeploy }
WHERE {
    ?x rdf:type :Component .
    FILTER NOT EXISTS { ?x :status :criticallyExposed }
}
