PREFIX :       <manifest#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX srlt:   <http://www.w3.org/ns/sparql-rl-tests#>

<>  rdf:type mf:Manifest ;
    rdfs:comment "SPARQL-RL - Translation to SPARQL CONSTRUCT" ;
    mf:entries (
        :test_1
        :test_2
        :test_3
        :test_4
        :test_5
        :test_6
        :test_7
        :test_8
        :test_9
        :test_10
        :test_11
        :test_12
        :test_13
        :test_14
        :test_15
        :test_16
    ) .

:test_1 rdf:type   srlt:RulesPositiveTranslationTest ;
   mf:name    "ex01-patterns.srl" ;
   mf:action  <ex01-patterns.srl> ;
   mf:result  <ex01-patterns.rq> ;
   .

