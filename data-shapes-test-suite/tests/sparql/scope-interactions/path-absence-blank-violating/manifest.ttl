@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .

<>
  a mf:Manifest ;
  mf:entries (
    <path-absence-blank-violating>
  ) ;
.

<path-absence-blank-violating>
  a sht:Validate ;
  mf:name "path-absence-blank-violating" ;
  rdfs:label "Alternative-path absence: blank-node focus, violating control" ;
  mf:requires sht:SPARQLValidation ;
  rdfs:seeAlso <https://www.w3.org/TR/2017/REC-shacl-20170720/#sparql-constraints-variables> ;
  mf:action [
    sht:shapesGraph <shapes.ttl> ;
    sht:dataGraph <> ;
  ] ;
  mf:result [
    a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [
      a sh:ValidationResult ;
      sh:focusNode _:b ;
      sh:resultSeverity sh:Violation ;
      sh:sourceShape ex:Shape ;
      sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
      sh:value _:b ;
      sh:sourceConstraint ex:Constraint ;
    ] ;
    sh:result [
      a sh:ValidationResult ;
      sh:focusNode _:c ;
      sh:resultSeverity sh:Violation ;
      sh:sourceShape ex:Shape ;
      sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
      sh:value _:c ;
      sh:sourceConstraint ex:Constraint ;
    ] ;
  ] ;
  mf:status sht:proposed ;
  rdfs:comment "The Recommendation uses values insertion under SPARQL 1.1. Neither p nor q reaches a value for the missing-property focuses. Only a has p: exactly b and c are results, each also its own value." ;
.

ex:recordA
  ex:focus [
    a ex:C ;
    ex:p ex:v ;
  ] ;
.

ex:recordB
  ex:focus _:b ;
.

_:b
  a ex:C ;
.

ex:recordC
  ex:focus _:c ;
.

_:c
  a ex:C ;
.
