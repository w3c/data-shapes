@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
ex:Shape a sh:NodeShape ; sh:targetClass ex:C ; sh:sparql ex:Constraint .
ex:Constraint a sh:SPARQLConstraint ; sh:select "SELECT $this WHERE { OPTIONAL { $this (<http://example.org/p>|<http://example.org/q>) ?present } FILTER(!BOUND(?present)) }" .
