@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .

<>
  a mf:Manifest ;
  mf:entries (
    <admission-hidden-prebound-subquery-rec>
  ) ;
.

<admission-hidden-prebound-subquery-rec>
  a sht:Validate ;
  mf:name "admission-hidden-prebound-subquery-rec" ;
  rdfs:label "Hidden prebound subquery variable" ;
  mf:requires sht:SPARQLValidation ;
  rdfs:seeAlso <https://www.w3.org/TR/2017/REC-shacl-20170720/#pre-binding> ;
  mf:action [
    sht:shapesGraph <shapes.ttl> ;
    sht:dataGraph <> ;
  ] ;
  mf:result sht:Failure ;
  mf:status sht:proposed ;
  rdfs:comment "The nested SELECT does not project the potentially prebound this variable and must be rejected." ;
.

ex:a
  ex:p ex:v ;
.
