@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
<> a mf:Manifest ; mf:entries ( <http://example.org/community/select-validator-parameter-violating> ) .
<http://example.org/community/select-validator-parameter-violating> a sht:Validate ; mf:name "select-validator-parameter-violating" ; mf:action [ sht:shapesGraph <shapes.ttl> ; sht:dataGraph <> ] ; mf:result _:report ; mf:status sht:proposed ; rdfs:comment "The component parameter required is prebound to ex:p. ASK prebinds value to the node-shape value node and false creates one result; SELECT prebinds this, has no potentially-prebound value variable, and each absent-property row creates one result. Only b,c lack p in the violating control; all three have p in the conforming control. The source component is ex:Component, not sh:SPARQLConstraintComponent." .

ex:recordA ex:focus ex:a .
ex:a a ex:C .
ex:recordB ex:focus ex:b .
ex:b a ex:C .
ex:recordC ex:focus ex:c .
ex:c a ex:C .
ex:a ex:p ex:v .


_:report a sh:ValidationReport ; sh:conforms false .
_:report sh:result _:result0 .
_:result0 a sh:ValidationResult ; sh:focusNode ex:b ; sh:resultSeverity sh:Violation ; sh:sourceShape ex:Shape ; sh:sourceConstraintComponent ex:Component .
_:result0 sh:value ex:b .
_:report sh:result _:result1 .
_:result1 a sh:ValidationResult ; sh:focusNode ex:c ; sh:resultSeverity sh:Violation ; sh:sourceShape ex:Shape ; sh:sourceConstraintComponent ex:Component .
_:result1 sh:value ex:c .
