@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
<> a mf:Manifest ; mf:entries ( <http://example.org/community/complex-sequence-inverse-path> ) .
<http://example.org/community/complex-sequence-inverse-path> a sht:Validate ; mf:name "complex-sequence-inverse-path" ; mf:action [ sht:shapesGraph <shapes.ttl> ; sht:dataGraph <> ] ; mf:result _:report ; mf:status sht:proposed ; rdfs:comment "The sequence ex:p followed by inverse ex:q reaches z from a through m, but reaches no node from b. Exactly b violates minCount 1. The result path must encode this sequence/inverse topology; a blank wildcard, reversed sequence or alternative-path structure cannot satisfy it. MinCount does not require a value." .

ex:a ex:p ex:m .
ex:z ex:q ex:m .
ex:b ex:marker "missing" .

_:report a sh:ValidationReport ; sh:conforms false .
_:report sh:result _:result0 .
_:result0 a sh:ValidationResult ; sh:focusNode ex:b ; sh:resultSeverity sh:Violation ; sh:sourceShape ex:Property ; sh:sourceConstraintComponent sh:MinCountConstraintComponent .
_:result0 sh:resultPath _:path0 .
_:path0 rdf:first ex:p ; rdf:rest _:path1 .
_:path1 rdf:first _:inverse ; rdf:rest rdf:nil .
_:inverse sh:inversePath ex:q .
