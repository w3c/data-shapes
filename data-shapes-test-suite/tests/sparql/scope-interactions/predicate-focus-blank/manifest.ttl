@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
<> a mf:Manifest ; mf:entries ( <http://example.org/community/predicate-focus-blank> ) .
<http://example.org/community/predicate-focus-blank> a sht:Validate ; mf:name "predicate-focus-blank" ; mf:action [ sht:shapesGraph <shapes.ttl> ; sht:dataGraph <> ] ; mf:result _:report ; mf:status sht:proposed ; rdfs:comment "Prebinding this in predicate position matches ex:p exactly. ex:q has no triple. A blank focus is not an RDF predicate and therefore matches no predicate triple; the OPTIONAL retains the current focus and the absence filter selects it." .

ex:s ex:p ex:o .
ex:record ex:focus _:predicate .


_:report a sh:ValidationReport ; sh:conforms false .
_:report sh:result _:result0 .
_:result0 a sh:ValidationResult ; sh:focusNode _:predicate ; sh:resultSeverity sh:Violation ; sh:sourceShape ex:Shape ; sh:sourceConstraintComponent sh:SPARQLConstraintComponent .
_:result0 sh:value _:predicate .
_:result0 sh:sourceConstraint ex:Constraint .
