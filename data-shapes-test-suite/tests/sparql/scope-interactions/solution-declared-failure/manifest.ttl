@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
<> a mf:Manifest ; mf:entries ( <http://example.org/community/solution-declared-failure> ) .
<http://example.org/community/solution-declared-failure> a sht:Validate ; mf:name "solution-declared-failure" ; mf:action [ sht:shapesGraph <shapes.ttl> ; sht:dataGraph <> ] ; mf:result sht:Failure ; mf:status sht:proposed ; rdfs:comment "The SELECT has one solution whose failure binding is true. The SHACL SPARQL validator must report a semantic processor failure; producing a normal nonconformance report, a file error or a runner crash does not satisfy this contract." .

ex:a ex:p ex:v .
