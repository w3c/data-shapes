PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>

PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX srl:     <http://www.w3.org/ns/shacl-rules#>
PREFIX srl-sh:  <http://www.w3.org/ns/shacl-rules-shapes#>
PREFIX owl:     <http://www.w3.org/2002/07/owl#>

<> owl:imports <./rdf-syntax-shapes.ttl> .

## Target to validate all SHACL rule sets in the data graph.
[]  sh:targetClass srl:RuleSet;
    sh:node srl-sh:ruleSetShape .
