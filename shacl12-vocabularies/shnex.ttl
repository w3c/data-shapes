# W3C SHACL Node Expressions Vocabulary

# THIS VERSION IS UNDER DEVELOPMENT BY THE DATA-SHAPES (SHACL 1.2) WG

@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shnex#> .

shnex:
	a owl:Ontology ;
	rdfs:label "W3C SHACL Node Expressions Vocabulary"@en ;
	rdfs:comment "This vocabulary defines Node Expression functions that built into compliant SHACL engines."@en ;
	sh:declare [
		sh:prefix "shnex" ;
		sh:namespace "http://www.w3.org/ns/shnex#"^^xsd:anyURI ;
	] ;
	owl:imports <http://www.w3.org/ns/shacl#> .


shnex:filterShape
	a rdf:Property ;
	rdfs:label "filter shape"@en ;
	rdfs:comment "The shape that all input nodes of the expression need to conform to."@en ;
	rdfs:range sh:Shape ;
	rdfs:isDefinedBy shnex: .

shnex:nodes
	a rdf:Property ;
	rdfs:label "nodes"@en ;
	rdfs:comment "The node expression producing the input nodes of a filter shape expression."@en ;
	rdfs:isDefinedBy shnex: .

shnex:intersection
	a rdf:Property ;
	rdfs:label "intersection"@en ;
	rdfs:comment "A list of node expressions that shall be intersected."@en ;
	rdfs:isDefinedBy shnex: .

shnex:union
	a rdf:Property ;
	rdfs:label "union"@en ;
	rdfs:comment "A list of node expressions that shall be used together."@en ;
	rdfs:isDefinedBy shnex: .
