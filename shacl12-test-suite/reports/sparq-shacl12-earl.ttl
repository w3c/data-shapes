<https://github.com/sparq-org/sparq> a doap:Project, earl:TestSubject, earl:Software ;
  doap:name "sparq 0.1.8 (commit a09f266)" ;
  doap:description "sparq, an RDF store and SPARQL engine in Rust, built from commit a09f266d94d80bde4f7a53e3a047d106d65c375f with the sparq-shacl crate's shacl-af and sparql-rl features on. Run against the w3c/data-shapes shacl12-test-suite at commit 04ecbb4a5b930f4fa9df6c399ac5c98ccec672c9 using crates/sparq-shacl/earl-report.sh. Covers SHACL 1.2 Core, SHACL-SPARQL validation, node expressions, inference rules and SPARQL-RL syntax, well-formedness, stratification and inference. Unsupported entries and fixture/spec disagreements are reported as failures." ;
  doap:release [ doap:name "sparq 0.1.8 (commit a09f266)" ; doap:revision "a09f266d94d80bde4f7a53e3a047d106d65c375f" ] ;
  doap:homepage <https://sparq-org.github.io/sparq/> ;
  doap:repository <https://github.com/sparq-org/sparq> ;
  doap:bug-database <https://github.com/sparq-org/sparq/issues> ;
  doap:license <https://spdx.org/licenses/MIT> ;
  doap:programming-language "Rust" ;
  doap:developer <https://github.com/sparq-org> .

