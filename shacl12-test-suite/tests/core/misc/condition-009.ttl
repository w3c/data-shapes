@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:TestShape
  rdf:type sh:NodeShape ;
  sh:targetNode ex:WithLabel , ex:WithoutLabel ;
  sh:condition ex:WarningCondition ;
  sh:class ex:Person ;
.
ex:WarningCondition
  rdf:type sh:NodeShape ;
  sh:property ex:WarningCondition-label ;
.
ex:WarningCondition-label
  rdf:type sh:PropertyShape ;
  sh:path ex:label ;
  sh:minCount 1 ;
  sh:severity sh:Warning ;
.
ex:WithLabel
  ex:label "With label" ;
.
ex:WithoutLabel
  ex:value 1 ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <condition-009>
    ) ;
.
<condition-009>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:condition 009, where a focus node does not conform to a condition that only produces a warning" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:WithLabel ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:ClassConstraintComponent ;
          sh:sourceShape ex:TestShape ;
          sh:value ex:WithLabel ;
        ] ;
    ] ;
  mf:status sht:proposed ;
.
