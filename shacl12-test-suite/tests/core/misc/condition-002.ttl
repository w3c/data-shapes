@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:PostalCodeShape
  rdf:type sh:PropertyShape ;
  sh:targetClass ex:Address ;
  sh:condition ex:USAddressCondition ;
  sh:path ex:postalCode ;
  sh:minCount 1 ;
  sh:datatype xsd:string ;
.
ex:USAddressCondition
  rdf:type sh:NodeShape ;
  sh:property [
      sh:path ex:country ;
      sh:hasValue "US" ;
    ] ;
.
ex:ValidUSAddress
  rdf:type ex:Address ;
  ex:country "US" ;
  ex:postalCode "12345" ;
.
ex:InvalidUSAddress1
  rdf:type ex:Address ;
  ex:country "US" ;
.
ex:InvalidUSAddress2
  rdf:type ex:Address ;
  ex:country "US" ;
  ex:postalCode 12345 ;
.
ex:OtherAddress
  rdf:type ex:Address ;
  ex:country "DE" ;
  ex:postalCode 12345 ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <condition-002>
    ) ;
.
<condition-002>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:condition 002, at a property shape with its own target, where the condition applies to the focus node" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:InvalidUSAddress1 ;
          sh:resultPath ex:postalCode ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
          sh:sourceShape ex:PostalCodeShape ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:InvalidUSAddress2 ;
          sh:resultPath ex:postalCode ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
          sh:sourceShape ex:PostalCodeShape ;
          sh:value 12345 ;
        ] ;
    ] ;
  mf:status sht:proposed ;
.
