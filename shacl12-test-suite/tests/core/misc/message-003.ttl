@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:TestShape
  rdf:type sh:NodeShape ;
  sh:datatype xsd:integer {| sh:message "Constraint message"@en |} ;
  sh:message "Shape message"@en ;
  sh:minLength 5 ;
  sh:targetNode "Hi" ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <message-003>
    ) ;
.
<message-003>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:message 003, where a message declared via reification takes precedence over the message of the shape" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode "Hi" ;
          sh:resultMessage "Constraint message"@en ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
          sh:sourceShape ex:TestShape ;
          sh:value "Hi" ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode "Hi" ;
          sh:resultMessage "Shape message"@en ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MinLengthConstraintComponent ;
          sh:sourceShape ex:TestShape ;
          sh:value "Hi" ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
