@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:LocalBusinessShape
  rdf:type sh:NodeShape ;
  sh:targetClass ex:LocalBusiness ;
  sh:property ex:LocalBusinessShape-address ;
.
ex:LocalBusinessShape-address
  rdf:type sh:PropertyShape ;
  sh:path ex:address ;
  sh:minCount 1 ;
  sh:node [
      rdf:type sh:NodeShape ;
      sh:property [
          sh:condition [
              sh:property [
                  sh:path ex:country ;
                  sh:hasValue "US" ;
                ] ;
            ] ;
          sh:path ex:postalCode ;
          sh:minCount 1 ;
        ] ;
    ] ;
.
ex:ValidUSBusiness
  rdf:type ex:LocalBusiness ;
  ex:address ex:ValidUSAddress ;
.
ex:ValidUSAddress
  ex:country "US" ;
  ex:postalCode "12345" ;
.
ex:InvalidUSBusiness
  rdf:type ex:LocalBusiness ;
  ex:address ex:InvalidUSAddress ;
.
ex:InvalidUSAddress
  ex:country "US" ;
.
ex:OtherBusiness
  rdf:type ex:LocalBusiness ;
  ex:address ex:OtherAddress ;
.
ex:OtherAddress
  ex:country "DE" ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <condition-004>
    ) ;
.
<condition-004>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:condition 004, at a property shape that is nested via sh:node and sh:property" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:InvalidUSBusiness ;
          sh:resultPath ex:address ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:NodeConstraintComponent ;
          sh:sourceShape ex:LocalBusinessShape-address ;
          sh:value ex:InvalidUSAddress ;
        ] ;
    ] ;
  mf:status sht:proposed ;
.
