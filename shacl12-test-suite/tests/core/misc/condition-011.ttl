@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ClosedShape
  rdf:type sh:NodeShape ;
  sh:targetNode ex:Unflagged , ex:Flagged ;
  sh:closed true ;
  sh:property ex:ClosedShape-flag ;
  sh:property ex:ClosedShape-value ;
.
ex:ClosedShape-flag
  rdf:type sh:PropertyShape ;
  sh:path ex:flag ;
.
ex:ClosedShape-value
  rdf:type sh:PropertyShape ;
  sh:condition [
      sh:property [
          sh:path ex:flag ;
          sh:hasValue true ;
        ] ;
    ] ;
  sh:path ex:value ;
  sh:maxCount 1 ;
.
ex:Unflagged
  ex:flag false ;
  ex:value 1 ;
  ex:value 2 ;
.
ex:Flagged
  ex:flag true ;
  ex:other 3 ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <condition-011>
    ) ;
.
<condition-011>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:condition 011, where sh:closed allows the property of a property shape regardless of its condition" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Flagged ;
          sh:resultPath ex:other ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:ClosedConstraintComponent ;
          sh:sourceShape ex:ClosedShape ;
          sh:value 3 ;
        ] ;
    ] ;
  mf:status sht:proposed ;
.
