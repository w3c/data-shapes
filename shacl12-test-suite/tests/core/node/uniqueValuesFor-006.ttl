@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Record1
  rdf:type ex:Record ;
  ex:id "X" ;
.
ex:Outsider
  rdfs:comment "Not a record, so not a target of ex:RecordShape, but validated against it via sh:node" ;
  ex:id "X" ;
.
ex:RecordShape
  rdf:type sh:NodeShape ;
  sh:targetClass ex:Record ;
  sh:uniqueValuesFor ex:id ;
.
ex:OuterShape
  rdf:type sh:NodeShape ;
  sh:node ex:RecordShape ;
  sh:targetNode ex:Outsider ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <uniqueValuesFor-006>
    ) ;
.
<uniqueValuesFor-006>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:uniqueValuesFor at node shape 006, where the shape is reached via sh:node but its own targets determine the compared nodes" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Outsider ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:NodeConstraintComponent ;
          sh:sourceShape ex:OuterShape ;
          sh:value ex:Outsider ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
