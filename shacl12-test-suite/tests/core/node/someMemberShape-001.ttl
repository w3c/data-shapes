@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:IRIShape a sh:NodeShape ;
  sh:nodeKind sh:IRI .

ex:IRIListShape
  rdf:type sh:NodeShape ;
  sh:someMemberShape ex:IRIShape ;
  # ex:list1 and ex:list2 are valid, the remainder trigger violations
  sh:targetNode ex:list1, ex:list2, ex:list3, rdf:nil, ex:notAList ;
.

# Valid: one member conforms
ex:list1
  rdf:first "Alice" ;
  rdf:rest ( ex:Bob "Charlie" ) .

# Valid: all members conform
ex:list2
  rdf:first ex:Alice ;
  rdf:rest ( ex:Bob ex:Charlie ) .

# Violation: no member conforms
ex:list3
  rdf:first "Alice" ;
  rdf:rest ( "Bob" ) .

# rdf:nil is a violation: the empty list has no members

# Violation: not a SHACL list
ex:notAList rdfs:label "Not a list" .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <someMemberShape-001>
    ) ;
.

<someMemberShape-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:someMemberShape on node shape 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:list3 ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:SomeMemberShapeConstraintComponent ;
          sh:sourceShape ex:IRIListShape ;
          sh:value ex:list3 ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode rdf:nil ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:SomeMemberShapeConstraintComponent ;
          sh:sourceShape ex:IRIListShape ;
          sh:value rdf:nil ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:notAList ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:SomeMemberShapeConstraintComponent ;
          sh:sourceShape ex:IRIListShape ;
          sh:value ex:notAList ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
