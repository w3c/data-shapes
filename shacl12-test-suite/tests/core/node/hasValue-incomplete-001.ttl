@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# At a node shape the value node is the focus node itself, so an incomplete focus node that is
# not the expected value is still reported.
ex:FlaggedNode
  rdfs:label "Flagged node" ;
  sh:incomplete true ;
.
ex:TestShape
  rdf:type sh:NodeShape ;
  rdfs:label "Test shape" ;
  sh:hasValue ex:ExpectedNode ;
  sh:targetNode ex:ExpectedNode ;
  sh:targetNode ex:FlaggedNode ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <hasValue-incomplete-001>
    ) ;
.
<hasValue-incomplete-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:hasValue at node shape with an incomplete focus node 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:FlaggedNode ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
          sh:sourceShape ex:TestShape ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
