@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# At a node shape the value node is the focus node itself; an incomplete one may have its type
# stated elsewhere, so it is not reported.
ex:FlaggedNode
  sh:incomplete true ;
.
ex:Person
  rdf:type rdfs:Class ;
.
ex:TestShape
  rdf:type sh:NodeShape ;
  sh:class ex:Person ;
  sh:targetNode ex:FlaggedNode ;
  sh:targetNode ex:Typeless ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <class-incomplete-001>
    ) ;
.
<class-incomplete-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:class at node shape with an incomplete focus node 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Typeless ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:ClassConstraintComponent ;
          sh:sourceShape ex:TestShape ;
          sh:value ex:Typeless ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
