@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Alice
  ex:knows ex:Bob ;
  ex:name "Alice" ;
.
ex:Bob
  ex:knows ex:Alice ;
.
ex:TestShape
  rdf:type sh:NodeShape ;
  sh:closed true ;
  sh:property ex:TestShape-name ;
  sh:property ex:TestShape-knownBy ;
  sh:targetNode ex:Alice ;
.
ex:TestShape-name
  sh:path ex:name ;
.
ex:TestShape-knownBy
  rdfs:comment "An inverse path is not an IRI property, so ex:knows is not permitted by it" ;
  sh:path [
      sh:inversePath ex:knows ;
    ] ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <closed-005>
    ) ;
.
<closed-005>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:closed at node shape 005, where a property shape with a complex path does not open its predicate" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Alice ;
          sh:resultPath ex:knows ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:ClosedConstraintComponent ;
          sh:sourceShape ex:TestShape ;
          sh:value ex:Bob ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
