@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Animal
  rdf:type rdfs:Class ;
.
ex:Mammal
  rdf:type rdfs:Class ;
  rdfs:subClassOf ex:Animal ;
.
ex:Dog
  rdf:type rdfs:Class ;
  rdfs:subClassOf ex:Mammal ;
.
ex:Plant
  rdf:type rdfs:Class ;
.
ex:Tree
  rdf:type rdfs:Class ;
  rdfs:subClassOf ex:Plant ;
.
ex:Car
  rdf:type rdfs:Class ;
.
ex:TestShape
  rdf:type sh:NodeShape ;
  sh:rootClass ( ex:Animal ex:Plant ) ;
  sh:targetNode ex:Animal ;
  sh:targetNode ex:Dog ;
  sh:targetNode ex:Tree ;
  sh:targetNode ex:Car ;
  sh:targetNode "Dog" ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <rootClass-001>
    ) ;
.
<rootClass-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:rootClass with a list of classes at node shape 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Car ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:RootClassConstraintComponent ;
          sh:sourceShape ex:TestShape ;
          sh:value ex:Car ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode "Dog" ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:RootClassConstraintComponent ;
          sh:sourceShape ex:TestShape ;
          sh:value "Dog" ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
