@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://datashapes.org/sh/tests/core/node/memberShape-001.test#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:IRIListShape
  rdf:type sh:NodeShape ;
  sh:memberShape [ sh:nodeKind sh:IRI ] ;
  sh:targetNode ( ex:Alice ex:Bob ) ;
  sh:targetNode () ;
  sh:targetNode _:b1, _:b2, _:b3, _:b4, _:b5 ;
.

_:b1
  rdf:first ex:Alice ;
  rdf:rest rdf:nil ;
  ex:extraProperty "extra" ;
.

_:b2
  rdf:first ex:Alice ;
  rdf:rest (
    "Bob"
  )
.

_:b4
  rdf:first ex:Alice ;
.

_:b5
  rdf:first "Charlie" ;
  rdf:rest (
    "Donna"
  )
.

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <memberShape-001>
    ) ;
.

<memberShape-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:memberShape on node shape 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode _:b2 ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MemberShapeConstraintComponent ;
          sh:sourceShape ex:IRIListShape ;
          sh:value "Bob" ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode _:b3 ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MemberShapeConstraintComponent ;
          sh:sourceShape ex:IRIListShape ;
          sh:value _:b3 ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode _:b4 ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MemberShapeConstraintComponent ;
          sh:sourceShape ex:IRIListShape ;
          sh:value _:b4 ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode _:b5 ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MemberShapeConstraintComponent ;
          sh:sourceShape ex:IRIListShape ;
          sh:value "Charlie" ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode _:b5 ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MemberShapeConstraintComponent ;
          sh:sourceShape ex:IRIListShape ;
          sh:value "Donna" ;
        ] ;
    ] ;
  mf:status sht:approved ;
. 
