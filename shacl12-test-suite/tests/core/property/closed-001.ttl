@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Alice
  ex:address ex:Address1 ;
.
ex:Address1
  ex:city "Berlin" ;
.
ex:Bob
  ex:address ex:Address2 ;
.
ex:Address2
  ex:city "Paris" ;
  ex:zip "75001" ;
.
ex:TestShape
  rdf:type sh:NodeShape ;
  sh:property ex:TestShape-address ;
  sh:targetNode ex:Alice ;
  sh:targetNode ex:Bob ;
.
ex:TestShape-address
  rdfs:comment "A property shape has no sh:property, so only the ignored properties are allowed at its value nodes" ;
  sh:path ex:address ;
  sh:closed true ;
  sh:ignoredProperties ( ex:city ) ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <closed-001>
    ) ;
.
<closed-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:closed at property shape 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Bob ;
          sh:resultPath ex:zip ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:ClosedConstraintComponent ;
          sh:sourceShape ex:TestShape-address ;
          sh:value "75001" ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
