@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:DataGraphInfo
  sh:incompleteURIStart "http://example.com/ns#Stub"^^xsd:anyURI ;
.
ex:FlaggedPerson
  rdf:type ex:Person ;
  rdfs:label "Flagged person" ;
  sh:incomplete true ;
.
ex:MissingPerson
  rdf:type ex:Person ;
  rdfs:label "Missing person" ;
.
ex:Person
  rdf:type rdfs:Class ;
  rdfs:label "Person" ;
  rdfs:subClassOf rdfs:Resource ;
.
ex:PersonShape
  rdf:type sh:NodeShape ;
  sh:property ex:PersonShape-firstName ;
  sh:targetClass ex:Person ;
.
ex:PersonShape-firstName
  sh:path ex:firstName ;
  sh:minCount 1 ;
.
ex:StubCompletePerson
  rdf:type ex:Person ;
  rdfs:label "Stub complete person" ;
  sh:incomplete false ;
.
ex:StubPerson
  rdf:type ex:Person ;
  rdfs:label "Stub person" ;
.
ex:ValidPerson
  rdf:type ex:Person ;
  ex:firstName "John" ;
  rdfs:label "Valid person" ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <minCount-incomplete-001>
    ) ;
.
<minCount-incomplete-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:minCount with incomplete focus nodes 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:MissingPerson ;
          sh:resultPath ex:firstName ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
          sh:sourceShape ex:PersonShape-firstName ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:StubCompletePerson ;
          sh:resultPath ex:firstName ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
          sh:sourceShape ex:PersonShape-firstName ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
