@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://datashapes.org/sh/tests/core/property/memberShape-004.test#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Agenda
  rdf:type rdfs:Class ;
  rdf:type sh:NodeShape ;
  rdfs:label "Agenda" ;
  sh:property ex:Agenda-speakerOrder ;
.

ex:Agenda-speakerOrder
  sh:path ex:speakerOrder ;
  sh:memberShape [
      sh:nodeKind sh:IRI ;
    ] ;
  sh:maxCount 1 ;
.

ex:Alice
  rdf:type ex:Person ;
  rdfs:label "Alice" ;
.

ex:Person
  rdf:type rdfs:Class ;
  rdf:type sh:NodeShape ;
  rdfs:label "Person" ;
.

# Agenda with multiple invalid list members (blank nodes instead of IRIs)
ex:agenda-multiple-violations
  rdf:type ex:Agenda ;
  ex:speakerOrder (
      ex:Alice
      [ rdfs:label "Bob" ]        # Blank node - violates sh:nodeKind sh:IRI
      "Charlie"                   # Literal - violates sh:nodeKind sh:IRI
      [ rdfs:label "David" ]      # Another blank node - violates sh:nodeKind sh:IRI
    ) ;
  rdfs:label "Agenda with multiple violations" ;
.

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <memberShape-004>
    ) ;
.

<memberShape-004>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:memberShape with multiple member violations 004" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:agenda-multiple-violations ;
          sh:resultPath ex:speakerOrder ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MemberShapeConstraintComponent ;
          sh:sourceShape ex:Agenda-speakerOrder ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:agenda-multiple-violations ;
          sh:resultPath ex:speakerOrder ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MemberShapeConstraintComponent ;
          sh:sourceShape ex:Agenda-speakerOrder ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:agenda-multiple-violations ;
          sh:resultPath ex:speakerOrder ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MemberShapeConstraintComponent ;
          sh:sourceShape ex:Agenda-speakerOrder ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
