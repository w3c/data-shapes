@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Incomplete value nodes are counted as possibly conforming: a result is only produced if the
# conforming and possibly conforming values together are fewer than sh:qualifiedMinCount.
<http://example.com/external/Animal>
  ex:age "old" ;
.
<http://example.com/external/MarkedComplete>
  ex:age "old" ;
  sh:incomplete false ;
.
ex:AgeShape
  rdf:type sh:NodeShape ;
  sh:property [
      sh:path ex:age ;
      sh:datatype xsd:integer ;
    ] ;
.
ex:DataGraphInfo
  sh:incompleteURIStart "http://example.com/external/"^^xsd:anyURI ;
.
ex:FlaggedAnimal
  ex:age "old" ;
  sh:incomplete true ;
.
ex:InvalidAnimal
  ex:age "old" ;
.
ex:ValidAnimal
  ex:age 3 ;
.
ex:ValidAnimal2
  ex:age 5 ;
.
ex:FarmerWithCompleteExternal
  ex:tendsAnimal ex:ValidAnimal ;
  ex:tendsAnimal <http://example.com/external/MarkedComplete> ;
.
ex:FarmerWithExternal
  ex:tendsAnimal ex:ValidAnimal ;
  ex:tendsAnimal <http://example.com/external/Animal> ;
.
ex:FarmerWithFlagged
  ex:tendsAnimal ex:ValidAnimal ;
  ex:tendsAnimal ex:FlaggedAnimal ;
.
ex:FarmerWithInvalid
  ex:tendsAnimal ex:ValidAnimal ;
  ex:tendsAnimal ex:InvalidAnimal ;
.
ex:FarmerWithOnlyFlagged
  ex:tendsAnimal ex:FlaggedAnimal ;
.
ex:FarmerWithValid
  ex:tendsAnimal ex:ValidAnimal ;
  ex:tendsAnimal ex:ValidAnimal2 ;
.
ex:FarmerShape
  rdf:type sh:NodeShape ;
  sh:property ex:FarmerShape-tendsAnimal ;
  sh:targetNode ex:FarmerWithCompleteExternal ;
  sh:targetNode ex:FarmerWithExternal ;
  sh:targetNode ex:FarmerWithFlagged ;
  sh:targetNode ex:FarmerWithInvalid ;
  sh:targetNode ex:FarmerWithOnlyFlagged ;
  sh:targetNode ex:FarmerWithValid ;
.
ex:FarmerShape-tendsAnimal
  sh:path ex:tendsAnimal ;
  sh:qualifiedMinCount 2 ;
  sh:qualifiedValueShape ex:AgeShape ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <qualifiedMinCount-incomplete-002>
    ) ;
.
<qualifiedMinCount-incomplete-002>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:qualifiedMinCount at property shape with incomplete value nodes 002" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:FarmerWithCompleteExternal ;
          sh:resultPath ex:tendsAnimal ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
          sh:sourceShape ex:FarmerShape-tendsAnimal ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:FarmerWithInvalid ;
          sh:resultPath ex:tendsAnimal ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
          sh:sourceShape ex:FarmerShape-tendsAnimal ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:FarmerWithOnlyFlagged ;
          sh:resultPath ex:tendsAnimal ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
          sh:sourceShape ex:FarmerShape-tendsAnimal ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
