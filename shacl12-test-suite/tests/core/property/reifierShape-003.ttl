@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Alice
  ex:age 23 ;
.
ex:Reifier1
  rdf:reifies <<( ex:Alice ex:age 23 )>> ;
  ex:note "No source" ;
.
ex:Reifier2
  rdf:reifies <<( ex:Alice ex:age 23 )>> ;
  ex:source ex:Document ;
.
ex:Reifier3
  rdf:reifies <<( ex:Alice ex:age 23 )>> ;
.
ex:SourceShape
  rdf:type sh:NodeShape ;
  sh:property ex:SourceShape-source ;
.
ex:SourceShape-source
  sh:path ex:source ;
  sh:minCount 1 ;
.
ex:TestShape
  rdf:type sh:NodeShape ;
  sh:property ex:TestShape-age ;
  sh:targetNode ex:Alice ;
.
ex:TestShape-age
  sh:path ex:age ;
  sh:reifierShape ex:SourceShape ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <reifierShape-003>
    ) ;
.
<reifierShape-003>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:reifierShape at property shape 003, with one result per non-conforming reifier of the same triple" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Alice ;
          sh:resultPath ex:age ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:ReifierShapeConstraintComponent ;
          sh:sourceShape ex:TestShape-age ;
          sh:value 23 ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Alice ;
          sh:resultPath ex:age ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:ReifierShapeConstraintComponent ;
          sh:sourceShape ex:TestShape-age ;
          sh:value 23 ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
