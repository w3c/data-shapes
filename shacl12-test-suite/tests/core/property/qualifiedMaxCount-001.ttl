@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Fido
  rdf:type ex:Dog ;
.
ex:Rex
  rdf:type ex:Dog ;
.
ex:Tom
  rdf:type ex:Cat ;
.
ex:Alice
  ex:pet ex:Fido ;
  ex:pet ex:Tom ;
.
ex:Bob
  ex:pet ex:Fido ;
  ex:pet ex:Rex ;
  ex:pet ex:Tom ;
.
ex:TestShape
  rdf:type sh:NodeShape ;
  sh:property ex:TestShape-pet ;
  sh:targetNode ex:Alice ;
  sh:targetNode ex:Bob ;
.
ex:TestShape-pet
  sh:path ex:pet ;
  sh:qualifiedMaxCount 1 ;
  sh:qualifiedValueShape [
      sh:class ex:Dog ;
    ] ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <qualifiedMaxCount-001>
    ) ;
.
<qualifiedMaxCount-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:qualifiedMaxCount without sh:qualifiedMinCount at property shape 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Bob ;
          sh:resultPath ex:pet ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:QualifiedMaxCountConstraintComponent ;
          sh:sourceShape ex:TestShape-pet ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
