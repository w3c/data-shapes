@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Like sh:qualifiedMinCount 1: an incomplete focus node may have its conforming value stated
# elsewhere, so it is not reported.
ex:Alice
  ex:tendsAnimal ex:Eliza ;
.
ex:Bob
  ex:tendsAnimal ex:Donald ;
  ex:tendsAnimal ex:Eliza ;
.
ex:DataGraphInfo
  sh:incompleteURIStart "http://example.com/ns#Stub"^^xsd:anyURI ;
.
ex:Donald
  rdf:type ex:Duck ;
.
ex:DuckFarmerShape
  rdf:type sh:NodeShape ;
  sh:property ex:DuckFarmerShape-tendsAnimal ;
  sh:targetNode ex:Alice ;
  sh:targetNode ex:Bob ;
  sh:targetNode ex:FlaggedFarmer ;
  sh:targetNode ex:StubCompleteFarmer ;
  sh:targetNode ex:StubFarmer ;
.
ex:DuckFarmerShape-tendsAnimal
  sh:path ex:tendsAnimal ;
  sh:someValue [
      sh:class ex:Duck ;
    ] ;
.
ex:Eliza
  rdf:type ex:Cow ;
.
ex:FlaggedFarmer
  ex:tendsAnimal ex:Eliza ;
  sh:incomplete true ;
.
ex:StubCompleteFarmer
  ex:tendsAnimal ex:Eliza ;
  sh:incomplete false ;
.
ex:StubFarmer
  ex:tendsAnimal ex:Eliza ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <someValue-incomplete-001>
    ) ;
.
<someValue-incomplete-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:someValue at property shape with incomplete focus nodes 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Alice ;
          sh:resultPath ex:tendsAnimal ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:SomeValueConstraintComponent ;
          sh:sourceShape ex:DuckFarmerShape-tendsAnimal ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:StubCompleteFarmer ;
          sh:resultPath ex:tendsAnimal ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:SomeValueConstraintComponent ;
          sh:sourceShape ex:DuckFarmerShape-tendsAnimal ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
