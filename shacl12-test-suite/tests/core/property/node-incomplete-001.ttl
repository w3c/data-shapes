@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Values that are incomplete, e.g. links to "external" resources outside of the domain of
# interest, are not reported even though they do not conform to the node shape.
<http://example.com/external/MarkedComplete>
  ex:age "old" ;
  sh:incomplete false ;
.
<http://example.com/external/Someone>
  ex:age "old" ;
.
ex:AgeShape
  rdf:type sh:NodeShape ;
  sh:property [
      sh:path ex:age ;
      sh:datatype xsd:integer ;
    ] ;
.
ex:DataGraphInfo
  sh:incompleteURIStart "http://example.com/external/"^^xsd:anyURI ;
.
ex:FlaggedPerson
  ex:age "old" ;
  sh:incomplete true ;
.
ex:InvalidPerson
  ex:age "old" ;
.
ex:Issue
  ex:assignedTo <http://example.com/external/MarkedComplete> ;
  ex:assignedTo <http://example.com/external/Someone> ;
  ex:assignedTo ex:FlaggedPerson ;
  ex:assignedTo ex:InvalidPerson ;
  ex:assignedTo ex:ValidPerson ;
.
ex:IssueShape
  rdf:type sh:NodeShape ;
  sh:property ex:IssueShape-assignedTo ;
  sh:targetNode ex:Issue ;
.
ex:IssueShape-assignedTo
  sh:path ex:assignedTo ;
  sh:node ex:AgeShape ;
.
ex:ValidPerson
  ex:age 42 ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <node-incomplete-001>
    ) ;
.
<node-incomplete-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:node at property shape with incomplete value nodes 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Issue ;
          sh:resultPath ex:assignedTo ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:NodeConstraintComponent ;
          sh:sourceShape ex:IssueShape-assignedTo ;
          sh:value <http://example.com/external/MarkedComplete> ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Issue ;
          sh:resultPath ex:assignedTo ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:NodeConstraintComponent ;
          sh:sourceShape ex:IssueShape-assignedTo ;
          sh:value ex:InvalidPerson ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
