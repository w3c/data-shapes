@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Like sh:node: values that are incomplete, e.g. links to "external" resources outside of the
# domain of interest, are not validated against the property shapes of sh:property.
<http://example.com/external/MarkedComplete>
  ex:age "old" ;
  sh:incomplete false ;
.
<http://example.com/external/Someone>
  ex:age "old" ;
.
ex:DataGraphInfo
  sh:incompleteURIStart "http://example.com/external/"^^xsd:anyURI ;
.
ex:FlaggedPerson
  ex:age "old" ;
  sh:incomplete true ;
.
ex:InvalidPerson
  ex:age "old" ;
.
ex:Issue
  ex:assignedTo <http://example.com/external/MarkedComplete> ;
  ex:assignedTo <http://example.com/external/Someone> ;
  ex:assignedTo ex:FlaggedPerson ;
  ex:assignedTo ex:InvalidPerson ;
  ex:assignedTo ex:ValidPerson ;
.
ex:IssueShape
  rdf:type sh:NodeShape ;
  sh:property ex:IssueShape-assignedTo ;
  sh:targetNode ex:Issue ;
.
ex:IssueShape-assignedTo
  sh:path ex:assignedTo ;
  sh:property ex:IssueShape-assignedTo-age ;
.
ex:IssueShape-assignedTo-age
  sh:path ex:age ;
  sh:datatype xsd:integer ;
.
ex:ValidPerson
  ex:age 42 ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <property-incomplete-001>
    ) ;
.
<property-incomplete-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:property at property shape with incomplete value nodes 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode <http://example.com/external/MarkedComplete> ;
          sh:resultPath ex:age ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
          sh:sourceShape ex:IssueShape-assignedTo-age ;
          sh:value "old" ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:InvalidPerson ;
          sh:resultPath ex:age ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
          sh:sourceShape ex:IssueShape-assignedTo-age ;
          sh:value "old" ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
