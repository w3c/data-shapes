@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# An incomplete focus node may have the missing values of the other property stated elsewhere.
ex:DataGraphInfo
  sh:incompleteURIStart "http://example.com/ns#Stub"^^xsd:anyURI ;
.
ex:FlaggedResource
  ex:propertyA 3 ;
  sh:incomplete true ;
.
ex:InvalidResource
  ex:propertyA 3 ;
  ex:propertyB 1 ;
.
ex:StubCompleteResource
  ex:propertyA 3 ;
  sh:incomplete false ;
.
ex:StubResource
  ex:propertyA 3 ;
.
ex:TestShape
  rdf:type sh:NodeShape ;
  sh:property ex:TestShape-propertyA ;
  sh:targetNode ex:FlaggedResource ;
  sh:targetNode ex:InvalidResource ;
  sh:targetNode ex:StubCompleteResource ;
  sh:targetNode ex:StubResource ;
  sh:targetNode ex:ValidResource ;
.
ex:TestShape-propertyA
  sh:path ex:propertyA ;
  sh:subsetOf ex:propertyB ;
.
ex:ValidResource
  ex:propertyA 1 ;
  ex:propertyB 1 ;
  ex:propertyB 2 ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <subsetOf-incomplete-001>
    ) ;
.
<subsetOf-incomplete-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:subsetOf at property shape with incomplete focus nodes 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:InvalidResource ;
          sh:resultPath ex:propertyA ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:SubsetOfConstraintComponent ;
          sh:sourceShape ex:TestShape-propertyA ;
          sh:value 3 ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:StubCompleteResource ;
          sh:resultPath ex:propertyA ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:SubsetOfConstraintComponent ;
          sh:sourceShape ex:TestShape-propertyA ;
          sh:value 3 ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
