@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:PotatoDishShape
  rdf:type sh:NodeShape ;
  sh:targetClass ex:PotatoDish ;
  sh:property ex:PotatoDishShape-ingredients ;
.

ex:PotatoDishShape-ingredients
  rdf:type sh:PropertyShape ;
  sh:path ex:ingredients ;
  sh:someMemberShape [
      sh:hasValue ex:Potato ;
    ] ;
.

# Satisfies all constraints
ex:roesti
  rdf:type ex:PotatoDish ;
  ex:ingredients ( ex:Potato ex:Oil ex:Onion ex:Salt ) ;
.

# Satisfies all constraints: multiple conforming members are allowed
ex:doublePotatoes
  rdf:type ex:PotatoDish ;
  ex:ingredients ( ex:Potato ex:Salt ex:Potato ) ;
.

# Violation: no member conforms
ex:fishSticks
  rdf:type ex:PotatoDish ;
  ex:ingredients _:fishSticksIngredients ;
.

_:fishSticksIngredients
  rdf:first ex:Fish ;
  rdf:rest ( ex:Breadcrumbs ex:Flour ex:Egg ex:Oil ex:Salt ) ;
.

# Violation: not a SHACL list
ex:mystery
  rdf:type ex:PotatoDish ;
  ex:ingredients ex:notAList ;
.

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <someMemberShape-001>
    ) ;
.

<someMemberShape-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:someMemberShape on property shape 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:fishSticks ;
          sh:resultPath ex:ingredients ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:SomeMemberShapeConstraintComponent ;
          sh:sourceShape ex:PotatoDishShape-ingredients ;
          sh:value _:fishSticksIngredients ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:mystery ;
          sh:resultPath ex:ingredients ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:SomeMemberShapeConstraintComponent ;
          sh:sourceShape ex:PotatoDishShape-ingredients ;
          sh:value ex:notAList ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
