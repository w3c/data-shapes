@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Like sh:class: values that are incomplete, e.g. links to "external" classes outside of the
# domain of interest, are not reported even though they are not subclasses of the root class.
# Incomplete blank nodes are still reported, because only IRIs can be valid values.
<http://example.com/external/MarkedComplete>
  rdf:type rdfs:Class ;
  sh:incomplete false ;
.
<http://example.com/external/Unicorn>
  rdf:type rdfs:Class ;
.
ex:Animal
  rdf:type rdfs:Class ;
.
ex:Car
  rdf:type rdfs:Class ;
.
ex:DataGraphInfo
  sh:incompleteURIStart "http://example.com/external/"^^xsd:anyURI ;
.
ex:Dog
  rdf:type rdfs:Class ;
  rdfs:subClassOf ex:Animal ;
.
ex:FlaggedClass
  rdf:type rdfs:Class ;
  sh:incomplete true ;
.
ex:TestShape
  rdf:type sh:NodeShape ;
  sh:property ex:TestShape-holds ;
  sh:targetNode ex:Zoo ;
.
ex:TestShape-holds
  rdf:type sh:PropertyShape ;
  sh:path ex:holds ;
  sh:rootClass ex:Animal ;
.
ex:Zoo
  ex:holds <http://example.com/external/MarkedComplete> ;
  ex:holds <http://example.com/external/Unicorn> ;
  ex:holds ex:Car ;
  ex:holds ex:Dog ;
  ex:holds ex:FlaggedClass ;
  ex:holds "A string" ;
  ex:holds _:flaggedBlankClass ;
.
_:flaggedBlankClass
  rdf:type rdfs:Class ;
  sh:incomplete true ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <rootClass-incomplete-001>
    ) ;
.
<rootClass-incomplete-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:rootClass at property shape with incomplete value nodes 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Zoo ;
          sh:resultPath ex:holds ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:RootClassConstraintComponent ;
          sh:sourceShape ex:TestShape-holds ;
          sh:value <http://example.com/external/MarkedComplete> ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Zoo ;
          sh:resultPath ex:holds ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:RootClassConstraintComponent ;
          sh:sourceShape ex:TestShape-holds ;
          sh:value ex:Car ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Zoo ;
          sh:resultPath ex:holds ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:RootClassConstraintComponent ;
          sh:sourceShape ex:TestShape-holds ;
          sh:value "A string" ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Zoo ;
          sh:resultPath ex:holds ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:RootClassConstraintComponent ;
          sh:sourceShape ex:TestShape-holds ;
          sh:value _:flaggedBlankClass ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
