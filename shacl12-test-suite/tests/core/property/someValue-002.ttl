@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Donald
  rdf:type ex:Duck ;
.
ex:Eliza
  rdf:type ex:Cow ;
.
ex:Fred
  rdf:type ex:Cow ;
.
ex:Alice
  ex:tendsAnimal ex:Eliza ;
  ex:tendsAnimal ex:Fred ;
  ex:tendsAnimal ex:Donald ;
.
ex:Bob
  rdfs:comment "Bob tends no animal at all" ;
.
ex:DuckFarmerShape
  rdf:type sh:NodeShape ;
  sh:property ex:DuckFarmerShape-tendsAnimal ;
  sh:targetNode ex:Alice ;
  sh:targetNode ex:Bob ;
.
ex:DuckFarmerShape-tendsAnimal
  sh:path ex:tendsAnimal ;
  sh:someValue [
      sh:class ex:Duck ;
    ] ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <someValue-002>
    ) ;
.
<someValue-002>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:someValue at property shape 002, without value nodes and with one conforming value among many" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Bob ;
          sh:resultPath ex:tendsAnimal ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:SomeValueConstraintComponent ;
          sh:sourceShape ex:DuckFarmerShape-tendsAnimal ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
