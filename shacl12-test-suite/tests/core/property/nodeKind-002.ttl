@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Alice
  ex:age 23 ;
.
ex:Reifier1
  rdf:reifies <<( ex:Alice ex:age 23 )>> ;
  ex:source ex:Document ;
.
ex:Reifier2
  rdf:reifies ex:NotATripleTerm ;
  ex:source ex:Document ;
.
ex:TestShape
  rdf:type sh:NodeShape ;
  sh:property ex:TestShape-reifies ;
  sh:targetNode ex:Reifier1 ;
  sh:targetNode ex:Reifier2 ;
.
ex:TestShape-reifies
  sh:path rdf:reifies ;
  sh:nodeKind sh:TripleTerm ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <nodeKind-002>
    ) ;
.
<nodeKind-002>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:nodeKind sh:TripleTerm at property shape 002" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Reifier2 ;
          sh:resultPath rdf:reifies ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:NodeKindConstraintComponent ;
          sh:sourceShape ex:TestShape-reifies ;
          sh:value ex:NotATripleTerm ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
