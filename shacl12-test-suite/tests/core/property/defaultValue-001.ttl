@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Alice
  ex:age 20 ;
.
ex:Bob
  ex:age 5 ;
.
ex:Carol
  rdfs:comment "Carol has no age, so the default value 0 becomes her only value node" ;
.
ex:TestShape
  rdf:type sh:NodeShape ;
  sh:property ex:TestShape-age ;
  sh:targetNode ex:Alice ;
  sh:targetNode ex:Bob ;
  sh:targetNode ex:Carol ;
.
ex:TestShape-age
  sh:path ex:age ;
  sh:defaultValue 0 ;
  sh:minCount 1 ;
  sh:minInclusive 18 ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <defaultValue-001>
    ) ;
.
<defaultValue-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:defaultValue with a constant literal at property shape 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:Core ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Bob ;
          sh:resultPath ex:age ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
          sh:sourceShape ex:TestShape-age ;
          sh:value 5 ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Carol ;
          sh:resultPath ex:age ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
          sh:sourceShape ex:TestShape-age ;
          sh:value 0 ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
