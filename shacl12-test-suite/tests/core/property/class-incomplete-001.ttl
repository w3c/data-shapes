@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Values that are incomplete, e.g. links to "external" resources outside of the domain of
# interest, are not reported even though they are not instances of the class.
<http://example.com/external/MarkedComplete>
  sh:incomplete false ;
.
ex:Artist
  rdf:type rdfs:Class ;
.
ex:DataGraphInfo
  sh:incompleteURIStart "http://example.com/external/"^^xsd:anyURI ;
.
ex:FlaggedValue
  sh:incomplete true ;
.
ex:Painting
  ex:creator <http://example.com/external/MarkedComplete> ;
  ex:creator <http://example.com/external/Monet> ;
  ex:creator ex:FlaggedValue ;
  ex:creator ex:UntypedValue ;
  ex:creator ex:ValidArtist ;
  ex:creator "A string" ;
.
ex:PaintingShape
  rdf:type sh:NodeShape ;
  sh:property ex:PaintingShape-creator ;
  sh:targetNode ex:Painting ;
.
ex:PaintingShape-creator
  sh:path ex:creator ;
  sh:class ex:Artist ;
.
ex:ValidArtist
  rdf:type ex:Artist ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <class-incomplete-001>
    ) ;
.
<class-incomplete-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:class at property shape with incomplete value nodes 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Painting ;
          sh:resultPath ex:creator ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:ClassConstraintComponent ;
          sh:sourceShape ex:PaintingShape-creator ;
          sh:value <http://example.com/external/MarkedComplete> ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Painting ;
          sh:resultPath ex:creator ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:ClassConstraintComponent ;
          sh:sourceShape ex:PaintingShape-creator ;
          sh:value ex:UntypedValue ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Painting ;
          sh:resultPath ex:creator ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:ClassConstraintComponent ;
          sh:sourceShape ex:PaintingShape-creator ;
          sh:value "A string" ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
