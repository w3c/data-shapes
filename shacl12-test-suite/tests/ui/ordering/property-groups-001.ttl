@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/ns#> .

<> a mf:Manifest ;
    mf:entries ( <property-groups-001> ) .

<property-groups-001> a sht:EvalOrder ;
    rdfs:label "Group order positions groups; member order applies within groups" ;
    rdfs:comment "Two groups interleave with ungrouped properties; member order applies only within each group." ;
    rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-ui/#grouping-and-ordering> ;
    dct:source <https://github.com/w3c/data-shapes/blob/f88488cc6fc3a0a89691aaaade720245b1fadcef/shacl12-ui/index.html> ;
    mf:status sht:proposed ;
    mf:action [
        sht:shapesGraph <> ;
        sht:orderingContext sht:PresentationOrder ;
        sht:nodeShape ex:PersonShape
    ] ;
    mf:result (
        ex:NameShape
        [ sht:group ex:ContactGroup ; sht:members ( ex:PhoneShape ex:EmailShape ) ]
        [ sht:group ex:MeasurementsGroup ; sht:members ( ex:HeightShape ex:WeightShape ) ]
        ex:NotesShape
    ) .

# A group's order positions it; its members' orders apply only within it.
# Negative member orders would move members to the top level if misapplied.
ex:PersonShape a sh:NodeShape ;
    sh:property ex:NotesShape, ex:WeightShape, ex:EmailShape,
        ex:HeightShape, ex:PhoneShape, ex:NameShape .

ex:ContactGroup a sh:PropertyGroup ; sh:order 20 .
ex:MeasurementsGroup a sh:PropertyGroup ; sh:order 30 .

ex:NameShape a sh:PropertyShape ;
    sh:path ex:name ; sh:order 10 .
ex:NotesShape a sh:PropertyShape ;
    sh:path ex:notes ; sh:order 40 .

ex:EmailShape a sh:PropertyShape ;
    sh:path ex:email ; sh:group ex:ContactGroup ; sh:order -10 .
ex:PhoneShape a sh:PropertyShape ;
    sh:path ex:phone ; sh:group ex:ContactGroup ; sh:order -20 .

ex:WeightShape a sh:PropertyShape ;
    sh:path ex:weight ; sh:group ex:MeasurementsGroup ; sh:order 2 .
ex:HeightShape a sh:PropertyShape ;
    sh:path ex:height ; sh:group ex:MeasurementsGroup ; sh:order 1 .
