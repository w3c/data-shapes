@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/ns#> .

<> a mf:Manifest ;
    mf:entries ( <property-shapes-001> ) .

<property-shapes-001> a sht:EvalOrder ;
    rdfs:label "Property shapes follow ascending numeric sh:order" ;
    rdfs:comment "Three ungrouped property shapes have distinct numeric orders." ;
    rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-ui/#grouping-and-ordering> ;
    dct:source <https://github.com/w3c/data-shapes/blob/f88488cc6fc3a0a89691aaaade720245b1fadcef/shacl12-ui/index.html> ;
    mf:status sht:proposed ;
    mf:action [
        sht:shapesGraph <> ;
        sht:orderingContext sht:PresentationOrder ;
        sht:nodeShape ex:PersonShape
    ] ;
    mf:result ( ex:NameShape ex:AgeShape ex:EmailShape ) .

# Orders 2, 10, 30 distinguish numeric from lexical sorting.
# RDF statement order is irrelevant and deliberately reversed.
ex:PersonShape a sh:NodeShape ;
    sh:property ex:EmailShape, ex:AgeShape, ex:NameShape .

ex:EmailShape a sh:PropertyShape ;
    sh:path ex:email ;
    sh:order 30 .

ex:AgeShape a sh:PropertyShape ;
    sh:path ex:age ;
    sh:order 10 .

ex:NameShape a sh:PropertyShape ;
    sh:path ex:name ;
    sh:order 2 .
