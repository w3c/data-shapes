@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .
@prefix ex: <http://example.com/ns#> .

<> a mf:Manifest ;
    mf:entries ( <table-columns-001> ) .

<table-columns-001> a sht:EvalOrder ;
    rdfs:label "ValueTableViewer columns follow the sh:node shape's property order" ;
    rdfs:comment "Columns come from the referenced row shape, not from the table field's position in its parent shape." ;
    rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-ui/#ValueTableViewer> ;
    dct:source <https://github.com/w3c/data-shapes/blob/f88488cc6fc3a0a89691aaaade720245b1fadcef/shacl12-ui/index.html> ;
    mf:status sht:proposed ;
    mf:action [
        sht:shapesGraph <> ;
        sht:orderingContext sht:TableColumnOrder ;
        sht:propertyShape ex:MembersShape
    ] ;
    mf:result ( ex:NameColumn ex:AgeColumn ex:EmailColumn ) .

# Columns belong to the sh:node shape; the containing field is not a column.
# Mixed xsd:integer and xsd:decimal orders are compared numerically.
ex:TeamShape a sh:NodeShape ;
    sh:property ex:MembersShape .

ex:MembersShape a sh:PropertyShape ;
    sh:path ex:member ;
    sh:order -100 ;
    shui:viewer shui:ValueTableViewer ;
    sh:node ex:MemberRowShape .

ex:MemberRowShape a sh:NodeShape ;
    sh:property ex:EmailColumn, ex:AgeColumn, ex:NameColumn .

ex:EmailColumn a sh:PropertyShape ;
    sh:path ex:email ; sh:order 30 .
ex:AgeColumn a sh:PropertyShape ;
    sh:path ex:age ; sh:order "10.5"^^xsd:decimal .
ex:NameColumn a sh:PropertyShape ;
    sh:path ex:name ; sh:order 2 .
