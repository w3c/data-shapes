@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .
@prefix ex: <http://example.com/ns#> .

<> a mf:Manifest ;
    mf:entries ( <property-roles-001> ) .

<property-roles-001> a sht:EvalOrder ;
    rdfs:label "Qualified LabelRole annotations define precedence independently of display order" ;
    rdfs:comment """Qualified candidates follow annotation order and precede the single direct candidate; unrelated roles are excluded.
The Property Roles section states this precedence with SHOULD-level and lowercase 'must' wording; the requirement level is an open question.""" ;
    rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-ui/#property-roles> ;
    dct:source <https://github.com/w3c/data-shapes/blob/f88488cc6fc3a0a89691aaaade720245b1fadcef/shacl12-ui/index.html> ;
    mf:status sht:proposed ;
    mf:action [
        sht:shapesGraph <> ;
        sht:orderingContext sht:RolePrecedence ;
        sht:nodeShape ex:PersonShape ;
        sht:propertyRole shui:LabelRole
    ] ;
    mf:result ( ex:PreferredLabelShape ex:AlternateLabelShape ex:DirectLabelShape ) .

# Annotation orders deliberately oppose the property shapes' display orders.
ex:PersonShape a sh:NodeShape ;
    sh:property ex:DirectLabelShape, ex:AlternateLabelShape,
        ex:PreferredLabelShape, ex:UnrelatedShape .

ex:DirectLabelShape a sh:PropertyShape ;
    sh:path ex:directLabel ;
    sh:order -100 ;
    shui:propertyRole shui:LabelRole .

ex:AlternateLabelShape a sh:PropertyShape ;
    sh:path ex:alternateLabel ;
    sh:order 10 ;
    shui:propertyRole [
        shui:propertyRole shui:LabelRole ; sh:order 2
    ] .

ex:PreferredLabelShape a sh:PropertyShape ;
    sh:path ex:preferredLabel ;
    sh:order 20 ;
    shui:propertyRole [
        shui:propertyRole shui:LabelRole ; sh:order 1
    ] .

ex:OtherRole a shui:PropertyRole .
ex:UnrelatedShape a sh:PropertyShape ;
    sh:path ex:unrelated ;
    sh:order -200 ;
    shui:propertyRole ex:OtherRole .
