@prefix ex: <http://example.org/> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sparql: <http://www.w3.org/ns/sparql#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .

<> a mf:Manifest ;
  mf:entries (
    <coalesce-unused-failure>
    <coalesce-all-fail>
    <if-selected-then-fails>
    <if-selected-else-fails>
    <and-false-failure>
    <and-true-failure>
    <or-true-failure>
    <or-false-failure>
    <and-false-unbound>
    <or-true-unbound>
    <and-failure-false>
    <or-failure-true>
  ) ;
.

<coalesce-unused-failure>
  a sht:EvalNodeExpr ;
  rdfs:label "COALESCE returns its first value despite a later argument failure" ;
  rdfs:comment "A successful first argument wins even when a later argument would fail." ;
  rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-node-expr/#sparql-function-evaluation> ;
  mf:action [
    sht:nodeExpr [ sparql:coalesce ( "ok" [ shnex:instancesOf 42 ] ) ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( "ok" ) ;
  mf:status sht:proposed ;
.

<coalesce-all-fail>
  a sht:EvalNodeExpr ;
  rdfs:label "COALESCE fails when every argument fails" ;
  rdfs:comment "No argument succeeds; COALESCE produces a SPARQL error." ;
  rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-node-expr/#sparql-function-evaluation> ;
  mf:action [
    sht:nodeExpr [ sparql:coalesce ( [ shnex:instancesOf 42 ] [ sparql:abs ( "x" ) ] ) ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result sht:Failure ;
  mf:status sht:proposed ;
.

<if-selected-then-fails>
  a sht:EvalNodeExpr ;
  rdfs:label "IF fails when the selected then branch fails" ;
  rdfs:comment "The selected then branch fails, so IF must report the failure." ;
  rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-node-expr/#sparql-function-evaluation> ;
  mf:action [
    sht:nodeExpr [ sparql:if ( true [ shnex:instancesOf 42 ] "no" ) ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result sht:Failure ;
  mf:status sht:proposed ;
.

<if-selected-else-fails>
  a sht:EvalNodeExpr ;
  rdfs:label "IF fails when the selected else branch fails" ;
  rdfs:comment "The selected else branch fails, so IF must report the failure." ;
  rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-node-expr/#sparql-function-evaluation> ;
  mf:action [
    sht:nodeExpr [ sparql:if ( false "yes" [ shnex:instancesOf 42 ] ) ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result sht:Failure ;
  mf:status sht:proposed ;
.

<and-false-failure>
  a sht:EvalNodeExpr ;
  rdfs:label "False AND an argument error returns false" ;
  rdfs:comment "SPARQL logical-and masks an argument error when the other argument is false." ;
  rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-node-expr/#sparql-function-evaluation> ;
  mf:action [
    sht:nodeExpr [ sparql:logical-and ( false [ shnex:instancesOf 42 ] ) ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( false ) ;
  mf:status sht:proposed ;
.

<and-true-failure>
  a sht:EvalNodeExpr ;
  rdfs:label "True AND an argument error fails" ;
  rdfs:comment "SPARQL logical-and cannot mask an argument error when the other argument is true." ;
  rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-node-expr/#sparql-function-evaluation> ;
  mf:action [
    sht:nodeExpr [ sparql:logical-and ( true [ shnex:instancesOf 42 ] ) ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result sht:Failure ;
  mf:status sht:proposed ;
.

<or-true-failure>
  a sht:EvalNodeExpr ;
  rdfs:label "True OR an argument error returns true" ;
  rdfs:comment "SPARQL logical-or masks an argument error when the other argument is true." ;
  rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-node-expr/#sparql-function-evaluation> ;
  mf:action [
    sht:nodeExpr [ sparql:logical-or ( true [ shnex:instancesOf 42 ] ) ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( true ) ;
  mf:status sht:proposed ;
.

<or-false-failure>
  a sht:EvalNodeExpr ;
  rdfs:label "False OR an argument error fails" ;
  rdfs:comment "SPARQL logical-or cannot mask an argument error when the other argument is false." ;
  rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-node-expr/#sparql-function-evaluation> ;
  mf:action [
    sht:nodeExpr [ sparql:logical-or ( false [ shnex:instancesOf 42 ] ) ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result sht:Failure ;
  mf:status sht:proposed ;
.

<and-false-unbound>
  a sht:EvalNodeExpr ;
  rdfs:label "False AND an unbound argument returns false" ;
  rdfs:comment "SPARQL logical-and returns false when one argument is false and the other is unbound." ;
  rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-node-expr/#sparql-function-evaluation> ;
  mf:action [
    sht:nodeExpr [ sparql:logical-and ( false [ shnex:var "missing" ] ) ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( false ) ;
  mf:status sht:proposed ;
.

<or-true-unbound>
  a sht:EvalNodeExpr ;
  rdfs:label "True OR an unbound argument returns true" ;
  rdfs:comment "SPARQL logical-or with true masks the error from an unbound argument." ;
  rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-node-expr/#sparql-function-evaluation> ;
  mf:action [
    sht:nodeExpr [ sparql:logical-or ( true [ shnex:var "missing" ] ) ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( true ) ;
  mf:status sht:proposed ;
.

<and-failure-false>
  a sht:EvalNodeExpr ;
  rdfs:label "An argument error AND false returns false" ;
  rdfs:comment "SPARQL logical-and masks the left error when the right argument is false." ;
  rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-node-expr/#sparql-function-evaluation> ;
  mf:action [ sht:nodeExpr [ sparql:logical-and ( [ shnex:instancesOf 42 ] false ) ] ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( false ) ;
  mf:status sht:proposed ;
.

<or-failure-true>
  a sht:EvalNodeExpr ;
  rdfs:label "An argument error OR true returns true" ;
  rdfs:comment "SPARQL logical-or masks the left error when the right argument is true." ;
  rdfs:seeAlso <https://w3c.github.io/data-shapes/shacl12-node-expr/#sparql-function-evaluation> ;
  mf:action [ sht:nodeExpr [ sparql:logical-or ( [ shnex:instancesOf 42 ] true ) ] ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( true ) ;
  mf:status sht:proposed ;
.
