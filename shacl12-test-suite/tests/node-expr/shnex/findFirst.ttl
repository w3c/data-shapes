@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <findFirst-empty>
      <findFirst-minInclusive-3>
      <findFirst-none-conform>
      <findFirst-default-focusNode>
      <findFirst-default-focusNode-nonconforming>
    ) ;
.

<findFirst-empty>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a findFirst expression on empty input" ;
  mf:action [
    sht:nodeExpr [
      shnex:findFirst [] ;
      shnex:nodes [] ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result () ;
  mf:status sht:approved ;
.

<findFirst-minInclusive-3>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a findFirst expression on an input list of numbers, using a minInclusive shape" ;
  mf:action [
    sht:nodeExpr [
      shnex:findFirst [
        sh:minInclusive 3 ;
      ] ;
      shnex:nodes ( 2 1 4 3 5 ) ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( 4 ) ;
  mf:status sht:approved ;
.

<findFirst-none-conform>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a findFirst expression where no input node conforms to the shape" ;
  mf:action [
    sht:nodeExpr [
      shnex:findFirst [
        sh:minInclusive 10 ;
      ] ;
      shnex:nodes ( 1 2 3 ) ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result () ;
  mf:status sht:approved ;
.
<findFirst-default-focusNode>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a findFirst expression without shnex:nodes, which defaults to the (conforming) focus node" ;
  mf:action [
    sht:nodeExpr [
      shnex:findFirst [
        sh:nodeKind sh:IRI ;
      ] ;
    ] ;
    sht:focusNode ex:TestNode ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( ex:TestNode ) ;
  mf:status sht:approved ;
.
<findFirst-default-focusNode-nonconforming>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a findFirst expression without shnex:nodes, where the focus node does not conform" ;
  mf:action [
    sht:nodeExpr [
      shnex:findFirst [
        sh:nodeKind sh:Literal ;
      ] ;
    ] ;
    sht:focusNode ex:TestNode ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result () ;
  mf:status sht:approved ;
.
