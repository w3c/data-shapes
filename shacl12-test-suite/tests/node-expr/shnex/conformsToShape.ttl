@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix sparql:  <http://www.w3.org/ns/sparql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <conformsToShape-example-invalid>
      <conformsToShape-example-valid>
      <conformsToShape-empty-input>
    ) ;
.

ex:Shape
  a sh:NodeShape ;
  sh:property [
    sh:path rdfs:label ;
    sh:minCount 1 ;
  ] .

ex:InvalidInstance
  rdfs:comment "Some comment only" .

ex:ValidInstance
  rdfs:label "Some label" .

<conformsToShape-example-invalid>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a shnex:conformsToShape expression returning false" ;
  mf:action [
    sht:nodeExpr [
      shnex:conformsToShape ( ex:InvalidInstance ex:Shape ) ;
    ] ;
  ] ;
  mf:result ( false ) ;
  mf:status sht:approved ;
.
<conformsToShape-example-valid>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a shnex:conformsToShape expression returning true" ;
  mf:action [
    sht:nodeExpr [
      shnex:conformsToShape ( ex:ValidInstance ex:Shape ) ;
    ] ;
  ] ;
  mf:result ( true ) ;
  mf:status sht:approved ;
.
<conformsToShape-empty-input>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of shnex:conformsToShape where the node argument is empty (no focus node bound)" ;
  mf:action [
    sht:nodeExpr [
      shnex:conformsToShape ( [ shnex:var "focusNode" ] ex:Shape ) ;
    ] ;
  ] ;         
  mf:result () ;       
  mf:status sht:approved ;
.