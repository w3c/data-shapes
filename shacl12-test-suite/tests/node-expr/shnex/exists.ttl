@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <exists-constant>
      <exists-empty>
      <exists-multiple>
      <exists-pathValues-true>
      <exists-pathValues-false>
    ) ;
.

<exists-constant>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an exists expression with a constant expression as input" ;
  mf:action [
    sht:nodeExpr [
      shnex:exists ex:SomeNode ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( true ) ;
  mf:status sht:approved ;
.
<exists-empty>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an exists expression with an empty expression as input" ;
  mf:action [
    sht:nodeExpr [
      shnex:exists [] ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( false ) ;
  mf:status sht:approved ;
.

<exists-multiple>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an exists expression with multiple input nodes" ;
  mf:action [
    sht:nodeExpr [
      shnex:exists ( 1 2 ) ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( true ) ;
  mf:status sht:approved ;
.
<exists-pathValues-true>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an exists expression with a path values expression that has values" ;
  mf:action [
    sht:nodeExpr [
      shnex:exists [
        shnex:pathValues rdfs:label ;
      ] ;
    ] ;
    sht:focusNode ex:Labeled ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( true ) ;
  mf:status sht:approved ;
.
<exists-pathValues-false>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an exists expression with a path values expression that has no values" ;
  mf:action [
    sht:nodeExpr [
      shnex:exists [
        shnex:pathValues rdfs:comment ;
      ] ;
    ] ;
    sht:focusNode ex:Labeled ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( false ) ;
  mf:status sht:approved ;
.

ex:Labeled
  rdfs:label "Labeled" ;
.
