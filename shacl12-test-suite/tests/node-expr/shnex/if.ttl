@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <if-then-constant>
      <if-then-else>
      <if-then-no-else>
      <if-then-complex>
      <if-two-trues>
      <if-string-true>
      <if-empty-condition>
      <if-else-only-true>
      <if-lazy-then>
      <if-lazy-else>
    ) ;
.

<if-then-constant>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an if expression with a simple then result" ;
  mf:action [
    sht:nodeExpr [
      shnex:if true ;
      shnex:then 42 ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( 42 ) ;
  mf:status sht:approved ;
.
<if-then-else>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an if expression with a simple else result" ;
  mf:action [
    sht:nodeExpr [
      shnex:if false ;
      shnex:then "yes" ;
      shnex:else "no" ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( "no" ) ;
  mf:status sht:approved ;
.
<if-then-no-else>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an if expression evaluating to false but there is no else" ;
  mf:action [
    sht:nodeExpr [
      shnex:if false ;
      shnex:then "yes" ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result () ;
  mf:status sht:approved ;
.
<if-then-complex>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an if expression with complex expressions in if and then" ;
  mf:action [
    sht:nodeExpr [
      shnex:if [
        shnex:exists [
          shnex:pathValues rdfs:label ;
        ] ;
      ] ;
      shnex:then [
        shnex:pathValues rdfs:seeAlso ;
      ] ;
    ] ;
    sht:focusNode ex:TestNode ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( owl:Nothing ) ;
  mf:status sht:approved ;
.

ex:TestNode
  rdfs:label "test node" ;
  rdfs:seeAlso owl:Nothing ;
.

<if-two-trues>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an if expression where the condition produces ( true true ), which is not exactly ( true )" ;
  mf:action [
    sht:nodeExpr [
      shnex:if ( true true ) ;
      shnex:then "yes" ;
      shnex:else "no" ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( "no" ) ;
  mf:status sht:approved ;
.
<if-string-true>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an if expression where the condition produces the string \"true\" instead of the boolean true" ;
  mf:action [
    sht:nodeExpr [
      shnex:if "true" ;
      shnex:then "yes" ;
      shnex:else "no" ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( "no" ) ;
  mf:status sht:approved ;
.
<if-empty-condition>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an if expression where the condition produces no output nodes" ;
  mf:action [
    sht:nodeExpr [
      shnex:if [] ;
      shnex:then "yes" ;
      shnex:else "no" ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( "no" ) ;
  mf:status sht:approved ;
.
<if-else-only-true>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an if expression evaluating to true but there is no then" ;
  mf:action [
    sht:nodeExpr [
      shnex:if true ;
      shnex:else "no" ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result () ;
  mf:status sht:approved ;
.
<if-lazy-then>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an if expression where the (unused) then branch would produce a failure" ;
  rdfs:comment "The then branch must not be evaluated because the condition is false, so the failure of the path values expression with two focus nodes must not surface." ;
  mf:action [
    sht:nodeExpr [
      shnex:if false ;
      shnex:then [
        shnex:pathValues rdfs:label ;
        shnex:focusNode ( ex:Node1 ex:Node2 ) ;
      ] ;
      shnex:else "ok" ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( "ok" ) ;
  mf:status sht:approved ;
.
<if-lazy-else>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an if expression where the (unused) else branch would produce a failure" ;
  rdfs:comment "The else branch must not be evaluated because the condition is true, so the failure of the path values expression with two focus nodes must not surface." ;
  mf:action [
    sht:nodeExpr [
      shnex:if true ;
      shnex:then "ok" ;
      shnex:else [
        shnex:pathValues rdfs:label ;
        shnex:focusNode ( ex:Node1 ex:Node2 ) ;
      ] ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( "ok" ) ;
  mf:status sht:approved ;
.
