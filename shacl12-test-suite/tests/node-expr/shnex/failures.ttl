@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sparql: <http://www.w3.org/ns/sparql#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Tests of node expressions that must produce an evaluation failure.
# For these, mf:result is sht:Failure instead of a list of output nodes.

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <failure-pathValues-two-focusNodes>
      <failure-instancesOf-literal>
      <failure-instancesOf-mixed>
      <failure-nested-propagates>
      <failure-if-condition>
      <failure-list-parameter-multiple-values>
    ) ;
.
<failure-pathValues-two-focusNodes>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a path values expression where shnex:focusNode produces two nodes, which is a failure" ;
  mf:action [
    sht:nodeExpr [
      shnex:pathValues rdfs:label ;
      shnex:focusNode ( ex:Node1 ex:Node2 ) ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result sht:Failure ;
  mf:status sht:approved ;
.
<failure-instancesOf-literal>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an instancesOf expression where the class is a literal, which is a failure" ;
  mf:action [
    sht:nodeExpr [
      shnex:instancesOf "NotAClass" ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result sht:Failure ;
  mf:status sht:approved ;
.
<failure-instancesOf-mixed>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of an instancesOf expression where one of the classes is a literal, which is a failure" ;
  mf:action [
    sht:nodeExpr [
      shnex:instancesOf ( ex:Class 42 ) ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result sht:Failure ;
  mf:status sht:approved ;
.
<failure-nested-propagates>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test that the failure of a nested expression is propagated by the surrounding count expression" ;
  mf:action [
    sht:nodeExpr [
      shnex:count [
        shnex:instancesOf 42 ;
      ] ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result sht:Failure ;
  mf:status sht:approved ;
.
<failure-if-condition>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test that the failure of the condition of an if expression is propagated" ;
  mf:action [
    sht:nodeExpr [
      shnex:if [
        shnex:instancesOf 42 ;
      ] ;
      shnex:then "yes" ;
      shnex:else "no" ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result sht:Failure ;
  mf:status sht:approved ;
.
<failure-list-parameter-multiple-values>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a list parameter function where an argument produces two nodes, which is a failure" ;
  rdfs:comment "The single argument of sparql:abs is the list expression ( -1 -2 ), which produces more than one output node." ;
  mf:action [
    sht:nodeExpr [
      sparql:abs ( ( -1 -2 ) ) ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result sht:Failure ;
  mf:status sht:approved ;
.
