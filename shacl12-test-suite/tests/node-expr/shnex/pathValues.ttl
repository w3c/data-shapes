@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <pathValues-simple>
      <pathValues-inverse>
      <pathValues-none>
      <pathValues-withFocusNodeConstant>
      <pathValues-withFocusNodeExpression>
      <pathValues-sequence>
      <pathValues-sequence-no-duplicates>
      <pathValues-alternative>
      <pathValues-zeroOrMore>
      <pathValues-oneOrMore>
      <pathValues-zeroOrOne>
      <pathValues-focusNode-empty>
    ) ;
.

ex:TestNode
  rdfs:label "test node" ;
.
ex:OtherNode
  ex:link ex:TestNode ;
.

<pathValues-simple>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a simple path values expression" ;
  mf:action [
    sht:nodeExpr [
      shnex:pathValues rdfs:label ;
    ] ;
    sht:focusNode ex:TestNode ; 
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( "test node" ) ;
  mf:status sht:approved ;
.
<pathValues-inverse>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a path values expression with an sh:inversePath" ;
  mf:action [
    sht:nodeExpr [
      shnex:pathValues [
        sh:inversePath ex:link ;
      ]
    ] ;
    sht:focusNode ex:TestNode ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( ex:OtherNode ) ;
  mf:status sht:approved ;
.
<pathValues-none>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a simple path values expression that returns no values" ;
  mf:action [
    sht:nodeExpr [
      shnex:pathValues ex:unbound ;
    ] ;
    sht:focusNode ex:TestNode ; 
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( ) ;
  mf:status sht:approved ;
.
<pathValues-withFocusNodeConstant>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a simple path values expression with an explicit (constant) shnex:focusNode" ;
  mf:action [
    sht:nodeExpr [
      shnex:pathValues rdfs:label ;
      shnex:focusNode ex:TestNode ; 
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( "test node" ) ;
  mf:status sht:approved ;
.
<pathValues-withFocusNodeExpression>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a simple path values expression with a shnex:focusNode that is an expression by itself" ;
  mf:action [
    sht:nodeExpr [
      shnex:pathValues rdfs:label ;
      shnex:focusNode [
        shnex:pathValues ex:link ;
      ] ; 
    ] ;
    sht:focusNode ex:OtherNode ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( "test node" ) ;
  mf:status sht:approved ;
.

ex:Alice
  ex:child ex:Bob ;
  ex:child ex:Carol ;
  ex:parent ex:Zed ;
.
ex:Bob
  ex:child ex:Dan ;
  ex:name "Bob" ;
.
ex:Carol
  ex:child ex:Dan ;
  ex:name "Carol" ;
.
ex:Dan
  ex:name "Dan" ;
.

<pathValues-sequence>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a path values expression with a sequence path" ;
  mf:action [
    sht:nodeExpr [
      shnex:pathValues ( ex:child ex:name ) ;
    ] ;
    sht:focusNode ex:Alice ;
    sht:ignoreOrder true ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( "Bob" "Carol" ) ;
  mf:status sht:approved ;
.
<pathValues-sequence-no-duplicates>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a path values expression with a sequence path that reaches the same node twice, which is returned only once" ;
  rdfs:comment "The output nodes are the value nodes of the path, which form a set." ;
  mf:action [
    sht:nodeExpr [
      shnex:pathValues ( ex:child ex:child ) ;
    ] ;
    sht:focusNode ex:Alice ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( ex:Dan ) ;
  mf:status sht:approved ;
.
<pathValues-alternative>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a path values expression with an sh:alternativePath" ;
  mf:action [
    sht:nodeExpr [
      shnex:pathValues [
        sh:alternativePath ( ex:child ex:parent ) ;
      ] ;
    ] ;
    sht:focusNode ex:Alice ;
    sht:ignoreOrder true ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( ex:Bob ex:Carol ex:Zed ) ;
  mf:status sht:approved ;
.
<pathValues-zeroOrMore>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a path values expression with an sh:zeroOrMorePath, which includes the focus node itself" ;
  mf:action [
    sht:nodeExpr [
      shnex:pathValues [
        sh:zeroOrMorePath ex:child ;
      ] ;
    ] ;
    sht:focusNode ex:Bob ;
    sht:ignoreOrder true ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( ex:Bob ex:Dan ) ;
  mf:status sht:approved ;
.
<pathValues-oneOrMore>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a path values expression with an sh:oneOrMorePath" ;
  mf:action [
    sht:nodeExpr [
      shnex:pathValues [
        sh:oneOrMorePath ex:child ;
      ] ;
    ] ;
    sht:focusNode ex:Alice ;
    sht:ignoreOrder true ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( ex:Bob ex:Carol ex:Dan ) ;
  mf:status sht:approved ;
.
<pathValues-zeroOrOne>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a path values expression with an sh:zeroOrOnePath" ;
  mf:action [
    sht:nodeExpr [
      shnex:pathValues [
        sh:zeroOrOnePath ex:child ;
      ] ;
    ] ;
    sht:focusNode ex:Bob ;
    sht:ignoreOrder true ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( ex:Bob ex:Dan ) ;
  mf:status sht:approved ;
.
<pathValues-focusNode-empty>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a path values expression with a shnex:focusNode that produces no nodes" ;
  rdfs:comment "The focus node from the evaluation context (ex:Bob) does have a name, but shnex:focusNode takes precedence and produces nothing." ;
  mf:action [
    sht:nodeExpr [
      shnex:pathValues ex:name ;
      shnex:focusNode [] ;
    ] ;
    sht:focusNode ex:Bob ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result () ;
  mf:status sht:approved ;
.
