@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <count-empty>
      <count-list-3>
      <count-duplicates>
      <count-pathValues>
    ) ;
.

<count-empty>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a count expression on an empty list" ;
  mf:action [
    sht:nodeExpr [
      shnex:count [] ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( 0 ) ;
  mf:status sht:approved ;
.

<count-list-3>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a count expression on a list with three members" ;
  mf:action [
    sht:nodeExpr [
      shnex:count ( 4 3 3 ) ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( 3 ) ;
  mf:status sht:approved ;
.

<count-duplicates>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a count expression on a list with three identical members" ;
  mf:action [
    sht:nodeExpr [
      shnex:count ( 1 1 1 ) ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( 3 ) ;
  mf:status sht:approved ;
.
<count-pathValues>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a count expression on a path values expression, similar to the spec example" ;
  rdfs:seeAlso <https://www.w3.org/TR/shacl12-node-expr/#CountExpression> ;
  mf:action [
    sht:nodeExpr [
      shnex:count [
        shnex:pathValues ex:topConcept ;
      ] ;
    ] ;
    sht:focusNode ex:Scheme ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( 2 ) ;
  mf:status sht:approved ;
.

ex:Scheme
  ex:topConcept ex:Concept1 ;
  ex:topConcept ex:Concept2 ;
.
