@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <nodesMatching-base-class>
      <nodesMatching-sub-class>
      <nodesMatching-property-shape>
      <nodesMatching-iri-shape>
    ) ;
.

<nodesMatching-base-class>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a nodesMatching expression for the base class" ;
  mf:action [
    sht:nodeExpr [
      shnex:nodesMatching [
        sh:class ex:Organization ;
      ] ;
    ] ;
    sht:ignoreOrder true ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result (
    ex:Org1
    ex:Company1
    ex:Company2
  ) ;
  mf:status sht:approved ;
.

<nodesMatching-sub-class>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a nodesMatching expression for the sub-class" ;
  mf:action [
    sht:nodeExpr [
      shnex:nodesMatching [
        sh:class ex:Company ;
      ] ;
    ] ;
    sht:ignoreOrder true ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result (
    ex:Company1
    ex:Company2
  ) ;
  mf:status sht:approved ;
.

ex:Company
  rdfs:subClassOf ex:Organization ;
.

ex:Org1 a ex:Organization .
ex:Company1 a ex:Company .
ex:Company2 a ex:Company .
ex:Company3 a ex:Country .  # Just here as a distraction

<nodesMatching-property-shape>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a nodesMatching expression with a property shape, similar to the spec example" ;
  rdfs:seeAlso <https://www.w3.org/TR/shacl12-node-expr/#NodesMatchingExpression> ;
  mf:action [
    sht:nodeExpr [
      shnex:nodesMatching [
        sh:property [
          sh:path ex:employeeCount ;
          sh:minCount 1 ;
        ] ;
      ] ;
    ] ;
    sht:ignoreOrder true ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result (
    ex:Org1
    ex:Company1
  ) ;
  mf:status sht:approved ;
.
<nodesMatching-iri-shape>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a nodesMatching expression with a shape that is an IRI" ;
  mf:action [
    sht:nodeExpr [
      shnex:nodesMatching ex:LargeOrganizationShape ;
    ] ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result (
    ex:Org1
  ) ;
  mf:status sht:approved ;
.

ex:LargeOrganizationShape
  a sh:NodeShape ;
  sh:property [
    sh:path ex:employeeCount ;
    sh:minCount 1 ;
    sh:minInclusive 100 ;
  ] ;
.
ex:Org1 ex:employeeCount 200 .
ex:Company1 ex:employeeCount 10 .
