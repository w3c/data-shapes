@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <list-empty>
      <list-literals>
      <list-iris>
      <list-mixed>
      <list-single>
      <list-duplicates>
    ) ;
.
<list-empty>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a list expression with an empty list which is really the constant rdf:nil" ;
  mf:action [
    sht:nodeExpr () ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( rdf:nil ) ;
  mf:status sht:approved ;
.
<list-literals>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a list expression with 3 literals" ;
  mf:action [
    sht:nodeExpr ( 1 2 3 ) ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( 1 2 3 ) ;
  mf:status sht:approved ;
.

<list-iris>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a list expression with 2 IRIs" ;
  mf:action [
    sht:nodeExpr ( ex:A ex:B ) ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( ex:A ex:B ) ;
  mf:status sht:approved ;
.
<list-mixed>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a list expression mixing IRIs and literals, preserving the order" ;
  mf:action [
    sht:nodeExpr ( "two" ex:A 1 ) ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( "two" ex:A 1 ) ;
  mf:status sht:approved ;
.
<list-single>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a list expression with a single member" ;
  mf:action [
    sht:nodeExpr ( 42 ) ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( 42 ) ;
  mf:status sht:approved ;
.
<list-duplicates>
  rdf:type sht:EvalNodeExpr ;
  rdfs:label "Test of a list expression with duplicate members, which are preserved" ;
  mf:action [
    sht:nodeExpr ( 1 1 2 ) ;
  ] ;
  mf:requires sht:NodeExpr ;
  mf:result ( 1 1 2 ) ;
  mf:status sht:approved ;
.
