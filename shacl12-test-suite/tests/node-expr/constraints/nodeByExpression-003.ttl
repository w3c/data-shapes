@prefix eg: <http://example.org/ns#> .
@prefix eg-measure: <http://example.org/measure#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The Data Cube example from the spec, where the shape is located via a path values expression

eg:ObservationShape
  rdf:type sh:NodeShape ;
  sh:nodeByExpression [
      shnex:pathValues ( qb:dataSet qb:structure eg:hasShape ) ;
    ] ;
  sh:targetClass qb:Observation ;
.
eg:dataset1
  rdf:type qb:DataSet ;
  qb:structure eg:dsd1 ;
.
eg:dsd1
  rdf:type qb:DataStructureDefinition ;
  rdfs:comment "shipments by time (multiple measures approach)"@en ;
  eg:hasShape eg:dsd1-shape ;
  qb:component [
      qb:dimension sdmx-dimension:refTime ;
    ] ;
  qb:component [
      qb:measure eg-measure:quantity ;
    ] ;
  qb:component [
      qb:measure eg-measure:weight ;
    ] ;
.
eg:dsd1-shape
  rdf:type sh:NodeShape ;
  sh:property [
      sh:path sdmx-dimension:refTime ;
      sh:datatype xsd:date ;
      sh:maxCount 1 ;
      sh:minCount 1 ;
    ] ;
  sh:property [
      sh:path eg-measure:quantity ;
      sh:datatype xsd:integer ;
      sh:maxCount 1 ;
      sh:minCount 1 ;
      sh:minInclusive 0 ;
    ] ;
  sh:property [
      sh:path eg-measure:weight ;
      sh:datatype xsd:decimal ;
      sh:maxCount 1 ;
      sh:minCount 1 ;
      sh:minInclusive 0.0 ;
    ] ;
.
eg:obs1a
  rdf:type qb:Observation ;
  eg-measure:quantity 42 ;
  eg-measure:weight 1.3 ;
  qb:dataSet eg:dataset1 ;
  sdmx-dimension:refTime "2010-07-30"^^xsd:date ;
.
eg:obs1b
  rdf:type qb:Observation ;
  eg-measure:weight 1.4 ;
  qb:dataSet eg:dataset1 ;
  sdmx-dimension:refTime "2010-07-31T12:00:00"^^xsd:dateTime ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <nodeByExpression-003>
    ) ;
.
<nodeByExpression-003>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:nodeByExpression with a shape located via a path values expression, from the spec example" ;
  rdfs:seeAlso <https://www.w3.org/TR/shacl12-node-expr/#NodeByExpressionConstraintComponent> ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:NodeExpr ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode eg:obs1b ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraint eg:dsd1-shape ;
          sh:sourceConstraintComponent sh:NodeByExpressionConstraintComponent ;
          sh:sourceShape eg:ObservationShape ;
          sh:value eg:obs1b ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
