@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Instance1
  rdf:type ex:TestClass ;
.
ex:TestClass
  rdf:type rdfs:Class ;
  rdf:type sh:NodeShape ;
  rdfs:label "Test class" ;
  sh:nodeByExpression [
      shnex:pathValues ex:shape ;
    ] ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <nodeByExpression-005>
    ) ;
.
<nodeByExpression-005>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:nodeByExpression with an expression producing no shapes, so that every value node conforms" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:NodeExpr ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "true"^^xsd:boolean ;
    ] ;
  mf:status sht:approved ;
.
