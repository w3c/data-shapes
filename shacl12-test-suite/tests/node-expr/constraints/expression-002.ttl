@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Invalid
  rdf:type ex:Thing ;
  ex:allowed "a" ;
  ex:value "b" ;
.
ex:Thing
  rdf:type rdfs:Class ;
  rdf:type sh:NodeShape ;
  rdfs:label "Thing" ;
  sh:property ex:Thing-value ;
.
ex:Thing-value
  rdf:type sh:PropertyShape ;
  sh:path ex:value ;
  sh:expression [
      shnex:exists [
          shnex:intersection (
              [ shnex:var "value" ]
              [ shnex:pathValues ex:allowed ]
            ) ;
        ] ;
    ] ;
.
ex:Valid
  rdf:type ex:Thing ;
  ex:allowed "a" ;
  ex:allowed "b" ;
  ex:value "a" ;
  ex:value "b" ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <expression-002>
    ) ;
.
<expression-002>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:expression at property shape 002, using the value and focus node from the scope" ;
  rdfs:comment "Each value must be among the values of ex:allowed at the focus node." ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:NodeExpr ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Invalid ;
          sh:resultPath ex:value ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraint [
              shnex:exists [
                  shnex:intersection (
                      [ shnex:var "value" ]
                      [ shnex:pathValues ex:allowed ]
                    ) ;
                ] ;
            ] ;
          sh:sourceConstraintComponent sh:ExpressionConstraintComponent ;
          sh:sourceShape ex:Thing-value ;
          sh:value "b" ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
