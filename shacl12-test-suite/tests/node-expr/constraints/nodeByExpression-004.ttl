@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:HasCommentShape
  rdf:type sh:NodeShape ;
  sh:property [
      sh:path rdfs:comment ;
      sh:minCount 1 ;
    ] ;
.
ex:HasLabelShape
  rdf:type sh:NodeShape ;
  sh:property [
      sh:path rdfs:label ;
      sh:minCount 1 ;
    ] ;
.
ex:Instance1
  rdf:type ex:TestClass ;
.
ex:Instance2
  rdf:type ex:TestClass ;
  rdfs:label "Instance 2" ;
.
ex:Instance3
  rdf:type ex:TestClass ;
  rdfs:comment "Instance 3" ;
  rdfs:label "Instance 3" ;
.
ex:TestClass
  rdf:type rdfs:Class ;
  rdf:type sh:NodeShape ;
  rdfs:label "Test class" ;
  sh:nodeByExpression ( ex:HasLabelShape ex:HasCommentShape ) ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <nodeByExpression-004>
    ) ;
.
<nodeByExpression-004>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:nodeByExpression with an expression producing two shapes, with one result per non-conforming shape" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:NodeExpr ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Instance1 ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraint ex:HasCommentShape ;
          sh:sourceConstraintComponent sh:NodeByExpressionConstraintComponent ;
          sh:sourceShape ex:TestClass ;
          sh:value ex:Instance1 ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Instance1 ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraint ex:HasLabelShape ;
          sh:sourceConstraintComponent sh:NodeByExpressionConstraintComponent ;
          sh:sourceShape ex:TestClass ;
          sh:value ex:Instance1 ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Instance2 ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraint ex:HasCommentShape ;
          sh:sourceConstraintComponent sh:NodeByExpressionConstraintComponent ;
          sh:sourceShape ex:TestClass ;
          sh:value ex:Instance2 ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
