@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
<> a mf:Manifest ; mf:entries ( <http://example.org/community/not-exists-iri-conforming> ) .
<http://example.org/community/not-exists-iri-conforming> a sht:Validate ; mf:name "not-exists-iri-conforming" ; mf:action [ sht:shapesGraph <shapes.ttl> ; sht:dataGraph <> ] ; mf:result _:report ; mf:status sht:proposed ; rdfs:comment "Values insertion joins the current focus at every matched basic graph/path leaf before not-exists evaluates. Only a has p in the violating data; b and c each produce one absent-value solution. The conforming control gives all three focuses p, so none is selected. Explicit recordA/B/C anchors independently identify the three iri focuses; blank names are local graph identities, not interchangeable wildcards. Every SELECT solution yields one SPARQL constraint result with its current focus/value, named source constraint and source shape." .

ex:recordA ex:focus ex:a .
ex:a a ex:C .
ex:recordB ex:focus ex:b .
ex:b a ex:C .
ex:recordC ex:focus ex:c .
ex:c a ex:C .
ex:a ex:p ex:v .
ex:b ex:p ex:v .
ex:c ex:p ex:v .


_:report a sh:ValidationReport ; sh:conforms true .
