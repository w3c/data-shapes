@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .

<>
  a mf:Manifest ;
  mf:entries (
    <nested-not-exists-iri-conforming>
  ) ;
.

<nested-not-exists-iri-conforming>
  a sht:Validate ;
  mf:name "nested-not-exists-iri-conforming" ;
  rdfs:label "Nested NOT EXISTS: IRI focus, conforming control" ;
  mf:requires sht:SPARQLValidation ;
  rdfs:seeAlso <https://www.w3.org/TR/2026/WD-shacl12-sparql-20260918/#sparql-constraints-variables> ;
  mf:action [
    sht:shapesGraph <shapes.ttl> ;
    sht:dataGraph <> ;
  ] ;
  mf:result [
    a sh:ValidationReport ;
    sh:conforms true ;
  ] ;
  mf:status sht:proposed ;
  rdfs:comment "The dated draft uses values insertion. The inner bound-value filter removes the absent-property row before NOT EXISTS. All three focuses have p: no result." ;
.

ex:recordA
  ex:focus ex:a ;
.

ex:a
  a ex:C ;
  ex:p ex:v ;
.

ex:recordB
  ex:focus ex:b ;
.

ex:b
  a ex:C ;
  ex:p ex:v ;
.

ex:recordC
  ex:focus ex:c ;
.

ex:c
  a ex:C ;
  ex:p ex:v ;
.
