@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .

<>
  a mf:Manifest ;
  mf:entries (
    <select-validator-parameter-violating>
  ) ;
.

<select-validator-parameter-violating>
  a sht:Validate ;
  mf:name "select-validator-parameter-violating" ;
  rdfs:label "SELECT validator parameter: violating" ;
  mf:requires sht:SPARQLValidation ;
  rdfs:seeAlso <https://www.w3.org/TR/2026/WD-shacl12-sparql-20260918/#sparql-constraints-variables> ;
  mf:action [
    sht:shapesGraph <shapes.ttl> ;
    sht:dataGraph <> ;
  ] ;
  mf:result [
    a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [
      a sh:ValidationResult ;
      sh:focusNode ex:b ;
      sh:resultSeverity sh:Violation ;
      sh:sourceShape ex:Shape ;
      sh:sourceConstraintComponent ex:Component ;
      sh:value ex:b ;
    ] ;
    sh:result [
      a sh:ValidationResult ;
      sh:focusNode ex:c ;
      sh:resultSeverity sh:Violation ;
      sh:sourceShape ex:Shape ;
      sh:sourceConstraintComponent ex:Component ;
      sh:value ex:c ;
    ] ;
  ] ;
  mf:status sht:proposed ;
  rdfs:comment "The required parameter is p and this is the current node. An absent-property row creates a result. Only a has p: exactly b and c are results." ;
.

ex:recordA
  ex:focus ex:a ;
.

ex:a
  a ex:C ;
  ex:p ex:v ;
.

ex:recordB
  ex:focus ex:b ;
.

ex:b
  a ex:C ;
.

ex:recordC
  ex:focus ex:c ;
.

ex:c
  a ex:C ;
.
