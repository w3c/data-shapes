@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
<> a mf:Manifest ; mf:entries ( <http://example.org/community/admission-hidden-prebound-subquery-draft> ) .
<http://example.org/community/admission-hidden-prebound-subquery-draft> a sht:Validate ; mf:name "admission-hidden-prebound-subquery-draft" ; mf:action [ sht:shapesGraph <shapes.ttl> ; sht:dataGraph <> ] ; mf:result _:report ; mf:status sht:proposed ; rdfs:comment "The Recommendation forbids every explicit VALUES and requires nested projections to return potentially-prebound variables except its two optional context variables. The dated draft forbids only VALUES mentioning potentially-prebound variables and removes that projection rule. Both forbid MINUS and AS assigning this. The draft SERVICE refusal is PurRDF implementation policy under the draft SHOULD/MUST refusal rule; it is not a universal draft prohibition." .

ex:a ex:p ex:v .


_:report a sh:ValidationReport ; sh:conforms false .
_:report sh:result _:result0 .
_:result0 a sh:ValidationResult ; sh:focusNode ex:a ; sh:resultSeverity sh:Violation ; sh:sourceShape ex:Shape ; sh:sourceConstraintComponent sh:SPARQLConstraintComponent .
_:result0 sh:value ex:a .
_:result0 sh:sourceConstraint ex:Constraint .
