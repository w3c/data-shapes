@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
<> a mf:Manifest ; mf:entries ( <http://example.org/community/quoted-focus-optional> ) .
<http://example.org/community/quoted-focus-optional> a sht:Validate ; mf:name "quoted-focus-optional" ; mf:action [ sht:shapesGraph <shapes.ttl> ; sht:dataGraph <> ] ; mf:result _:report ; mf:status sht:proposed ; rdfs:comment "Both targets are distinct RDF 1.2 triple terms. The matched about object must equal the complete focus triple term before the OPTIONAL runs. Only recordGood has p; the expected sole result carries the bad triple term exactly as focus and value." .

ex:root ex:focus <<( ex:s ex:r ex:good )>>, <<( ex:s ex:r ex:bad )>> .
ex:recordGood ex:about <<( ex:s ex:r ex:good )>> ; ex:p ex:v .
ex:recordBad ex:about <<( ex:s ex:r ex:bad )>> .

_:report a sh:ValidationReport ; sh:conforms false .
_:report sh:result _:result0 .
_:result0 a sh:ValidationResult ; sh:focusNode <<( ex:s ex:r ex:bad )>> ; sh:resultSeverity sh:Violation ; sh:sourceShape ex:Shape ; sh:sourceConstraintComponent sh:SPARQLConstraintComponent .
_:result0 sh:value <<( ex:s ex:r ex:bad )>> .
_:result0 sh:sourceConstraint ex:Constraint .
