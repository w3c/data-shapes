@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .

<>
  a mf:Manifest ;
  mf:entries (
    <quoted-focus-optional>
  ) ;
.

<quoted-focus-optional>
  a sht:Validate ;
  mf:name "quoted-focus-optional" ;
  rdfs:label "Triple-term focus under OPTIONAL" ;
  mf:requires sht:SPARQLValidation ;
  rdfs:seeAlso <https://www.w3.org/TR/2026/WD-shacl12-sparql-20260918/#sparql-constraints-variables> ;
  mf:action [
    sht:shapesGraph <shapes.ttl> ;
    sht:dataGraph <> ;
  ] ;
  mf:result [
    a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [
      a sh:ValidationResult ;
      sh:focusNode <<( ex:s ex:r ex:bad )>> ;
      sh:resultSeverity sh:Violation ;
      sh:sourceShape ex:Shape ;
      sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
      sh:value <<( ex:s ex:r ex:bad )>> ;
      sh:sourceConstraint ex:Constraint ;
    ] ;
  ] ;
  mf:status sht:approved ;
  rdfs:comment "Two distinct triple terms are targets. Only recordGood has p; the bad triple term is the sole focus/value result." ;
.

ex:root
  ex:focus <<( ex:s ex:r ex:good )>> ;
  ex:focus <<( ex:s ex:r ex:bad )>> ;
.

ex:recordGood
  ex:about <<( ex:s ex:r ex:good )>> ;
  ex:p ex:v ;
.

ex:recordBad
  ex:about <<( ex:s ex:r ex:bad )>> ;
.
