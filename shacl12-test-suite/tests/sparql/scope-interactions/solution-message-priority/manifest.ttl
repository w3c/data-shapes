@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
<> a mf:Manifest ; mf:entries ( <http://example.org/community/solution-message-priority> ) .
<http://example.org/community/solution-message-priority> a sht:Validate ; mf:name "solution-message-priority" ; mf:action [ sht:shapesGraph <shapes.ttl> ; sht:dataGraph <> ] ; mf:result _:report ; mf:status sht:proposed ; rdfs:comment "The single solution binds message to \"row message\". The ordered SPARQL report mapping chooses this binding before the constraint declaration. The expected result therefore requires row message and does not require the lower-priority declared message." .

ex:a ex:p ex:v .

_:report a sh:ValidationReport ; sh:conforms false .
_:report sh:result _:result0 .
_:result0 a sh:ValidationResult ; sh:focusNode ex:a ; sh:resultSeverity sh:Violation ; sh:sourceShape ex:Shape ; sh:sourceConstraintComponent sh:SPARQLConstraintComponent .
_:result0 sh:value ex:a .
_:result0 sh:sourceConstraint ex:Constraint .
_:result0 sh:resultMessage "row message" .
