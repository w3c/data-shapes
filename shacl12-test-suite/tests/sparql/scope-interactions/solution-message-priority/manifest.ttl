@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .

<>
  a mf:Manifest ;
  mf:entries (
    <http://example.org/community/solution-message-priority>
  ) ;
.

<http://example.org/community/solution-message-priority>
  a sht:Validate ;
  mf:name "solution-message-priority" ;
  mf:action [
    sht:shapesGraph <shapes.ttl> ;
    sht:dataGraph <> ;
  ] ;
  mf:result [
    a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [
      a sh:ValidationResult ;
      sh:focusNode ex:a ;
      sh:resultSeverity sh:Violation ;
      sh:sourceShape ex:Shape ;
      sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
      sh:value ex:a ;
      sh:sourceConstraint ex:Constraint ;
      sh:resultMessage "row message" ;
    ] ;
  ] ;
  mf:status sht:proposed ;
  rdfs:comment "The single solution binds message to \"row message\". The ordered SPARQL report mapping chooses this binding before the constraint declaration. The expected result therefore requires row message and does not require the lower-priority declared message." ;
.

ex:a
  ex:p ex:v ;
.
