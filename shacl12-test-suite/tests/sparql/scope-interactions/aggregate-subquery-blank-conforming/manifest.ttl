@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .

<>
  a mf:Manifest ;
  mf:entries (
    <aggregate-subquery-blank-conforming>
  ) ;
.

<aggregate-subquery-blank-conforming>
  a sht:Validate ;
  mf:name "aggregate-subquery-blank-conforming" ;
  rdfs:label "Aggregate subquery: blank-node focus, conforming control" ;
  mf:requires sht:SPARQLValidation ;
  rdfs:seeAlso <https://www.w3.org/TR/2026/WD-shacl12-sparql-20260918/#sparql-constraints-variables> ;
  mf:action [
    sht:shapesGraph <shapes.ttl> ;
    sht:dataGraph <> ;
  ] ;
  mf:result [
    a sh:ValidationReport ;
    sh:conforms true ;
  ] ;
  mf:status sht:proposed ;
  rdfs:comment "The dated draft uses values insertion. Prebinding restricts the group before SAMPLE, HAVING, ORDER BY and LIMIT. All three focuses have p: no result." ;
.

ex:recordA
  ex:focus [
    a ex:C ;
    ex:p ex:v ;
  ] ;
.

ex:recordB
  ex:focus [
    a ex:C ;
    ex:p ex:v ;
  ] ;
.

ex:recordC
  ex:focus [
    a ex:C ;
    ex:p ex:v ;
  ] ;
.
