@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
<> a mf:Manifest ; mf:entries ( <http://example.org/community/select-validator-parameter-conforming> ) .
<http://example.org/community/select-validator-parameter-conforming> a sht:Validate ; mf:name "select-validator-parameter-conforming" ; mf:action [ sht:shapesGraph <shapes.ttl> ; sht:dataGraph <> ] ; mf:result _:report ; mf:status sht:proposed ; rdfs:comment "The component parameter required is prebound to ex:p. ASK prebinds value to the node-shape value node and false creates one result; SELECT prebinds this, has no potentially-prebound value variable, and each absent-property row creates one result. Only b,c lack p in the violating control; all three have p in the conforming control. The source component is ex:Component, not sh:SPARQLConstraintComponent." .

ex:recordA ex:focus ex:a .
ex:a a ex:C .
ex:recordB ex:focus ex:b .
ex:b a ex:C .
ex:recordC ex:focus ex:c .
ex:c a ex:C .
ex:a ex:p ex:v .
ex:b ex:p ex:v .
ex:c ex:p ex:v .


_:report a sh:ValidationReport ; sh:conforms true .
