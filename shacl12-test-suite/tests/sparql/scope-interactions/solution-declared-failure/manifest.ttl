@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .

<>
  a mf:Manifest ;
  mf:entries (
    <solution-declared-failure>
  ) ;
.

<solution-declared-failure>
  a sht:Validate ;
  mf:name "solution-declared-failure" ;
  rdfs:label "Solution-declared failure" ;
  mf:requires sht:SPARQLValidation ;
  rdfs:seeAlso <https://www.w3.org/TR/2026/WD-shacl12-sparql-20260918/#sparql-constraints-variables> ;
  mf:action [
    sht:shapesGraph <shapes.ttl> ;
    sht:dataGraph <> ;
  ] ;
  mf:result sht:Failure ;
  mf:status sht:approved ;
  rdfs:comment "The solution binds failure to true: a semantic failure is required, not an ordinary violation report." ;
.

ex:a
  ex:p ex:v ;
.
