@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .

<>
  a mf:Manifest ;
  mf:entries (
    <predicate-focus-iri>
  ) ;
.

<predicate-focus-iri>
  a sht:Validate ;
  mf:name "predicate-focus-iri" ;
  rdfs:label "Prebound IRI in predicate position" ;
  mf:requires sht:SPARQLValidation ;
  rdfs:seeAlso <https://www.w3.org/TR/2026/WD-shacl12-sparql-20260918/#sparql-constraints-variables> ;
  mf:action [
    sht:shapesGraph <shapes.ttl> ;
    sht:dataGraph <> ;
  ] ;
  mf:result [
    a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [
      a sh:ValidationResult ;
      sh:focusNode ex:q ;
      sh:resultSeverity sh:Violation ;
      sh:sourceShape ex:Shape ;
      sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
      sh:value ex:q ;
      sh:sourceConstraint ex:Constraint ;
    ] ;
  ] ;
  mf:status sht:proposed ;
  rdfs:comment "p occurs as a predicate and q does not: q is the only focus/value result." ;
.

ex:s
  ex:p ex:o ;
.
