@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .

<>
  a mf:Manifest ;
  mf:entries (
    <complex-sequence-inverse-path>
  ) ;
.

<complex-sequence-inverse-path>
  a sht:Validate ;
  mf:name "complex-sequence-inverse-path" ;
  rdfs:label "Sequence and inverse result path" ;
  mf:requires sht:Core ;
  rdfs:seeAlso <https://www.w3.org/TR/2026/WD-shacl12-core-20260918/#property-paths> ;
  mf:action [
    sht:shapesGraph <shapes.ttl> ;
    sht:dataGraph <> ;
  ] ;
  mf:result [
    a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [
      a sh:ValidationResult ;
      sh:focusNode ex:b ;
      sh:resultSeverity sh:Violation ;
      sh:sourceShape ex:Property ;
      sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
      sh:resultPath (
        ex:p
        [
          sh:inversePath ex:q ;
        ]
      ) ;
    ] ;
  ] ;
  mf:status sht:proposed ;
  rdfs:comment "The path p followed by inverse q reaches z from a, but nothing from b. Exactly b violates minCount; no value is required." ;
.

ex:a
  ex:p ex:m ;
.

ex:z
  ex:q ex:m ;
.

ex:b
  ex:marker "missing" ;
.
