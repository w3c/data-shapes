@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:
  sh:declare [
      sh:namespace "http://example.com/ns#"^^xsd:anyURI ;
      sh:prefix "ex" ;
    ] ;
.
ex:InvalidResource
  ex:property "forbidden" ;
.
ex:TestShape
  rdf:type sh:NodeShape ;
  rdfs:label "Test shape" ;
  sh:sparql ex:TestShape-sparql ;
  sh:targetNode ex:InvalidResource ;
  sh:targetNode ex:ValidResource1 ;
.
ex:TestShape-sparql
  sh:prefixes ex: ;
  sh:select """
		SELECT $this ?value
		WHERE {
			VALUES ?value { "forbidden" }
			$this ex:property ?value .
		}""" ;
.
ex:ValidResource1
  ex:property "fine" ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <pre-binding-009>
    ) ;
.
<pre-binding-009>
  rdf:type sht:Validate ;
  rdfs:label "Test of VALUES on a variable that is not pre-bound, which is permitted" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:SPARQLValidation ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:InvalidResource ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraint ex:TestShape-sparql ;
          sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
          sh:sourceShape ex:TestShape ;
          sh:value "forbidden" ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
