@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:singleInstanceOf
  rdf:type sh:ListParameterExpressionFunction ;
  rdfs:label "single instance of"@en ;
  rdfs:subClassOf sh:ListParameterExpression ;
  sh:bodyExpression [
      sh:select """
		SELECT ?result
		WHERE {
			?result a $arg0 .
		}""" ;
    ] ;
  sh:parameter [
      rdf:type sh:Parameter ;
      sh:path shnex:arg0 ;
      sh:name "class" ;
      sh:description "The class whose only instance is returned." ;
      sh:nodeKind sh:IRI ;
    ] ;
.
ex:OnlyInstance
  rdf:type ex:One ;
.
ex:FirstInstance
  rdf:type ex:Two ;
.
ex:SecondInstance
  rdf:type ex:Two ;
.
ex:TestShape
  rdf:type sh:NodeShape ;
  sh:sparql ex:TestShape-sparql ;
  sh:targetNode ex:TestResource ;
.
ex:TestShape-sparql
  sh:select """
		PREFIX ex: <http://example.com/ns#>
		SELECT $this ?value
		WHERE {
			BIND (ex:singleInstanceOf(ex:One) AS ?one) .
			BIND (ex:singleInstanceOf(ex:Two) AS ?two) .
			BIND (ex:singleInstanceOf(ex:None) AS ?none) .
			BIND (CONCAT(str(?one), ' ', str(bound(?two)), ' ', str(bound(?none))) AS ?value) .
		}""" ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <singleInstanceOf-001>
    ) ;
.
<singleInstanceOf-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of a custom SPARQL function that is an error unless its body produces exactly one output node" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:SPARQLCustomFunctions ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:TestResource ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraint ex:TestShape-sparql ;
          sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
          sh:sourceShape ex:TestShape ;
          sh:value "http://example.com/ns#OnlyInstance false false" ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
