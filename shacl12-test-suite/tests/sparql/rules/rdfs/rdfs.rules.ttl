@prefix ex: <http://example.com/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ;
      sh:prefix "rdf" ;
  ] ;
  sh:declare [
      sh:namespace "http://www.w3.org/2000/01/rdf-schema#" ;
      sh:prefix "rdfs" ;
  ] ;
  sh:declare [
      sh:namespace "http://www.w3.org/ns/shacl#" ;
      sh:prefix "sh" ;
  ] .

ex:subClassOf1
    a sh:SPARQLRule ;
    sh:construct "CONSTRUCT { ?a rdfs:subClassOf ?c } WHERE { ?a rdfs:subClassOf ?b . ?b rdfs:subClassOf ?c }" .

ex:subClassOf2
    a sh:SPARQLRule ;
    sh:construct "CONSTRUCT { ?a rdf:type ?y } WHERE { ?a rdf:type ?x . ?x rdfs:subClassOf ?y }" .

ex:subPropertyOf1
    a sh:SPARQLRule ;
    sh:construct "CONSTRUCT { ?a rdfs:subPropertyOf ?c } WHERE { ?a rdfs:subPropertyOf ?b . ?b rdfs:subPropertyOf ?c }" .

ex:subPropertyOf2
    a sh:SPARQLRule ;
    sh:construct "CONSTRUCT { ?a ?prop ?o } WHERE { ?a ?subProp ?o . ?subProp rdfs:subPropertyOf ?prop }" .

ex:domain
    a sh:SPARQLRule ;
    sh:construct "CONSTRUCT { ?a rdf:type ?y } WHERE { ?a ?p ?o . ?p rdfs:domain ?y }" .

ex:range
    a sh:SPARQLRule ;
    sh:construct "CONSTRUCT { ?a rdf:type ?y } WHERE { ?s ?p ?a . ?p rdfs:range ?y }" .
