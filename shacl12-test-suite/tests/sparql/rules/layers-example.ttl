@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Origin: https://github.com/w3c/data-shapes/issues/1069#issuecomment-5078462191

ex:
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ;
      sh:prefix "rdf" ;
  ] ;
  sh:declare [
      sh:namespace "http://www.w3.org/ns/shacl#" ;
      sh:prefix "sh" ;
  ] ;
  sh:declare [
      sh:namespace "http://example.com/" ;
      sh:prefix "" ;
    ] .


ex:InitRule
    a sh:SPARQLRule ;
    sh:runOnce true ;
    sh:construct """
        CONSTRUCT {
            :x1 :link :x2 .
            :x2 :link :x3 .
            :x3 :link :x4 .
            :x4 :link :x5 .
        }
        WHERE {

        }
    """ .

ex:Rule1
    a sh:SPARQLRule ;
    sh:layer 0 ;
    sh:construct """
        CONSTRUCT { ?a :connected ?b } WHERE { ?a :link ?b }
    """ .

ex:Rule2
    a sh:SPARQLRule ;
    sh:layer 1 ;
    sh:construct """
        CONSTRUCT { ?a :connected ?b .} WHERE { ?a :connected/:connected ?b }
    """ .

ex:RuleQ3
    a sh:SPARQLRule ;
    sh:layer 2 ;
    sh:construct """
        CONSTRUCT { :x1 :status ":x1 not connected to :x4" } WHERE { FILTER NOT EXISTS { :x1 :connected :x4 } }
    """ .

ex:RuleQ4
    a sh:SPARQLRule ;
    sh:layer 1 ;
    sh:construct """
        CONSTRUCT { :x1 :status ":x1 is connected to :x4" } WHERE { :x1 :connected :x4 }
    """ .

ex:RuleQ5
    a sh:SPARQLRule ;
    sh:layer 2 ;
    sh:construct """
        CONSTRUCT { :x1 :status ":x1 is not connected to :x5" } WHERE { FILTER NOT EXISTS { :x1 :connected :x5 } }
    """ .

ex:RuleQ6
    a sh:SPARQLRule ;
    sh:layer 1 ;
    sh:construct """
        CONSTRUCT { :x1 :status ":x1 is connected to :x5" } WHERE { :x1 :connected :x5 }
    """ .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <layers-example>
    ) .

<layers-example>
  rdf:type sht:Infer ;
  rdfs:label "Test of sh:layer" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result <layers-example-results.ttl> ;
  mf:status sht:approved ;
.
