@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.com/ns>
  rdf:type owl:Ontology ;
  sh:declare [
      sh:namespace "http://example.com/ns#"^^xsd:anyURI ;
      sh:prefix "ex" ;
    ] ;
.
ex:Alice
  ex:firstName "Alice" ;
.
ex:Bob
  ex:displayName "Bobby" ;
  ex:firstName "Bob" ;
.
ex:Carol
  rdfs:comment "No display name, so the default value is derived from the too short first name" ;
  ex:firstName "Al" ;
.
ex:Dave
  rdfs:comment "Has a too short display name; the default value is not used" ;
  ex:displayName "Jo" ;
  ex:firstName "David" ;
.
ex:Person-displayName
  rdf:type sh:PropertyShape ;
  sh:path ex:displayName ;
  sh:defaultValue [
      sh:prefixes <http://example.com/ns> ;
      sh:select """
		SELECT ?name
		WHERE {
			$this ex:firstName ?name .
		}""" ;
    ] ;
  sh:minLength 4 ;
  sh:targetNode ex:Alice ;
  sh:targetNode ex:Bob ;
  sh:targetNode ex:Carol ;
  sh:targetNode ex:Dave ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <property-select-002>
    ) ;
.
<property-select-002>
  rdf:type sht:Validate ;
  rdfs:label "Test of a sh:property with a sh:select expression as sh:defaultValue 002" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:SPARQLNodeExpr ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Carol ;
          sh:resultPath ex:displayName ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MinLengthConstraintComponent ;
          sh:sourceShape ex:Person-displayName ;
          sh:value "Al" ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Dave ;
          sh:resultPath ex:displayName ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:MinLengthConstraintComponent ;
          sh:sourceShape ex:Person-displayName ;
          sh:value "Jo" ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
