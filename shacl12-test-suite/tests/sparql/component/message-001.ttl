@prefix dash: <http://datashapes.org/dash#> .
@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ComponentMessageComponent
  rdf:type sh:ConstraintComponent ;
  sh:message "Message from the component" ;
  sh:parameter [
      sh:path ex:componentMessage ;
      sh:datatype xsd:boolean ;
    ] ;
  sh:validator [
      rdf:type sh:SPARQLAskValidator ;
      sh:ask """
		ASK {
			FILTER (false) .
		}""" ;
    ] ;
.
ex:ValidatorMessageComponent
  rdf:type sh:ConstraintComponent ;
  sh:message "Message from the other component" ;
  sh:parameter [
      sh:path ex:validatorMessage ;
      sh:datatype xsd:boolean ;
    ] ;
  sh:validator [
      rdf:type sh:SPARQLAskValidator ;
      sh:ask """
		ASK {
			FILTER (false) .
		}""" ;
      sh:message "Message from the validator" ;
    ] ;
.
ex:TestShape
  rdf:type sh:NodeShape ;
  ex:componentMessage true ;
  ex:validatorMessage true ;
  sh:targetNode ex:Resource ;
.
<>
  rdf:type mf:Manifest ;
  mf:entries (
      <message-001>
    ) ;
.
<message-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:message at constraint components and their validators 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:SPARQLValidation ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Resource ;
          sh:resultMessage "Message from the component" ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent ex:ComponentMessageComponent ;
          sh:sourceShape ex:TestShape ;
          sh:value ex:Resource ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:Resource ;
          sh:resultMessage "Message from the validator" ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent ex:ValidatorMessageComponent ;
          sh:sourceShape ex:TestShape ;
          sh:value ex:Resource ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
