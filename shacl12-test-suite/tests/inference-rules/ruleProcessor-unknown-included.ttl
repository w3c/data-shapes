@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The rule set used as sh:entailment has no sh:ruleProcessor itself, but it includes a rule set
# with an unknown one. The values of sh:ruleProcessor of included rule sets also apply to the
# including rule set, so the engine must report a failure.

<>
  sh:entailment ex:AllRules ;
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://example.com/ns#" ;
      sh:prefix "ex" ;
    ] .

ex:AllRules
	a sh:RuleSet ;
	sh:includesRuleSet ex:AreaRules .

ex:AreaRules
	a sh:RuleSet ;
	sh:ruleProcessor "Unknown" ;
	sh:hasRule ex:AreaRule .

ex:RectangleShape
	a sh:NodeShape ;
	sh:targetClass ex:Rectangle ;
	sh:rule ex:AreaRule .

ex:AreaRule
	a sh:TripleRule ;
	sh:predicate ex:area ;
	sh:object 0 .

ex:ExampleRectangle
	a ex:Rectangle .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <ruleProcessor-unknown-included>
    ) .

<ruleProcessor-unknown-included>
  rdf:type sht:Validate ;
  rdfs:label "Test that an unknown sh:ruleProcessor of an included rule set also makes the including rule set fail" ;
  rdfs:seeAlso <https://www.w3.org/TR/shacl12-inference-rules/#ruleProcessor> ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:InferenceRules ;
  mf:result sht:Failure ;
  mf:status sht:approved .
