@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The sh:construct string is not a valid SPARQL query (the WHERE clause is not closed).

ex:
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://example.com/ns#" ;
      sh:prefix "ex" ;
    ] .

ex:RectangleRulesShape
	a sh:NodeShape ;
	sh:targetClass ex:Rectangle ;
	sh:rule [
		a sh:SPARQLRule ;
		sh:prefixes ex: ;
		sh:construct """
			CONSTRUCT {
				$this ex:area ?area .
			}
			WHERE {
				$this ex:width ?width .
			""" ;
	] .

ex:ExampleRectangle
	a ex:Rectangle ;
	ex:width 7 .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <SPARQLRule-syntax-error>
    ) .

<SPARQLRule-syntax-error>
  rdf:type sht:Infer ;
  rdfs:label "Test that a SPARQL rule whose sh:construct is not a valid SPARQL query produces a failure" ;
  rdfs:seeAlso <https://www.w3.org/TR/shacl12-inference-rules/#SPARQLRule> ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:InferenceRules ;
  mf:result sht:Failure ;
  mf:status sht:approved .
