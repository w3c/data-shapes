@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sparql: <http://www.w3.org/ns/sparql#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The expected derived triples of a layer are computed at the start of that layer, so the derived
# ex:area of layer 1 uses the ex:height inferred in layer 0. The derived ex:area triple itself is
# deleted at the end of layer 1 and is not part of the result.

ex:
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://example.com/ns#" ;
      sh:prefix "ex" ;
    ] .

ex:SquareShape
	a sh:NodeShape ;
	sh:targetClass ex:Square ;
	sh:property ex:SquareShape-area ;
	sh:rule ex:Square-height ;
	sh:rule ex:Square-isSmall .

ex:SquareShape-area
	a sh:PropertyShape ;
	sh:path ex:area ;
	sh:values [
		sparql:multiply ( [ shnex:pathValues ex:width ] [ shnex:pathValues ex:height ] )
	] .

ex:Square-height
	a sh:SPARQLRule ;
	rdfs:comment "A square is as high as it is wide." ;
	sh:layer 0 ;
	sh:prefixes ex: ;
	sh:construct """
		CONSTRUCT {
			$this ex:height ?width .
		}
		WHERE {
			$this ex:width ?width .
		}
		""" .

ex:Square-isSmall
	a sh:SPARQLRule ;
	sh:layer 1 ;
	sh:expectedPredicate ex:area ;
	sh:prefixes ex: ;
	sh:construct """
		CONSTRUCT {
			$this ex:isSmall true .
		}
		WHERE {
			$this ex:area ?area .
			FILTER (?area < 100) .
		}
		""" .

ex:SmallSquare
	a ex:Square ;
	ex:width 4 .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <expectedPredicate-layers>
    ) .

<expectedPredicate-layers>
  rdf:type sht:Infer ;
  rdfs:label "Test that expected derived triples are computed per layer from the inferences of the earlier layers, and removed afterwards" ;
  rdfs:seeAlso <https://www.w3.org/TR/shacl12-inference-rules/#expectedPredicate> ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:InferenceRules ;
  mf:result (
    ( ex:SmallSquare ex:height 4 )
    ( ex:SmallSquare ex:isSmall true )
  ) ;
  mf:status sht:approved ;
  sht:compliance sht:SPARQL, sht:NodeExpr ;
.
