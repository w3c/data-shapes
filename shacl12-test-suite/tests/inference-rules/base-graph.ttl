@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:
	a sh:ShapesGraph ;
  	sh:declare [
		sh:namespace "http://example.com/ns#" ;
		sh:prefix "ex" ;
	] .

ex:Rule1
    a sh:SPARQLRule ;
	sh:runOnce true ;
	sh:construct """
		# This rule adds one triple to the inferences graph
		CONSTRUCT {
			ex:Subject ex:predicate1 ex:object .
		}
		WHERE {
		}
	""" .

ex:Rule2
    a sh:SPARQLRule ;
	sh:layer 1 ;
	sh:construct """
		# This rule does not produce triples because the base
		# graph does not see the inferred triple
		CONSTRUCT {
			ex:Subject ex:predicate2 ?object .
		}
		WHERE {
			GRAPH <urn:graph:base> {
				ex:Subject ex:predicate1 ?object .
			}
		}
	""" .

ex:Rule3
    a sh:SPARQLRule ;
	sh:layer 1 ;
	sh:construct """
		# This rule does produce a triple
		CONSTRUCT {
			ex:Subject ex:predicate3 ?object .
		}
		WHERE {
			ex:Subject ex:predicate1 ?object .
		}
	""" .


<>
  rdf:type mf:Manifest ;
  mf:entries (
      <base-graph>
    ) .

<base-graph>
  rdf:type sht:Infer ;
  rdfs:label "Test of querying the base graph (without inferences) in a SHACL rule" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result (
	( ex:Subject ex:predicate1 ex:object )
	( ex:Subject ex:predicate3 ex:object )
  ) ;
  mf:status sht:approved .
