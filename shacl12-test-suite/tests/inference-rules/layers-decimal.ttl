@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Layers are executed in ascending numeric order: -1, then 0.5, then 1. The rule of layer 1 only
# fires if layer 0.5 has not produced its triple, so it never fires when the order is right.

ex:
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://example.com/ns#" ;
      sh:prefix "ex" ;
    ] .

ex:FirstRule
	a sh:SPARQLRule ;
	sh:layer -1 ;
	sh:prefixes ex: ;
	sh:construct """
		CONSTRUCT {
			ex:N ex:step ex:first .
		}
		WHERE {
		}
		""" .

ex:SecondRule
	a sh:SPARQLRule ;
	sh:layer 0.5 ;
	sh:prefixes ex: ;
	sh:construct """
		CONSTRUCT {
			ex:N ex:step ex:second .
		}
		WHERE {
			ex:N ex:step ex:first .
		}
		""" .

ex:WrongOrderRule
	a sh:SPARQLRule ;
	sh:layer 1 ;
	sh:prefixes ex: ;
	sh:construct """
		CONSTRUCT {
			ex:N ex:step ex:wrong .
		}
		WHERE {
			FILTER NOT EXISTS { ex:N ex:step ex:second } .
		}
		""" .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <layers-decimal>
    ) .

<layers-decimal>
  rdf:type sht:Infer ;
  rdfs:label "Test that layers are executed in ascending numeric order, including negative and decimal layer values" ;
  rdfs:seeAlso <https://www.w3.org/TR/shacl12-inference-rules/#rule-layers> ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:InferenceRules ;
  mf:result (
    ( ex:N ex:step ex:first )
    ( ex:N ex:step ex:second )
  ) ;
  mf:status sht:approved .
