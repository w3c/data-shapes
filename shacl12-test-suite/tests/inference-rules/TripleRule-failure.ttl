@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The path values expression of sh:object has two focus nodes, which is an evaluation failure
# (see the node expressions test failure-pathValues-two-focusNodes). The failure of the rule
# makes the execution of the rule set fail.

ex:
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://example.com/ns#" ;
      sh:prefix "ex" ;
    ] .

ex:ThingShape
	a sh:NodeShape ;
	sh:targetClass ex:Thing ;
	sh:rule [
		a sh:TripleRule ;
		sh:predicate ex:p ;
		sh:object [
			shnex:pathValues ex:q ;
			shnex:focusNode ( ex:A ex:B ) ;
		] ;
	] .

ex:A
	a ex:Thing ;
	ex:q ex:X .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <TripleRule-failure>
    ) .

<TripleRule-failure>
  rdf:type sht:Infer ;
  rdfs:label "Test that an evaluation failure of a node expression of a triple rule makes the execution of the rule set fail" ;
  rdfs:seeAlso <https://www.w3.org/TR/shacl12-inference-rules/#TripleRule> ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:InferenceRules ;
  mf:result sht:Failure ;
  mf:status sht:approved .
