@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix sparql: <http://www.w3.org/ns/sparql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://example.com/ns#" ;
      sh:prefix "ex" ;
    ] .

ex:SymmetricPropertyRule
	a sh:SPARQLRuleType ;
	rdfs:label "Symmetric property rule type" ;
	rdfs:subClassOf sh:Rule ;
	sh:parameter [
		a sh:Parameter ;
		sh:path ex:property ;
		sh:name "property" ;
		sh:description "The property that shall be treated as symmetric." ;
		sh:nodeKind sh:IRI ;
	] ;
	sh:construct """
		CONSTRUCT {
			?o $property ?s .
		}
		WHERE {
			?s $property ?o .
		}
	""" .

ex:MarriedToRule
	a ex:SymmetricPropertyRule ;
	ex:property ex:marriedTo .

ex:OverlapsRule
	a ex:SymmetricPropertyRule ;
	ex:property ex:overlaps .

ex:John ex:marriedTo ex:Mary .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <SPARQLRuleType-example-SymmetricProperty>
    ) .

<SPARQLRuleType-example-SymmetricProperty>
  rdf:type sht:Infer ;
  rdfs:label "Test of a sh:SPARQLRuleType as used in the spec" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result (
  	( ex:Mary ex:marriedTo ex:John )
  ) ;
  mf:status sht:approved ;
.
