@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix sparql: <http://www.w3.org/ns/sparql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://example.com/ns#" ;
      sh:prefix "ex" ;
    ] .

ex:TestTemplate
	a sh:SPARQLRuleTemplate ;
	rdfs:subClassOf sh:Rule ;
	sh:parameter [
		a sh:Parameter ;
		sh:path ex:requiredParam ;
	] ;
	sh:parameter [
		a sh:Parameter ;
		sh:path ex:optionalParam ;
		sh:optional true ;
	] ;
	sh:construct """
		CONSTRUCT {
			<urn:x-test:subject> $requiredParam $optionalParam .
		}
		WHERE {
		}
	""" .

ex:InvalidRule
    a ex:TestTemplate ;
	ex:optionalParam owl:Thing .

ex:ValidRule
    a ex:TestTemplate ;
	ex:requiredParam rdfs:seeAlso ;
	ex:optionalParam owl:Nothing .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <SPARQLRuleTemplate-missing-param>
    ) .

<SPARQLRuleTemplate-missing-param>
  rdf:type sht:Infer ;
  rdfs:label "Test of a sh:SPARQLRuleTemplate with missing non-optional parameter" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result sht:Failure ;
  mf:status sht:approved ;
.
