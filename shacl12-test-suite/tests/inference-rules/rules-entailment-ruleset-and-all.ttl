@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The shapes graph has both sh:RulesEntailment and the rule set ex:FullNameRules as values of
# sh:entailment. sh:RulesEntailment executes all rules of the shapes graph, which include the rules
# of any rule set, so the rule set makes no difference: ex:NicknameRule, which is not in
# ex:FullNameRules, must be executed as well, so that ex:Alice has the required ex:nickname.

<>
  sh:entailment sh:RulesEntailment, ex:FullNameRules ;
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://example.com/ns#" ;
      sh:prefix "ex" ;
    ] .

ex:FullNameRules
	a sh:RuleSet ;
	sh:hasRule ex:FullNameRule .

ex:PersonShape
	a sh:NodeShape ;
	sh:targetClass ex:Person ;
	sh:rule ex:FullNameRule ;
	sh:rule ex:NicknameRule ;
	sh:property [
		sh:path ex:fullName ;
		sh:minCount 1 ;
	] ;
	sh:property [
		sh:path ex:nickname ;
		sh:minCount 1 ;
	] .

ex:FullNameRule
	a sh:SPARQLRule ;
	sh:construct """
		CONSTRUCT {
			$this ex:fullName ?fullName .
		}
		WHERE {
			$this ex:firstName ?first .
			$this ex:lastName ?last .
			BIND (CONCAT(?first, " ", ?last) AS ?fullName) .
		}
		""" .

ex:NicknameRule
	a sh:SPARQLRule ;
	sh:construct """
		CONSTRUCT {
			$this ex:nickname ?first .
		}
		WHERE {
			$this ex:firstName ?first .
		}
		""" .

ex:Alice
	a ex:Person ;
	ex:firstName "Alice" ;
	ex:lastName "Smith" .


<>
  rdf:type mf:Manifest ;
  mf:entries (
      <rules-entailment-ruleset-and-all>
    ) .

<rules-entailment-ruleset-and-all>
  rdf:type sht:Validate ;
  rdfs:label "Test that sh:RulesEntailment together with a rule set as values of sh:entailment executes all rules" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:InferenceRules ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "true"^^xsd:boolean ;
    ] ;
  mf:status sht:approved .
