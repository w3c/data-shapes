@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Two rule sets are values of sh:entailment. Their rules are executed together as a single rule
# set, so ex:GreetingRule sees the ex:fullName derived by ex:FullNameRule from the other rule set.
# ex:NicknameRule is in neither rule set and must not be executed.

<>
  sh:entailment ex:FullNameRules, ex:GreetingRules ;
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://example.com/ns#" ;
      sh:prefix "ex" ;
    ] .

ex:FullNameRules
	a sh:RuleSet ;
	sh:hasRule ex:FullNameRule .

ex:GreetingRules
	a sh:RuleSet ;
	sh:hasRule ex:GreetingRule .

ex:PersonShape
	a sh:NodeShape ;
	sh:targetClass ex:Person ;
	sh:rule ex:FullNameRule ;
	sh:rule ex:GreetingRule ;
	sh:rule ex:NicknameRule ;
	sh:property [
		sh:path ex:fullName ;
		sh:minCount 1 ;
	] ;
	sh:property [
		sh:path ex:nickname ;
		sh:maxCount 0 ;
	] ;
	sh:property [
		sh:path ex:greeting ;
		sh:minCount 1 ;
	] .

ex:FullNameRule
	a sh:SPARQLRule ;
	sh:construct """
		CONSTRUCT {
			$this ex:fullName ?fullName .
		}
		WHERE {
			$this ex:firstName ?first .
			$this ex:lastName ?last .
			BIND (CONCAT(?first, " ", ?last) AS ?fullName) .
		}
		""" .

ex:GreetingRule
	a sh:SPARQLRule ;
	sh:construct """
		CONSTRUCT {
			$this ex:greeting ?greeting .
		}
		WHERE {
			$this ex:fullName ?fullName .
			BIND (CONCAT("Hello ", ?fullName) AS ?greeting) .
		}
		""" .

ex:NicknameRule
	a sh:SPARQLRule ;
	sh:construct """
		CONSTRUCT {
			$this ex:nickname ?first .
		}
		WHERE {
			$this ex:firstName ?first .
		}
		""" .

ex:Alice
	a ex:Person ;
	ex:firstName "Alice" ;
	ex:lastName "Smith" .


<>
  rdf:type mf:Manifest ;
  mf:entries (
      <rules-entailment-ruleset-multiple>
    ) .

<rules-entailment-ruleset-multiple>
  rdf:type sht:Validate ;
  rdfs:label "Test that multiple rule sets as values of sh:entailment are executed together as a single rule set" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:InferenceRules ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "true"^^xsd:boolean ;
    ] ;
  mf:status sht:approved .
