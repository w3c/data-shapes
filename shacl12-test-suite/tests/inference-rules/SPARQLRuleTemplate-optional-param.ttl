@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# An optional parameter that has no value in a rule leaves its variable unbound, which the query handles with COALESCE.

ex:
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://example.com/ns#" ;
      sh:prefix "ex" ;
    ] .

ex:LabelTemplate
	a sh:SPARQLRuleTemplate ;
	rdfs:subClassOf sh:Rule ;
	sh:parameter [
		a sh:Parameter ;
		sh:path ex:prefix ;
		sh:datatype xsd:string ;
		sh:optional true ;
	] ;
	sh:prefixes ex: ;
	sh:construct """
		CONSTRUCT {
			$this ex:label ?label .
		}
		WHERE {
			$this ex:name ?name .
			BIND (CONCAT(COALESCE($prefix, ""), ?name) AS ?label) .
		}
		""" .

ex:Thing
	a sh:ShapeClass ;
	sh:rule ex:PlainLabelRule .

ex:PlainLabelRule
	a ex:LabelTemplate .

ex:Person
	a sh:ShapeClass ;
	sh:rule ex:PrefixedLabelRule .

ex:PrefixedLabelRule
	a ex:LabelTemplate ;
	ex:prefix "Dr. " .

ex:SomeThing
	a ex:Thing ;
	ex:name "Widget" .

ex:SomePerson
	a ex:Person ;
	ex:name "Smith" .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <SPARQLRuleTemplate-optional-param>
    ) .

<SPARQLRuleTemplate-optional-param>
  rdf:type sht:Infer ;
  rdfs:label "Test of a SPARQL rule template with an optional parameter that is absent in one rule and present in another" ;
  rdfs:seeAlso <https://www.w3.org/TR/shacl12-inference-rules/#SPARQLRuleTemplate> ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:InferenceRules ;
  mf:result (
    ( ex:SomeThing ex:label "Widget" )
    ( ex:SomePerson ex:label "Dr. Smith" )
  ) ;
  mf:status sht:approved .
