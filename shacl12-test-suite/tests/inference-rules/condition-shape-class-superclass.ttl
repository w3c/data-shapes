@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ex:Rectangle is both a node shape and a class, so a focus node only meets the condition if it
# also conforms to the superclass shape ex:Shape, which requires an ex:name.

ex:
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://example.com/ns#" ;
      sh:prefix "ex" ;
    ] .

ex:Shape
	a sh:ShapeClass ;
	sh:property [
		sh:path ex:name ;
		sh:minCount 1 ;
	] .

ex:Rectangle
	a sh:ShapeClass ;
	rdfs:subClassOf ex:Shape ;
	sh:property [
		sh:path ex:width ;
		sh:minCount 1 ;
	] .

ex:RectangleRulesShape
	a sh:NodeShape ;
	sh:targetClass ex:Rectangle ;
	sh:rule [
		a sh:TripleRule ;
		sh:predicate ex:checked ;
		sh:object true ;
		sh:condition ex:Rectangle ;
	] .

ex:NamedRectangle
	a ex:Rectangle ;
	ex:name "named" ;
	ex:width 1 .

ex:UnnamedRectangle
	a ex:Rectangle ;
	ex:width 1 .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <condition-shape-class-superclass>
    ) .

<condition-shape-class-superclass>
  rdf:type sht:Infer ;
  rdfs:label "Test that a sh:condition that is a node shape and a class also requires conformance to its superclass shapes" ;
  rdfs:seeAlso <https://www.w3.org/TR/shacl12-inference-rules/#condition> ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:InferenceRules ;
  mf:result (
    ( ex:NamedRectangle ex:checked true )
  ) ;
  mf:status sht:approved .
