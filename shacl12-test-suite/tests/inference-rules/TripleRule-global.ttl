@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# A global triple rule has no focus nodes, so all three of sh:subject, sh:predicate and sh:object
# must be given. Its node expressions are evaluated without a focus node.

ex:
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://example.com/ns#" ;
      sh:prefix "ex" ;
    ] .

ex:AgentRule
	a sh:TripleRule ;
	sh:subject [ shnex:instancesOf ex:Person ] ;
	sh:predicate rdf:type ;
	sh:object ex:Agent .

ex:Alice
	a ex:Person .

ex:Bob
	a ex:Person .

ex:Rex
	a ex:Dog .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <TripleRule-global>
    ) .

<TripleRule-global>
  rdf:type sht:Infer ;
  rdfs:label "Test of a global triple rule that computes subjects, predicate and object from node expressions without a focus node" ;
  rdfs:seeAlso <https://www.w3.org/TR/shacl12-inference-rules/#TripleRule> ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:InferenceRules ;
  mf:result (
    ( ex:Alice rdf:type ex:Agent )
    ( ex:Bob rdf:type ex:Agent )
  ) ;
  mf:status sht:approved .
