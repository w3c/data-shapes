@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The data graph has no ex:fullName values, so ex:PersonShape's sh:minCount 1 constraint on
# ex:fullName would fail without rules. The shapes graph declares the rule set ex:FullNameRules
# as its sh:entailment, so a conformant engine executes ex:FullNameRule before validating.
# ex:NicknameRule is not in that rule set and must not be executed - otherwise the derived
# ex:nickname would violate sh:maxCount 0.

<>
  sh:entailment ex:FullNameRules ;
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://example.com/ns#" ;
      sh:prefix "ex" ;
    ] .

ex:FullNameRules
	a sh:RuleSet ;
	sh:hasRule ex:FullNameRule .

ex:PersonShape
	a sh:NodeShape ;
	sh:targetClass ex:Person ;
	sh:rule ex:FullNameRule ;
	sh:rule ex:NicknameRule ;
	sh:property [
		sh:path ex:fullName ;
		sh:minCount 1 ;
	] ;
	sh:property [
		sh:path ex:nickname ;
		sh:maxCount 0 ;
	] .

ex:FullNameRule
	a sh:SPARQLRule ;
	sh:construct """
		CONSTRUCT {
			$this ex:fullName ?fullName .
		}
		WHERE {
			$this ex:firstName ?first .
			$this ex:lastName ?last .
			BIND (CONCAT(?first, " ", ?last) AS ?fullName) .
		}
		""" .

ex:NicknameRule
	a sh:SPARQLRule ;
	sh:construct """
		CONSTRUCT {
			$this ex:nickname ?first .
		}
		WHERE {
			$this ex:firstName ?first .
		}
		""" .

ex:Alice
	a ex:Person ;
	ex:firstName "Alice" ;
	ex:lastName "Smith" .


<>
  rdf:type mf:Manifest ;
  mf:entries (
      <rules-entailment-ruleset-validation>
    ) .

<rules-entailment-ruleset-validation>
  rdf:type sht:Validate ;
  rdfs:label "Test that a rule set as value of sh:entailment executes only the rules of that rule set before validation" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:InferenceRules ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "true"^^xsd:boolean ;
    ] ;
  mf:status sht:approved .
