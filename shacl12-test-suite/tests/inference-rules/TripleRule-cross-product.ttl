@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# A triple rule infers one triple for each combination of the nodes produced by its node expressions.

ex:
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://example.com/ns#" ;
      sh:prefix "ex" ;
    ] .

ex:ThingShape
	a sh:NodeShape ;
	sh:targetClass ex:Thing ;
	sh:rule [
		a sh:TripleRule ;
		# sh:subject defaults to the current focus node
		sh:predicate ( ex:p1 ex:p2 ) ;
		sh:object [ shnex:pathValues ex:source ] ;
	] .

ex:A
	a ex:Thing ;
	ex:source ex:X, ex:Y .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <TripleRule-cross-product>
    ) .

<TripleRule-cross-product>
  rdf:type sht:Infer ;
  rdfs:label "Test that a triple rule infers a triple for each combination of its predicates and objects" ;
  rdfs:seeAlso <https://www.w3.org/TR/shacl12-inference-rules/#TripleRule> ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:InferenceRules ;
  mf:result (
    ( ex:A ex:p1 ex:X )
    ( ex:A ex:p1 ex:Y )
    ( ex:A ex:p2 ex:X )
    ( ex:A ex:p2 ex:Y )
  ) ;
  mf:status sht:approved .
