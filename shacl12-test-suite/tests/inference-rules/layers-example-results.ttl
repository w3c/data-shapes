<http://example.com/x1>
        <http://example.com/connected>  <http://example.com/x5> , <http://example.com/x4> , <http://example.com/x3> , <http://example.com/x2>;
        <http://example.com/link>       <http://example.com/x2>;
        <http://example.com/status>     ":x1 is connected to :x4" , ":x1 is connected to :x5" .

<http://example.com/x2>
        <http://example.com/connected>  <http://example.com/x5> , <http://example.com/x4> , <http://example.com/x3>;
        <http://example.com/link>       <http://example.com/x3> .

<http://example.com/x3>
        <http://example.com/connected>  <http://example.com/x5> , <http://example.com/x4>;
        <http://example.com/link>       <http://example.com/x4> .

<http://example.com/x4>
        <http://example.com/connected>  <http://example.com/x5>;
        <http://example.com/link>       <http://example.com/x5> .
