@prefix ex: <http://example.com/ns#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Combinations that would not form a well-formed triple (a literal as subject, a literal or
# blank node as predicate) are skipped, while the well-formed combination is inferred.

ex:
  a sh:ShapesGraph ;
  sh:declare [
      sh:namespace "http://example.com/ns#" ;
      sh:prefix "ex" ;
    ] .

ex:ThingShape
	a sh:NodeShape ;
	sh:targetClass ex:Thing ;
	sh:rule [
		a sh:TripleRule ;
		sh:subject [ shnex:pathValues ex:subjects ] ;
		sh:predicate [ shnex:pathValues ex:predicates ] ;
		sh:object ex:o ;
	] .

ex:A
	a ex:Thing ;
	ex:subjects ex:S, "a literal" ;
	ex:predicates ex:p, "another literal", [ rdfs:comment "a blank node" ] .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <TripleRule-skips-ill-formed>
    ) .

<TripleRule-skips-ill-formed>
  rdf:type sht:Infer ;
  rdfs:label "Test that a triple rule skips combinations that would form ill-formed triples" ;
  rdfs:seeAlso <https://www.w3.org/TR/shacl12-inference-rules/#TripleRule> ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:requires sht:InferenceRules ;
  mf:result (
    ( ex:S ex:p ex:o )
  ) ;
  mf:status sht:approved .
