PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#> 
PREFIX mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> 

PREFIX :       <https://w3c.github.io/rdf-tests/shacl/shacl12/>

PREFIX srlt:   <http://www.w3.org/ns/sparql-rl-tests#>

<#>  rdf:type mf:Manifest ;
   rdfs:label "SRL Examples"@en ;
   mf:assumedTestBase <https://w3c.github.io/rdf-tests/shacl/shacl12/> ;
    mf:entries
    (
      :example-1
      :example-2
      :example-3
      :example-4
      :example-5
    ) .

:example-1 rdf:type srlt:RulesEvalTest ;
    mf:name "Example 1" ;
    mf:action
         [ srlt:ruleset  <example-1.srl> ;
           srlt:data     <example-1-data.ttl> ] ;
    mf:result  <example-1-inf.ttl> ;
    .

:example-2 rdf:type srlt:RulesEvalTest ;
    mf:name "Example 2" ;
    mf:action
         [ srlt:ruleset  <example-2.srl> ;
           srlt:data     <example-2-data.ttl> ] ;
    mf:result  <example-2-inf.ttl> ;
    .

:example-3 rdf:type srlt:RulesEvalTest ;
    mf:name "Example 3" ;
    mf:action
         [ srlt:ruleset  <example-3.srl> ;
           srlt:data     <example-3-data.ttl> ] ;
    mf:result  <example-3-inf.ttl> ;
    .

:example-4 rdf:type srlt:RulesEvalTest ;
    mf:name "Example 4" ;
    mf:action
         [ srlt:ruleset  <example-4.srl> ;
           srlt:data     <example-4-data.ttl> ] ;
    mf:result  <example-4-inf.ttl> ;
    .

:example-5 rdf:type srlt:RulesEvalTest ;
    mf:name "Example 5" ;
    mf:action
         [ srlt:ruleset  <example-5.srl> ;
           srlt:data     <example-5-data.ttl> ] ;
    mf:result  <example-5-inf.ttl> ;
    .
