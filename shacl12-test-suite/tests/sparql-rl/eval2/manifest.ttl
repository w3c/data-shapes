## License https://www.w3.org/copyright/software-license-2023/

PREFIX :       <https://w3c.github.io/rdf-tests/sparql-rl/eval2/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX srlt:   <http://www.w3.org/ns/sparql-rl-tests#>

<>  rdf:type mf:Manifest ;
    mf:assumedTestBase <https://w3c.github.io/rdf-tests/sparql-rl/> ;
    rdfs:seeAlso <https://w3c.github.io/rdf-tests/> ;
    dct:licence <https://www.w3.org/copyright/software-license-2023/> ;

    rdfs:label "SPARQL-RL - Evaluation Tests - eval2" ;
    mf:entries
    (
    
        :link-path-1
        :link-path-2

        :eval-dft-value-01
        :eval-dft-value-02
    ) .
    
:link-path-1 rdf:type srlt:RulesEvalTest ;
    mf:name "Link path 1";
    mf:action
         [ srlt:ruleset  <link-1-path.srl> ;
           srlt:data     <link-1-data.ttl> ] ;
    mf:result  <link-1-results.ttl> ;
    .

:link-path-2 rdf:type srlt:RulesEvalTest ;
    mf:name "Link path 2";
    mf:action
         [ srlt:ruleset  <link-1-path.srl> ;
           srlt:data     <link-1-data.ttl> ] ;
    mf:result  <link-1-results.ttl> ;
    .
:eval-assign-01 rdf:type srlt:RulesEvalTest ;
    mf:name "Eval-assign-01";
    mf:action
         [ srlt:ruleset  <eval-assign-01.srl> ;
           srlt:data     <data-empty.ttl> ] ;
    mf:result  <eval-assign-01-results.ttl> ;
    .
    

## NOT GROUND

:eval-dft-value-01 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-dft-value-01" ;
    mf:action
         [ srlt:ruleset  <eval-dft-value-01.srl> ;
           srlt:data     <eval-dft-value-01-data.ttl> ] ;
    mf:result  <eval-dft-value-01-results.ttl> ;
    .

## WHERE GROUND

:eval-dft-value-02 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-dft-value02" ;
    mf:action
         [ srlt:ruleset  <eval-dft-value-02.srl> ;
           srlt:data     <eval-dft-value-02-data.ttl> ] ;
    mf:result  <eval-dft-value-02-results.ttl> ;
    .
