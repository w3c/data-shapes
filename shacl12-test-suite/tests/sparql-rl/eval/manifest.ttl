## GROUP and aggregation

:eval-group-01 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-01" ;
    rdfs:comment "The example in the overview section, Grouping and Aggregation." ;
    mf:action
         [ srlt:ruleset  <eval-group-01.srl> ;
           srlt:data     <eval-group-01-data.ttl> ] ;
    mf:result  <eval-group-01-results.ttl> ;
    .

:eval-group-02 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-02" ;
    rdfs:comment "A GROUP with no keys whose pattern has no solutions." ;
    mf:action
         [ srlt:ruleset  <eval-group-02.srl> ;
           srlt:data     <eval-group-02-data.ttl> ] ;
    mf:result  <eval-group-02-results.ttl> ;
    .

:eval-group-03 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-03" ;
    rdfs:comment "SUM keeps equal values, and DISTINCT removes them." ;
    mf:action
         [ srlt:ruleset  <eval-group-03.srl> ;
           srlt:data     <eval-group-03-data.ttl> ] ;
    mf:result  <eval-group-03-results.ttl> ;
    .

:eval-group-04 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-04" ;
    rdfs:comment "COUNT(?x) counts solutions, and COUNT(DISTINCT ?x) counts values." ;
    mf:action
         [ srlt:ruleset  <eval-group-04.srl> ;
           srlt:data     <eval-group-04-data.ttl> ] ;
    mf:result  <eval-group-04-results.ttl> ;
    .

:eval-group-05 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-05" ;
    rdfs:comment "COUNT(DISTINCT *) equals COUNT(*)." ;
    mf:action
         [ srlt:ruleset  <eval-group-05.srl> ;
           srlt:data     <eval-group-05-data.ttl> ] ;
    mf:result  <eval-group-05-results.ttl> ;
    .

:eval-group-06 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-06" ;
    rdfs:comment "MIN and MAX compare numbers by value." ;
    mf:action
         [ srlt:ruleset  <eval-group-06.srl> ;
           srlt:data     <eval-group-06-data.ttl> ] ;
    mf:result  <eval-group-06-results.ttl> ;
    .

:eval-group-07 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-07" ;
    rdfs:comment "SUM over an integer and a decimal gives a decimal." ;
    mf:action
         [ srlt:ruleset  <eval-group-07.srl> ;
           srlt:data     <eval-group-07-data.ttl> ] ;
    mf:result  <eval-group-07-results.ttl> ;
    .

:eval-group-08 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-08" ;
    rdfs:comment "An error in one aggregation drops the whole group, including assignments that did not fail." ;
    mf:action
         [ srlt:ruleset  <eval-group-08.srl> ;
           srlt:data     <eval-group-08-data.ttl> ] ;
    mf:result  <eval-group-08-results.ttl> ;
    .

:eval-group-09 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-09" ;
    rdfs:comment "A pattern variable with the same name as an earlier variable that is not a key is a separate variable, and both earlier bindings sharing the same key reach the head." ;
    mf:action
         [ srlt:ruleset  <eval-group-09.srl> ;
           srlt:data     <eval-group-09-data.ttl> ] ;
    mf:result  <eval-group-09-results.ttl> ;
    .

:eval-group-10 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-10" ;
    rdfs:comment "A key bound before the GROUP and not used in the pattern." ;
    mf:action
         [ srlt:ruleset  <eval-group-10.srl> ;
           srlt:data     <eval-group-10-data.ttl> ] ;
    mf:result  <eval-group-10-results.ttl> ;
    .

:eval-group-11 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-11" ;
    rdfs:comment "A key bound before the GROUP is used only in a FILTER inside the pattern." ;
    mf:action
         [ srlt:ruleset  <eval-group-11.srl> ;
           srlt:data     <eval-group-11-data.ttl> ] ;
    mf:result  <eval-group-11-results.ttl> ;
    .

:eval-group-12 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-12" ;
    rdfs:comment "An aggregation argument that is a key bound before the GROUP." ;
    mf:action
         [ srlt:ruleset  <eval-group-12.srl> ;
           srlt:data     <eval-group-12-data.ttl> ] ;
    mf:result  <eval-group-12-results.ttl> ;
    .

:eval-group-13 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-13" ;
    rdfs:comment "One earlier solution yields several groups when the pattern binds a further key." ;
    mf:action
         [ srlt:ruleset  <eval-group-13.srl> ;
           srlt:data     <eval-group-13-data.ttl> ] ;
    mf:result  <eval-group-13-results.ttl> ;
    .

:eval-group-14 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-14" ;
    rdfs:comment "A SET in the pattern computes the value that is summed." ;
    mf:action
         [ srlt:ruleset  <eval-group-14.srl> ;
           srlt:data     <eval-group-14-data.ttl> ] ;
    mf:result  <eval-group-14-results.ttl> ;
    .

:eval-group-15 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-15" ;
    rdfs:comment "A FILTER after the GROUP does the work of SPARQL's HAVING." ;
    mf:action
         [ srlt:ruleset  <eval-group-15.srl> ;
           srlt:data     <eval-group-15-data.ttl> ] ;
    mf:result  <eval-group-15-results.ttl> ;
    .

:eval-group-16 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-16" ;
    rdfs:comment "A triple pattern after the GROUP joins on the result." ;
    mf:action
         [ srlt:ruleset  <eval-group-16.srl> ;
           srlt:data     <eval-group-16-data.ttl> ] ;
    mf:result  <eval-group-16-results.ttl> ;
    .

:eval-group-17 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-17" ;
    rdfs:comment "Grouping on a computed key." ;
    mf:action
         [ srlt:ruleset  <eval-group-17.srl> ;
           srlt:data     <eval-group-17-data.ttl> ] ;
    mf:result  <eval-group-17-results.ttl> ;
    .

:eval-group-18 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-18" ;
    rdfs:comment "Two GROUPs in sequence: the first one's result survives the second, and a key with no group in the second is dropped." ;
    mf:action
         [ srlt:ruleset  <eval-group-18.srl> ;
           srlt:data     <eval-group-18-data.ttl> ] ;
    mf:result  <eval-group-18-results.ttl> ;
    .

:eval-group-19 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-19" ;
    rdfs:comment "An empty pattern forms one group of one solution." ;
    mf:action
         [ srlt:ruleset  <eval-group-19.srl> ;
           srlt:data     <data-empty.ttl> ] ;
    mf:result  <eval-group-19-results.ttl> ;
    .

:eval-group-20 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-20" ;
    rdfs:comment "Counting runs after the recursion it depends on has finished." ;
    mf:action
         [ srlt:ruleset  <eval-group-20.srl> ;
           srlt:data     <eval-group-20-data.ttl> ] ;
    mf:result  <eval-group-20-results.ttl> ;
    .

:eval-group-21 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-21" ;
    rdfs:comment "A GROUP in a WHERE DATA rule counts base data only." ;
    mf:action
         [ srlt:ruleset  <eval-group-21.srl> ;
           srlt:data     <eval-group-21-data.ttl> ] ;
    mf:result  <eval-group-21-results.ttl> ;
    .

:eval-group-22 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-22" ;
    rdfs:comment "A blank node in the pattern acts as a variable." ;
    mf:action
         [ srlt:ruleset  <eval-group-22.srl> ;
           srlt:data     <eval-group-22-data.ttl> ] ;
    mf:result  <eval-group-22-results.ttl> ;
    .

:eval-group-23 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-23" ;
    rdfs:comment "A general rule uses the output of a GROUP rule." ;
    mf:action
         [ srlt:ruleset  <eval-group-23.srl> ;
           srlt:data     <eval-group-23-data.ttl> ] ;
    mf:result  <eval-group-23-results.ttl> ;
    .

:eval-group-24 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-group-24" ;
    rdfs:comment "An empty assignment block returns group keys and drops an outer solution with no matches." ;
    mf:action
         [ srlt:ruleset  <eval-group-24.srl> ;
           srlt:data     <eval-group-24-data.ttl> ] ;
    mf:result <eval-group-24-results.ttl> ;
    .
