## Basic (positive datalog)

:eval-basic-01 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-basic-01";
    mf:action
         [ srlt:ruleset  <eval-basic-01.srl> ;
           srlt:data     <data-01.ttl> ] ;
    mf:result  <eval-basic-01-results.ttl> ;
    .
    
:eval-basic-02 rdf:type srlt:RulesEvalTest ;
    mf:name "eval-basic-02";
    mf:action
         [ srlt:ruleset  <eval-basic-02.srl> ;
           srlt:data     <data-02.ttl> ] ;
    mf:result  <eval-basic-02-results.ttl> ;
    .

