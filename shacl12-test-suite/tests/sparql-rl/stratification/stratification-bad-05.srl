## The base data test with no WHERE DATA or NOT DATA
PREFIX :        <http://example/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

RULE { ?x :distanceKm ?kilometers }
WHERE {
    ?x :distanceMiles ?miles
    NOT { ?x :distanceKm ?km }
    SET ( ?kilometers := xsd:integer(?miles * 1.60934) )
}
