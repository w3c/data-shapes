PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

<>  rdf:type mf:Manifest ;
    rdfs:label "SPARQL-RL tests" ;
    mf:assumedTestBase <https://w3c.github.io/rdf-tests/sparql-rl/> ;
    rdfs:seeAlso <https://w3c.github.io/rdf-tests/> ;
    dct:licence <https://www.w3.org/copyright/software-license-2023/> ;
    rdfs:comment """
      These test suites are a product of the W3C Data Shapes Working Group.
    """;
  mf:include (
    <syntax/manifest.ttl>
    <wellformed/manifest.ttl>
    <stratification/manifest.ttl>
    <eval/manifest.ttl>
    <eval2/manifest.ttl>
    <examples/manifest.ttl>
  ) .
