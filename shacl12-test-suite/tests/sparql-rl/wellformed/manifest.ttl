        :test_58
        :test_59
    ) .

:test_1 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-01.srl" ;
   mf:action  <wellformed-01.srl> ;
   .

:test_2 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-02.srl" ;
   mf:action  <wellformed-02.srl> ;
   .

:test_3 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-03.srl" ;
   mf:action  <wellformed-03.srl> ;
   .

:test_4 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-04.srl" ;
   mf:action  <wellformed-04.srl> ;
   .

:test_5 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-bad-01.srl" ;
   mf:action  <wellformed-bad-01.srl> ;
   .

:test_6 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-bad-02.srl" ;
   mf:action  <wellformed-bad-02.srl> ;
   .

:test_7 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-bad-03.srl" ;
   mf:action  <wellformed-bad-03.srl> ;
   .

:test_8 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-bad-04.srl" ;
   mf:action  <wellformed-bad-04.srl> ;
   .

:test_9 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-01.srl" ;
   rdfs:comment "A key bound only by the pattern." ;
   mf:action  <wellformed-group-01.srl> ;
   .

:test_10 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-02.srl" ;
   rdfs:comment "A key bound only before the GROUP and not used in the pattern." ;
   mf:action  <wellformed-group-02.srl> ;
   .

:test_11 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-03.srl" ;
   rdfs:comment "An earlier variable that is not a key is used in the head." ;
   mf:action  <wellformed-group-03.srl> ;
   .

:test_12 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-04.srl" ;
   rdfs:comment "A pattern variable with the same name as an earlier variable that is not a key." ;
   mf:action  <wellformed-group-04.srl> ;
   .

:test_13 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-05.srl" ;
   rdfs:comment "A FILTER in the pattern uses a key bound before the GROUP." ;
   mf:action  <wellformed-group-05.srl> ;
   .

:test_14 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-06.srl" ;
   rdfs:comment "An aggregation argument that is a key bound before the GROUP." ;
   mf:action  <wellformed-group-06.srl> ;
   .

:test_15 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-07.srl" ;
   rdfs:comment "A key computed by a SET in the pattern." ;
   mf:action  <wellformed-group-07.srl> ;
   .

:test_16 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-08.srl" ;
   rdfs:comment "The first GROUP's result reaches the head through a second GROUP." ;
   mf:action  <wellformed-group-08.srl> ;
   .

:test_17 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-09.srl" ;
   rdfs:comment "Two GROUPs each have a pattern variable called ?y." ;
   mf:action  <wellformed-group-09.srl> ;
   .

:test_18 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-10.srl" ;
   rdfs:comment "A later SET reads an aggregation variable." ;
   mf:action  <wellformed-group-10.srl> ;
   .

:test_19 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-01.srl" ;
   rdfs:comment "A key that is bound neither before the GROUP nor by the pattern." ;
   mf:action  <wellformed-group-bad-01.srl> ;
   .

:test_20 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-02.srl" ;
   rdfs:comment "An aggregation variable that is a pattern variable." ;
   mf:action  <wellformed-group-bad-02.srl> ;
   .

:test_21 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-03.srl" ;
   rdfs:comment "An aggregation variable bound before the GROUP." ;
   mf:action  <wellformed-group-bad-03.srl> ;
   .

:test_22 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-04.srl" ;
   rdfs:comment "An aggregation variable that is a key." ;
   mf:action  <wellformed-group-bad-04.srl> ;
   .

:test_23 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-05.srl" ;
   rdfs:comment "The same aggregation variable twice in one block." ;
   mf:action  <wellformed-group-bad-05.srl> ;
   .

:test_24 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-06.srl" ;
   rdfs:comment "An aggregation argument bound nowhere." ;
   mf:action  <wellformed-group-bad-06.srl> ;
   .

:test_25 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-07.srl" ;
   rdfs:comment "An aggregation argument bound before the GROUP but not listed as a key." ;
   mf:action  <wellformed-group-bad-07.srl> ;
   .

:test_26 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-08.srl" ;
   rdfs:comment "A FILTER in the pattern uses an earlier variable that is not a key." ;
   mf:action  <wellformed-group-bad-08.srl> ;
   .

:test_27 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-09.srl" ;
   rdfs:comment "A SET in the pattern reads an earlier variable that is not a key." ;
   mf:action  <wellformed-group-bad-09.srl> ;
   .

:test_28 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-10.srl" ;
   rdfs:comment "A SET in the pattern assigns a key bound before the GROUP." ;
   mf:action  <wellformed-group-bad-10.srl> ;
   .

:test_29 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-11.srl" ;
   rdfs:comment "A variable bound only in the pattern is used in the head." ;
   mf:action  <wellformed-group-bad-11.srl> ;
   .

:test_30 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-12.srl" ;
   rdfs:comment "A variable bound only in the pattern is used in a later FILTER." ;
   mf:action  <wellformed-group-bad-12.srl> ;
   .

:test_31 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-13.srl" ;
   rdfs:comment "A later SET assigns an aggregation variable." ;
   mf:action  <wellformed-group-bad-13.srl> ;
   .

:test_32 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-14.srl" ;
   rdfs:comment "A second GROUP reuses the first one's aggregation variable." ;
   mf:action  <wellformed-group-bad-14.srl> ;
   .

:test_33 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-15.srl" ;
   rdfs:comment "A FILTER in the pattern uses the block's own aggregation variable." ;
   mf:action  <wellformed-group-bad-15.srl> ;
   .

:test_34 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-extra-16.srl" ;
   rdfs:comment "An aggregate uses another aggregate's assignment variable." ;
   mf:action  <wellformed-group-bad-extra-16.srl> ;
   .

:test_35 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-inuse-01.srl" ;
   rdfs:comment "The NOT body uses only variables already in scope." ;
   mf:action  <wellformed-inuse-01.srl> ;
   .

:test_36 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-inuse-02.srl" ;
   rdfs:comment "The NOT body shares no variable with the enclosing scope." ;
   mf:action  <wellformed-inuse-02.srl> ;
   .

:test_37 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-inuse-03.srl" ;
   rdfs:comment "A variable in scope is used in the NOT body and again after it." ;
   mf:action  <wellformed-inuse-03.srl> ;
   .

:test_38 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-inuse-04.srl" ;
   rdfs:comment "A variable local to a NOT is in use and is never mentioned again." ;
   mf:action  <wellformed-inuse-04.srl> ;
   .

:test_39 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-inuse-05.srl" ;
   rdfs:comment "Two NOT elements with disjoint local variables." ;
   mf:action  <wellformed-inuse-05.srl> ;
   .

:test_40 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-inuse-06.srl" ;
   rdfs:comment "A SET after a NOT assigns a variable that is not in use." ;
   mf:action  <wellformed-inuse-06.srl> ;
   .

:test_41 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-inuse-bad-01.srl" ;
   rdfs:comment "A triple pattern after a NOT reuses a variable local to that NOT." ;
   mf:action  <wellformed-inuse-bad-01.srl> ;
   .

:test_42 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-inuse-bad-02.srl" ;
   rdfs:comment "A SET after a NOT assigns a variable local to that NOT." ;
   mf:action  <wellformed-inuse-bad-02.srl> ;
   .

:test_43 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-inuse-bad-03.srl" ;
   rdfs:comment "A second NOT reuses a variable local to the first NOT." ;
   mf:action  <wellformed-inuse-bad-03.srl> ;
   .

:test_44 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-inuse-bad-04.srl" ;
   rdfs:comment "The head uses a variable that is local to a NOT." ;
   mf:action  <wellformed-inuse-bad-04.srl> ;
   .

:test_45 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-inuse-bad-05.srl" ;
   rdfs:comment "A FILTER after a NOT reads a variable local to that NOT." ;
   mf:action  <wellformed-inuse-bad-05.srl> ;
   .

:test_46 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-inuse-bad-06.srl" ;
   rdfs:comment "A SET after a NOT reads a variable local to that NOT." ;
   mf:action  <wellformed-inuse-bad-06.srl> ;
   .

:test_47 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-inuse-01.srl" ;
   rdfs:comment "The group pattern rebinds a variable that is also a group key." ;
   mf:action  <wellformed-group-inuse-01.srl> ;
   .

:test_48 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-inuse-02.srl" ;
   rdfs:comment "The group pattern uses the group key and otherwise fresh names." ;
   mf:action  <wellformed-group-inuse-02.srl> ;
   .

:test_49 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-inuse-03.srl" ;
   rdfs:comment "A group key is bound by the group pattern, not by the input." ;
   mf:action  <wellformed-group-inuse-03.srl> ;
   .

:test_50 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-inuse-04.srl" ;
   rdfs:comment "The aggregation variable is used after the group." ;
   mf:action  <wellformed-group-inuse-04.srl> ;
   .

:test_51 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-inuse-05.srl" ;
   rdfs:comment "Two groups with disjoint pattern variables." ;
   mf:action  <wellformed-group-inuse-05.srl> ;
   .

:test_52 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-inuse-06.srl" ;
   rdfs:comment "The aggregation argument is a variable of the group pattern." ;
   mf:action  <wellformed-group-inuse-06.srl> ;
   .

:test_53 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-inuse-bad-01.srl" ;
   rdfs:comment "The group pattern rebinds an input variable that is not a group key." ;
   mf:action  <wellformed-group-inuse-bad-01.srl> ;
   .

:test_54 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-inuse-bad-02.srl" ;
   rdfs:comment "A second group pattern reuses a variable left in use by the first." ;
   mf:action  <wellformed-group-inuse-bad-02.srl> ;
   .

:test_55 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-inuse-bad-03.srl" ;
   rdfs:comment "A triple pattern after the group reuses a group pattern variable." ;
   mf:action  <wellformed-group-inuse-bad-03.srl> ;
   .

:test_56 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-inuse-bad-04.srl" ;
   rdfs:comment "A SET after the group assigns a group pattern variable." ;
   mf:action  <wellformed-group-inuse-bad-04.srl> ;
   .

:test_57 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-inuse-bad-05.srl" ;
   rdfs:comment "The group pattern reuses a variable left in use by a preceding NOT." ;
   mf:action  <wellformed-group-inuse-bad-05.srl> ;
   .

:test_58 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-inuse-bad-06.srl" ;
   rdfs:comment "The aggregation variable is left in use by a preceding NOT." ;
   mf:action  <wellformed-group-inuse-bad-06.srl> ;
   .

:test_59 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-inuse-bad-07.srl" ;
   rdfs:comment "A group key is left in use by a preceding NOT." ;
   mf:action  <wellformed-group-inuse-bad-07.srl> ;
   .
