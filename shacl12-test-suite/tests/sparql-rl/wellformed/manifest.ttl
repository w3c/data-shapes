PREFIX srlt:   <http://www.w3.org/ns/sparql-rl-tests#>

<>  rdf:type mf:Manifest ;
    rdfs:comment "SPARQL-RL - Well-formedness" ;
    mf:entries (
        :test_1
        :test_2
        :test_3
        :test_4
        :test_5
        :test_6
